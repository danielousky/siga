#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

# El rol de la app no puede crearse a sí mismo, ni crear la base en la que va a
# vivir. Ese primer paso lo hace el usuario de Postgres de la máquina — en macOS
# con Homebrew, el usuario del sistema.
def con_usuario_privilegiado(comando)
  "SIGA_DB_USER=#{ENV.fetch('SIGA_SETUP_USER', ENV.fetch('USER', 'postgres'))} #{comando}"
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # ⚠️ El orden de acá abajo NO es arbitrario, y saltárselo deja el aislamiento
  # apagado sin que nada avise.
  #
  # La app se conecta como `siga_app`, un rol sin SUPERUSER ni BYPASSRLS: con
  # cualquiera de los dos, PostgreSQL se salta las políticas de RLS antes de
  # mirarlas y el aislamiento entre colegios deja de existir (MOR-87). Pero ese
  # rol todavía no existe en una máquina nueva, así que la base y el esquema los
  # crea el usuario privilegiado, y recién después se traspasa todo.
  #
  # Antes este script hacía `db:prepare` a secas. En una máquina nueva eso fallaba
  # —el rol no existe— y quien lo arreglaba a mano apuntando la app a su propio
  # usuario terminaba con un superusuario conectado y el RLS decorativo.
  puts "\n== Preparing database =="
  system! con_usuario_privilegiado("bin/rails db:prepare")

  # ⚠️ DOS VECES, una por base, y no es redundante.
  #
  # `db:prepare` en desarrollo crea TAMBIÉN `siga_test`, y las dos quedan con sus
  # tablas del usuario privilegiado. `rls:crear_rol` traspasa las tablas de la
  # base a la que está conectado — así que corriéndolo solo en desarrollo, las
  # tablas de `siga_test` se quedan ajenas y `bin/rails test` muere con
  # `permission denied for table ar_internal_metadata`.
  puts "\n== Creating the unprivileged role the app connects as =="
  system! con_usuario_privilegiado("bin/rails rls:crear_rol")
  system! con_usuario_privilegiado("env RAILS_ENV=test bin/rails rls:crear_rol")

  puts "\n== Verifying that role cannot bypass RLS =="
  system! "bin/rails rls:verificar"

  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
