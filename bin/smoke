#!/usr/bin/env bash
#
# Verificación de humo: levanta el server Y EL WORKER contra la base de
# desarrollo —las dos piezas que corren en producción— y recorre por HTTP real
# los flujos críticos: público, admin, profesor y estudiante.
#
#   bin/smoke ["etiqueta"]
#
# Sale 0 si todo pasa, 1 si algo falla.
#
# ⚠️  Esto NO es una suite de tests. Es un arnés de verificación que nació para
#     el upgrade de Ruby/Rails (MOR-100) y sirve mientras no exista la suite de
#     verdad. Corre contra la base de DESARROLLO, con sus seeds, no contra la de
#     test. Lo que tiene que reemplazarlo es MOR-105.
#
# Requiere: la base de desarrollo migrada y con seeds (bin/rails db:seed:replant).

set -uo pipefail

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT="${PORT:-3009}"
BASE="http://127.0.0.1:${PORT}"
LABEL="${1:-smoke}"
TMP="$(mktemp -d)"
LOG="${TMP}/server.log"
WORKER_LOG="${TMP}/worker.log"
# Cuánto se le espera al worker para arrancar y dejar la cola vacía. Arranca en
# unos segundos y los trabajos de SIGA duran uno; esto es holgura para una
# máquina de CI lenta, no lo que tarda.
ESPERA_DE_LA_COLA="${ESPERA_DE_LA_COLA:-90}"
FAILED=0

cd "$APP_ROOT" || exit 1

cleanup() {
  # El worker primero: se despide de la tabla de procesos antes de que el
  # server deje de contestar.
  [ -n "${WORKER_PID:-}" ] && kill "$WORKER_PID" 2>/dev/null
  [ -n "${SERVER_PID:-}" ] && kill "$SERVER_PID" 2>/dev/null
  wait 2>/dev/null
  rm -rf "$TMP"
}
trap cleanup EXIT

echo "── ${LABEL} ──"
echo "ruby  $(ruby -v | cut -d' ' -f2)"
echo "rails $(bin/rails -v 2>/dev/null | cut -d' ' -f2)"
echo

# El pidfile va aparte: si no, choca con el `bin/rails server` que uno tenga
# abierto para mirar la app y Puma se niega a arrancar ("A server is already
# running"). El smoke tiene que poder correr sin bajar el server de desarrollo.
bin/rails server -p "$PORT" -b 127.0.0.1 -e development --pid "${TMP}/smoke.pid" > "$LOG" 2>&1 &
SERVER_PID=$!

for _ in $(seq 1 60); do
  curl -sf -o /dev/null "${BASE}/" 2>/dev/null && break
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    echo "✗ el server murió al arrancar:"; tail -30 "$LOG"; exit 1
  fi
  sleep 1
done

if ! curl -sf -o /dev/null "${BASE}/" 2>/dev/null; then
  echo "✗ el server no respondió en 60s:"; tail -30 "$LOG"; exit 1
fi

# ── El worker ────────────────────────────────────────────────────────────────
#
# Producción son DOS procesos (`Procfile`: web y worker) y el humo levantaba
# uno. Así, `/salud` —que contesta «¿la cola avanza?»— dependía de la suerte:
#
#     cola vacía                     200   pasa
#     un trabajo de hace 2 minutos   200   pasa
#     un trabajo de hace 6 minutos   503   falla, y el código no cambió
#
# En GitHub fallaba SIEMPRE, y con razón: sembrar la base de desarrollo deja dos
# trabajos en la cola —el análisis de cada escudo que se adjunta—, la suite
# tarda doce minutos en llegar hasta acá, y allá no corre ningún worker. El
# endpoint hacía su trabajo; lo que faltaba era quien vaciara la cola.
#
# Se arranca con la MISMA orden del `Procfile`. De paso es lo único que prueba
# que el worker levanta: en producción, uno que no arranca no rompe nada a la
# vista —la app sigue en 200— y los promedios se quedan viejos.
#
# ⚠️ Los fallidos se leen ANTES de arrancarlo. Un trabajo que revienta también
# sale de la cola, así que «quedó vacía» no distingue procesar de fallar: lo
# que lo distingue es que el contador de fallidos no se haya movido.
dato_de_salud() { # dato_de_salud <clave>  →  el número que `/salud` trae ahí
  grep -o "\"$1\":[0-9]*" "${TMP}/salud" 2>/dev/null | head -1 | cut -d: -f2
}

curl -s -o "${TMP}/salud" "${BASE}/salud"
ESPERABAN="$(dato_de_salud esperando)"
FALLIDOS_ANTES="$(dato_de_salud fallidos)"

RAILS_ENV=development bin/rails solid_queue:start > "$WORKER_LOG" 2>&1 &
WORKER_PID=$!

check() { # check <descripción> <path> <código esperado> [cookiejar]
  local desc="$1" path="$2" want="$3" jar="${4:-}"
  local args=(-s -o "${TMP}/body" -w '%{http_code}' -L)
  [ -n "$jar" ] && args+=(-b "$jar" -c "$jar")
  local got
  got="$(curl "${args[@]}" "${BASE}${path}")"
  if [ "$got" = "$want" ]; then
    printf '  ✓ %-42s %s\n' "$desc" "$got"
  else
    printf '  ✗ %-42s %s (esperaba %s)\n' "$desc" "$got" "$want"
    FAILED=1
  fi
}

# Igual que `check`, pero con POST y su token CSRF. Sin `-L`: lo que se quiere
# comprobar es el 302, no la página a la que lleva.
check_post() { # check_post <descripción> <path> <código esperado> <cookiejar> [datos]
  local desc="$1" path="$2" want="$3" jar="$4" datos="${5:-}" token got
  token="$(curl -s -b "$jar" -c "$jar" "${BASE}/dashboards/administrador" \
    | grep -o 'name="csrf-token" content="[^"]*"' | head -1 | sed 's/.*content="//; s/"$//')"
  got="$(curl -s -b "$jar" -c "$jar" -o "${TMP}/body" -w '%{http_code}' \
         -X POST -d "authenticity_token=${token}" ${datos:+-d "$datos"} "${BASE}${path}")"
  if [ "$got" = "$want" ]; then
    printf '  ✓ %-42s %s\n' "$desc" "$got"
  else
    printf '  ✗ %-42s %s (esperaba %s)\n' "$desc" "$got" "$want"
    FAILED=1
  fi
}

login() { # login <email> <password> <cookiejar>
  local email="$1" pass="$2" jar="$3" token
  token="$(curl -s -c "$jar" "${BASE}/users/sign_in" \
    | grep -o 'name="authenticity_token" value="[^"]*"' \
    | head -1 | sed 's/.*value="//; s/"$//')"
  if [ -z "$token" ]; then
    echo "  ✗ no se pudo extraer el authenticity_token"; FAILED=1; return 1
  fi
  curl -s -b "$jar" -c "$jar" -L -o "${TMP}/login_body" \
    --data-urlencode "authenticity_token=${token}" \
    --data-urlencode "user[email]=${email}" \
    --data-urlencode "user[password]=${pass}" \
    "${BASE}/users/sign_in" > /dev/null
  if grep -q 'name="user\[password\]"' "${TMP}/login_body"; then
    echo "  ✗ login fallido para ${email}"; FAILED=1; return 1
  fi
  return 0
}

echo "Público"
check "landing /"                "/"                   200
check "login"                    "/users/sign_in"      200
# El formulario de demostración salió: su dirección lleva a la portada (`check`
# sigue la redirección, así que lo que se lee es el 200 de la portada).
check "la demo, a la portada"    "/demo_requests/new"  200
check "registrar un colegio"     "/registrarse"        200
check "recuperar contraseña"     "/users/password/new" 200
check "verificar boletín"        "/verificar"          200
check "código inexistente"       "/verificar/BOL-XXXX-YYYY" 404
# ⚠️ El colegio de muestra vive en SU instancia (`SIGA_MUESTRA=1`). En cualquier
# otra, sus puertas no existen: ahí «entrar sin clave» sería la peor cosa que
# podría tener el sistema de un colegio.
#
# `/muestra` manda a donde vive la muestra si `/siga/ajustes` lo dice (302) y si
# no, no existe (404); lo que no puede es dibujar las puertas. Sin `-L`: seguir
# la redirección sería medir la muestra de verdad, en internet. Hasta el 12 de
# octubre de 2026 esperaba un 404 a secas, porque la dirección era una variable
# que nadie ponía en desarrollo; desde que es un ajuste, la siembra la carga.
got="$(curl -s -o /dev/null -w '%{http_code}' "${BASE}/muestra")"
case "$got" in
  302|404) printf '  ✓ %-42s %s\n' "la muestra, fuera de su instancia" "$got" ;;
  *)       printf '  ✗ %-42s %s (esperaba 302 o 404)\n' "la muestra, fuera de su instancia" "$got"; FAILED=1 ;;
esac

# Y la puerta que da miedo, pedida como la pide la portada de la muestra: POST y
# con su token. Sin token contestaría la protección CSRF (422), y no la puerta.
JAR_ANONIMO="${TMP}/anonimo"
token="$(curl -s -c "$JAR_ANONIMO" "${BASE}/users/sign_in" \
  | grep -o 'name="csrf-token" content="[^"]*"' | head -1 | sed 's/.*content="//; s/"$//')"
got="$(curl -s -b "$JAR_ANONIMO" -o /dev/null -w '%{http_code}' -X POST \
       -d "authenticity_token=${token}" -d "rol=director" "${BASE}/muestra/entrar")"
if [ "$got" = "404" ]; then
  printf '  ✓ %-42s %s\n' "entrar sin clave, fuera de la muestra" "$got"
else
  printf '  ✗ %-42s %s (esperaba 404)\n' "entrar sin clave, fuera de la muestra" "$got"
  FAILED=1
fi

# ⚠️ `/up` y `/salud` no son intercambiables (MOR-167): `/up` dice que el
# proceso arrancó —lo mira DOKKU para dejar entrar una versión nueva— y `/salud`
# dice que la COLA avanza —lo mira un monitor externo—. Con el worker caído,
# `/salud` devuelve 503 y `/up` sigue en 200, que es exactamente lo que se
# quiere: un worker caído no puede impedir desplegar la corrección que lo
# arregla. `/salud` se mira al final, en «La cola», cuando el worker ya tuvo
# tiempo de arrancar.
check "up (lo mira Dokku)"       "/up"                      200

echo
echo "Administrador"
JAR="${TMP}/admin.jar"
if login "director.bolivar@mail.com" "123123" "$JAR"; then
  echo "  ✓ login"
  check "dashboard"        "/dashboards/administrador"  200 "$JAR"
  # ⚠️ Acá las URLs SÍ van escritas a mano, y tienen que estar en español
  # (MOR-162): esto es un cliente HTTP, no la app. Es lo único que comprueba
  # que la ruta que ve una persona existe de verdad.
  check "estudiantes"      "/alumnos"                  200 "$JAR"
  check "profesores"       "/profesores"                  200 "$JAR"
  check "secciones"        "/secciones"                  200 "$JAR"
  check "grados"           "/grados"                    200 "$JAR"
  check "alta de grado"    "/grados/new"                200 "$JAR"
  check "materias"         "/materias"                  200 "$JAR"
  check "inscripciones"    "/inscripciones"               200 "$JAR"
  check "años escolares"   "/academic_periods"          200 "$JAR"
  check "lapsos"           "/lapsos"                    200 "$JAR"
  check "alta de lapso"    "/lapsos/new"                200 "$JAR"
  check "evaluaciones"     "/evaluaciones"              200 "$JAR"
  check "emitir boletines" "/boletines"                 200 "$JAR"
  check "certificados"     "/certificados"              200 "$JAR"
  check "asistencia"       "/asistencia"                200 "$JAR"
  check "quién no cargó"   "/carga-de-notas"            200 "$JAR"
  check "reparaciones"     "/reparaciones"              200 "$JAR"
  check "auditoría"        "/dashboards/actividad"  200 "$JAR"
  check "alta de alumno"   "/alumnos/new"              200 "$JAR"
  check "alta de sección"  "/secciones/new"            200 "$JAR"
  # Lo que el colegio le paga a SIGA (spec `del-registro-al-cobro`): es la
  # salida del muro de lo gratis y de la solo lectura, así que tiene que abrir.
  check "suscripción"      "/suscripcion"              200 "$JAR"
  # Los horarios (spec `horarios`, tanda 1): el timbre y la carga horaria.
  check "turnos"           "/turnos"                    200 "$JAR"
  check "alta de turno"    "/turnos/new"                200 "$JAR"
  check "carga horaria"    "/carga-horaria"             200 "$JAR"

  # El selector de año escolar de la barra (MOR-165). Es un POST y devuelve un
  # redirect: comprobarlo acá es comprobar que el pivote de TODA la app existe
  # en la ruta que ve una persona, no solo en un test de integración.
  check_post "cambiar de año"  "/anio-escolar"          302 "$JAR"

  # Copiar la estructura de un año al siguiente (MOR-166). Solo la pantalla: el
  # POST crea decenas de filas y el humo corre contra la base de desarrollo.
  ANIO="$(curl -s -b "$JAR" "${BASE}/academic_periods" \
    | grep -o '/academic_periods/[0-9]*/copiar' | head -1)"
  if [ -n "$ANIO" ]; then
    check "copiar estructura"  "$ANIO"                    200 "$JAR"
    check "promover alumnos"   "${ANIO%/copiar}/promover"  200 "$JAR"
  else
    printf '  · %-42s (todos los años ya tienen secciones)\n' "copiar estructura"
  fi
fi

echo
echo "Administración de SIGA (otra app, /siga)"
JAR="${TMP}/siga.jar"
if login "desarrollador@siga.edu" "123123" "$JAR"; then
  echo "  ✓ login"
  # Esta gente NO pertenece a ningún colegio (MOR-133): entra a su propia
  # administración, que ve la plataforma entera. Que un usuario de colegio NO
  # llegue acá lo cubre la suite (administracion_de_siga_test).
  check "panel de plataforma" "/siga"                   200 "$JAR"
  check "colegios"            "/siga/colegios"          200 "$JAR"
  check "alta de colegio"     "/siga/colegios/new"      200 "$JAR"
  check "pipeline comercial"  "/siga/solicitudes"       200 "$JAR"
  # Donde se validan los pagos de los colegios, y los datos con que se cobra.
  check "cartera"             "/siga/cartera"           200 "$JAR"
  check "ajustes"             "/siga/ajustes"           200 "$JAR"
fi

echo
echo "Profesor"
JAR="${TMP}/prof.jar"
if login "profesor.bolivar@mail.com" "123123" "$JAR"; then
  echo "  ✓ login"
  check "dashboard"           "/dashboards/profesor"        200 "$JAR"
  check "mis evaluaciones"    "/evaluaciones"      200 "$JAR"
  check "nueva evaluación"    "/evaluaciones/new"  200 "$JAR"

  # La planilla de carga cuelga de una actividad, así que el id sale de la
  # LIBRETA de su sección.
  #
  # ⚠️ Salía de `/evaluaciones`, y desde la etapa ③ esa ruta REDIRIGE al
  # profesor: `curl` sin `-L` recibía el 302 vacío y el humo decía «no se
  # encontró ninguna planilla». La libreta es donde el profesor las ve ahora,
  # así que es el lugar honesto de buscarlas.
  PLANILLA="$(curl -sL -b "$JAR" "${BASE}/evaluaciones" \
    | grep -o '/evaluaciones/[0-9]*/notas' | head -1)"
  if [ -n "$PLANILLA" ]; then
    check "planilla de notas"  "$PLANILLA"                   200 "$JAR"
  else
    echo "  ✗ no se encontró ninguna planilla en el listado"; FAILED=1
  fi
fi

echo
echo "Estudiante"
JAR="${TMP}/est.jar"
if login "alvaro.lopez001@bolivar.edu" "123123" "$JAR"; then
  echo "  ✓ login"
  check "dashboard"        "/dashboards/estudiante"        200 "$JAR"
  check "mis notas"        "/dashboards/notas"             200 "$JAR"
  check "notas · anual"    "/dashboards/notas?lapso=anual" 200 "$JAR"
fi

# ── La cola ──────────────────────────────────────────────────────────────────
#
# Va al final a propósito: el worker arrancó mientras corría todo lo de arriba,
# así que lo normal es que acá no haya nada que esperar.
echo
echo "La cola (web y worker, como en producción)"

CODIGO=""
for _ in $(seq 1 "$ESPERA_DE_LA_COLA"); do
  CODIGO="$(curl -s -o "${TMP}/salud" -w '%{http_code}' "${BASE}/salud")"
  WORKERS="$(dato_de_salud workers)"
  ESPERANDO="$(dato_de_salud esperando)"
  [ "$CODIGO" = "200" ] && [ "${WORKERS:-0}" -ge 1 ] && [ "${ESPERANDO:-1}" -eq 0 ] && break
  kill -0 "$WORKER_PID" 2>/dev/null || break   # murió: esperar no lo revive
  sleep 1
done

if kill -0 "$WORKER_PID" 2>/dev/null && [ "${WORKERS:-0}" -ge 1 ]; then
  printf '  ✓ %-42s %s\n' "el worker arrancó" "$WORKERS"
else
  printf '  ✗ %-42s %s\n' "el worker NO arrancó" "(bin/rails solid_queue:start)"
  sed 's/^/      /' "$WORKER_LOG" | tail -20
  FAILED=1
fi

if [ "$CODIGO" = "200" ] && [ "${ESPERANDO:-1}" -eq 0 ]; then
  printf '  ✓ %-42s %s\n' "salud de la cola" "$CODIGO"
  printf '  ✓ %-42s %s\n' "la cola quedó vacía" "${ESPERABAN:-0} esperaban"
else
  printf '  ✗ %-42s %s (esperaba 200 y la cola vacía)\n' "salud de la cola" "$CODIGO"
  sed 's/^/      /' "${TMP}/salud"; echo
  FAILED=1
fi

FALLIDOS_DESPUES="$(dato_de_salud fallidos)"
FALLARON=$(( ${FALLIDOS_DESPUES:-0} - ${FALLIDOS_ANTES:-0} ))
if [ "$FALLARON" -le 0 ]; then
  printf '  ✓ %-42s %s\n' "ningún trabajo falló al procesarse" "0"
else
  printf '  ✗ %-42s %s\n' "trabajos que fallaron al procesarse" "$FALLARON"
  bin/rails runner '
    SolidQueue::FailedExecution.order(:created_at).last(ARGV.first.to_i).each do |fallido|
      error = fallido.error.to_h
      puts "      #{fallido.job.class_name}: #{error["exception_class"]} — #{error["message"]}"
    end
  ' "$FALLARON" 2>/dev/null
  FAILED=1
fi

echo
if grep -qE 'FATAL|Error during|NoMethodError|NameError|ArgumentError|LoadError' "$LOG"; then
  echo "⚠ excepciones en el log del server:"
  grep -E 'FATAL|Error during|NoMethodError|NameError|ArgumentError|LoadError' "$LOG" | head -10
  FAILED=1
fi

if grep -qi 'DEPRECATION WARNING' "$LOG"; then
  echo "ℹ deprecaciones:"
  grep -i 'DEPRECATION WARNING' "$LOG" | sed 's/^/    /' | sort -u | head -15
fi

if grep -q 'Translation missing' "$LOG"; then
  echo "⚠ traducciones faltantes:"
  grep -o 'Translation missing[^"]*' "$LOG" | sort -u | head -10
  FAILED=1
fi

echo
if [ "$FAILED" -eq 0 ]; then
  echo "✅ ${LABEL}: todo en verde"
else
  echo "❌ ${LABEL}: hay fallas"
fi
exit "$FAILED"
