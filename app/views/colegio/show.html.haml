.card-academic
  = render "shared/cabecera", titulo: "Identidad del colegio"

  %p.nota-ayuda
    Esto sale impreso en los
    %strong boletines y constancias
    que la familia se lleva en la mano.

  = form_with model: @colegio, url: colegio_path, method: :patch, class: "" do |f|
    = render "shared/errors", object: @colegio

    .identidad
      .identidad-escudo
        - if @colegio.logo.attached?
          = image_tag @colegio.logo, alt: "Escudo de #{@colegio.name}", class: "identidad-escudo-imagen"
          = link_to "Quitar escudo", quitar_logo_colegio_path, data: { turbo_method: :delete, turbo_confirm: "¿Quitar el escudo? Va a desaparecer de los documentos nuevos." }, class: "identidad-quitar"
        - else
          .identidad-escudo-vacio
            %span Sin escudo
          %p.nota-ayuda.identidad-vacio-nota
            Los documentos salen sin él. Sirven igual, pero no se ven del colegio.

      .identidad-campos
        .form-group
          = con_pista "PNG o JPG, hasta 2 MB. Conviene fondo transparente o blanco: se imprime sobre papel." do
            = f.label :logo, "Escudo del colegio", class: "form-label"
          = f.file_field :logo, accept: "image/png,image/jpeg", class: "form-control"

        .form-group
          = con_pista "Se imprime sobre la línea del boletín, como el sello de goma sobre el papel. Conviene fondo transparente y trazo oscuro." do
            = f.label :firma, "Firma del director, escaneada", class: "form-label"
            %span.solicitud-opcional opcional
          = f.file_field :firma, accept: "image/png,image/jpeg", class: "form-control"
          - if @colegio.firma.attached?
            .identidad-firma
              = image_tag @colegio.firma, alt: "Firma del director", class: "identidad-firma-imagen"
              = link_to "Quitar firma", quitar_firma_colegio_path, data: { turbo_method: :delete, turbo_confirm: "¿Quitar la firma? Los boletines nuevos salen con la línea en blanco." }, class: "identidad-quitar"
        .form-group
          = con_pista "Se estampa SOBRE la firma, como en el papel. Conviene fondo transparente: uno blanco taparía el trazo de abajo." do
            = f.label :sello, "Sello del colegio, escaneado", class: "form-label"
            %span.solicitud-opcional opcional
          = f.file_field :sello, accept: "image/png,image/jpeg", class: "form-control"
          - if @colegio.sello.attached?
            .identidad-firma
              = image_tag @colegio.sello, alt: "Sello del colegio", class: "identidad-sello-imagen"
              = link_to "Quitar sello", quitar_sello_colegio_path, data: { turbo_method: :delete, turbo_confirm: "¿Quitar el sello? Los boletines nuevos salen sin él." }, class: "identidad-quitar"

        -# ⚠️ Se queda VISIBLE. No explica un campo: advierte de un RIESGO que el
        -# director asume al subir su firma escaneada. Detrás de un «?» sería una
        -# advertencia que nadie abre.
        %p.nota-ayuda
          %strong Ni la firma ni el sello son una firma digital:
          son imágenes, y cualquiera que tenga el PDF puede recortarlas.
        = mas_detalle "Entonces, ¿qué hace comprobable un boletín?" do
          %p
            El código de verificación y el QR. Quien lo escanee ve, contra la
            base, exactamente lo que el colegio emitió — y por eso el sello va
            montado sobre la firma y no al lado.

        .form-group
          = con_pista "Escríbalo como tiene que aparecer impreso en los documentos oficiales." do
            = f.label :name, "Nombre", class: "form-label"
          = f.text_field :name, class: "form-control"

        -# ⚠️ Acá había un campo «Ubicación» y se preguntaba lo mismo DOS VECES
        -# (MOR-208). Daniel: «estoy preguntando lo mismo 2 veces; quita
        -# Ubicación, pedimos la dirección completa abajo».
        -#
        -# `location` sigue existiendo —es el renglón corto que se lee en la
        -# barra de arriba y en el panel de SIGA— pero se DEDUCE del municipio y
        -# el estado, que están a diez centímetros más abajo. Ver
        -# `School#deducir_la_ubicacion`.

        -# ⚠️ Se puede CARGAR una vez, y después ya no se cambia.
        -#
        -# Estaba deshabilitado siempre, y tenía sentido mientras el registro lo
        -# exigía: llegaba lleno y cambiarlo era cosa de soporte. Desde que el
        -# registro dejó de pedirlo (`MOR-208`, segunda mitad) hay colegios que
        -# entran sin él — y con el campo bloqueado no tendrían dónde cargarlo
        -# nunca. El paso de arranque los mandaría a una pantalla que no los deja
        -# hacer lo que les pide.
        -#
        -# Bloquearlo DESPUÉS sigue estando bien: es un identificador nacional
        -# que sale impreso en cada boletín y en cada constancia, y corregirlo a
        -# posteriori es exactamente lo que nadie hace.
        .form-group
          - cargado = @colegio.dea_code.present?
          = con_pista(cargado ? "Lo asigna el MPPE. Ya está cargado y no se edita desde aquí: si está mal, escríbanos y lo corregimos." : "Lo asigna el MPPE. Sale impreso en cada boletín y en cada constancia, así que conviene cargarlo antes del primero.") do
            = f.label :dea_code, "Código DEA", class: "form-label"
          = f.text_field :dea_code, class: "form-control campo-mayuscula", disabled: cargado,
                         placeholder: ("PD01234567" unless cargado), pattern: "[A-Za-z0-9]+",
                         data: (cargado ? {} : { tooltip: "Solo letras y números, sin espacios ni símbolos",
                                                 controller: "campo-filtrado",
                                                 campo_filtrado_permite_value: "A-Za-z0-9",
                                                 campo_filtrado_mayuscula_value: true,
                                                 action: "input->campo-filtrado#filtrar" })
          - unless cargado
            %p.nota-ayuda Se carga una sola vez. Después, para corregirlo hay que escribirnos.

        -# Los mismos campos que el alta desde el panel de SIGA. Ver el parcial:
        -# salen impresos en los documentos del MPPE, y hasta ahora las columnas
        -# existían sin ningún formulario donde escribirlas.
        = render "shared/ubicacion_del_colegio", colegio: @colegio

        -# ⚠️ La regla de promoción, y por qué se pregunta (MOR-169).
        -#
        -# La referencia venezolana son DOS materias pendientes, pero los
        -# mecanismos los fijan circulares del MPPE que cambian, y en primaria la
        -# norma es menos clara que en bachillerato. Decisión de Daniel: SIGA
        -# propone el número correcto y el colegio lo corrige sin esperar un
        -# despliegue.
        .form-group
          = con_pista "Cuántas áreas aplazadas puede llevar un alumno al año siguiente sin repetir el grado." do
            = f.label :tope_de_arrastre, "Áreas que se pueden arrastrar", class: "form-label"
          = f.number_field :tope_de_arrastre, class: "form-control", min: 0, max: 6
          %p.nota-ayuda
            Con dos, un alumno que aplazó dos áreas pasa de grado y las
            arrastra; con tres, repite. Es lo que usa la promoción de septiembre.

        = f.submit "Guardar", class: "btn btn-guardar"
