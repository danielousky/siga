-# ⚠️ Materias y profesores DISTINTOS, no filas: una materia dictada en cinco
-# secciones son cinco filas y una sola materia.
.cifras-de-importacion
  .cifra-de-importacion
    %span.cifra-numero= resultado["materias_creadas"]
    %span.cifra-que áreas nuevas
  - if resultado["materias_reutilizadas"].to_i.positive?
    .cifra-de-importacion
      %span.cifra-numero= resultado["materias_reutilizadas"]
      %span.cifra-que áreas que ya existían
  .cifra-de-importacion
    %span.cifra-numero= resultado["asignaciones"]
    %span.cifra-que
      áreas asignadas
      %br
      (una por sección)
  .cifra-de-importacion
    %span.cifra-numero= resultado["profesores_creados"]
    %span.cifra-que profesores nuevos
  - if resultado["profesores_reutilizados"].to_i.positive?
    .cifra-de-importacion
      %span.cifra-numero= resultado["profesores_reutilizados"]
      %span.cifra-que
        profesores que ya existían
        %br
        (otra área, u otro colegio)

- if Array(resultado["secciones"]).any?
  %p.dato-secundario
    Secciones tocadas: #{Array(resultado['secciones']).join(' · ')}
