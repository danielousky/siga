.card-academic
  .card-academic-header
    %h1 Importar datos
    -# ⚠️ En ORDEN DE IMPORTACIÓN, y el primero es el pensum.
    -#
    -# Estaban al revés —matrícula primero— y no es una preferencia: `CargaDePensum`
    -# necesita la SECCIÓN de cada fila (`fila.seccion`), y la previsualización del
    -# pensum es la que ofrece crear las que falten de un clic. Subir la matrícula
    -# primero obliga a armar las secciones a mano antes.
    -#
    -#     1 · pensum      materias, profesores y quién dicta qué  → crea secciones
    -#     2 · matrícula   alumnos y representantes                → los inscribe ahí
    -#     3 · historial   notas de años anteriores                → necesita las dos
    -#
    -# El primero va en `btn-primary` porque es por donde se empieza.
    .acciones-de-cabecera
      = link_to new_importacion_path(tipo: :pensum), class: "btn btn-accion" do
        = icono(:subir, tamano: 16)
        %span Subir materias y profesores
      = link_to new_importacion_path(tipo: :matricula), class: "btn btn-accion" do
        = icono(:subir, tamano: 16)
        %span Subir matrícula
      = link_to new_importacion_path(tipo: :historial), class: "btn btn-accion" do
        = icono(:subir, tamano: 16)
        %span Subir notas anteriores

  - if @importaciones.empty?
    .empty-state
      %h3 Todavía no ha importado nada
      %p
        Traiga sus datos desde el sistema que usa hoy, en Excel o CSV, y en este
        orden: las materias con sus profesores —de ahí salen también las
        secciones—, después la matrícula con alumnos y representantes, y por
        último las notas de años anteriores.
      .acciones-de-cabecera
        = link_to plantilla_importaciones_path(tipo: :pensum), class: "btn btn-documento" do
          = icono(:descargar, tamano: 16)
          %span Plantilla de materias
        = link_to plantilla_importaciones_path(tipo: :matricula), class: "btn btn-documento" do
          = icono(:descargar, tamano: 16)
          %span Plantilla de matrícula
        = link_to plantilla_importaciones_path(tipo: :historial), class: "btn btn-documento" do
          = icono(:descargar, tamano: 16)
          %span Plantilla de notas
  - else
    = render "shared/escala", total: @pagy.count, singular: "importación", plural: "importaciones"

    %table.table-academic
      %thead
        %tr
          %th Archivo
          %th Qué trae
          %th Filas
          %th= Importacion.human_attribute_name(:estado)
          %th Subida por
          %th Cuándo
      %tbody
        - @importaciones.each do |importacion|
          %tr
            %td= link_to importacion.nombre_del_archivo, importacion
            %td= importacion.etiqueta_de_tipo
            %td= importacion.filas_leidas || "—"
            %td
              - if importacion.confirmada?
                %span.estado.estado--al-dia= importacion.etiqueta_de_estado
              - elsif importacion.descartada?
                %span.estado.estado--inactivo= importacion.etiqueta_de_estado
              - else
                %span.estado.estado--atencion= importacion.etiqueta_de_estado
            %td= importacion.subido_por.apellidos_y_nombres
            %td= l(importacion.created_at.to_date, format: :long)

    .pagy-nav
      != pagy_nav(@pagy)
