.card-academic
  .card-academic-header
    %h1 Importar datos
    .acciones-de-cabecera
      = link_to "Subir matrícula", new_importacion_path(tipo: :matricula), class: "btn btn-primary"
      = link_to "Subir materias y profesores", new_importacion_path(tipo: :pensum), class: "btn btn-secondary"
      = link_to "Subir notas anteriores", new_importacion_path(tipo: :historial), class: "btn btn-secondary"

  - if @importaciones.empty?
    .empty-state
      %h3 Todavía no ha importado nada
      %p
        Traiga sus datos desde el sistema que usa hoy, en Excel o CSV, y en este
        orden: la matrícula —alumnos y representantes—, después las materias con
        sus profesores, y por último las notas de años anteriores.
      .acciones-de-cabecera
        = link_to "Plantilla de matrícula", plantilla_importaciones_path(tipo: :matricula), class: "btn btn-secondary"
        = link_to "Plantilla de materias", plantilla_importaciones_path(tipo: :pensum), class: "btn btn-secondary"
        = link_to "Plantilla de notas", plantilla_importaciones_path(tipo: :historial), class: "btn btn-secondary"
  - else
    = render "shared/escala", total: @pagy.count, singular: "importación", plural: "importaciones"

    %table.table-academic
      %thead
        %tr
          %th Archivo
          %th Qué trae
          %th Filas
          %th Estado
          %th Subida por
          %th Cuándo
      %tbody
        - @importaciones.each do |importacion|
          %tr
            %td= link_to importacion.nombre_del_archivo, importacion
            %td= importacion.etiqueta_de_tipo
            %td= importacion.filas_leidas || "—"
            %td
              - if importacion.confirmada?
                %span.estado.estado--al-dia= importacion.etiqueta_de_estado
              - elsif importacion.descartada?
                %span.estado.estado--inactivo= importacion.etiqueta_de_estado
              - else
                %span.estado.estado--atencion= importacion.etiqueta_de_estado
            %td= importacion.subido_por.apellidos_y_nombres
            %td= l(importacion.created_at.to_date, format: :long)

    .pagy-nav
      != pagy_nav(@pagy)
