= render "shared/cabecera_de_lista", titulo: "Secciones", ruta: sections_path,
         marco: "sections-results", pista: "Grado o sección…",
         alta: { ruta: new_section_path, nombre: "Registrar sección" },
         extra: [ { type: :select_agrupado, name: :grade_id, label: "Grado", options: @grades_options, blanco: "Todos los grados" } ]
-# ⚠️ Acá había DOS selectores y ahora hay uno (MOR-165).
-#
-# El de año escolar se fue arriba, a la barra de contexto: es la misma pregunta
-# para todas las pantallas, y tenerlo también acá dejaba dos controles que se
-# contradecían en la misma vista —uno decía «Todos los períodos» mientras la
-# barra decía «2025-2026»—.
-#
-# El de grado se queda: es una pregunta de ESTA pantalla.

-# `target: "_top"` no es un detalle: sin él, TODO enlace de adentro del frame
-# —Ver, Editar, Eliminar— navega DENTRO del frame. Y como ninguna de esas
-# páginas contiene un frame con este id, Turbo pinta «Content missing» en vez
-# del detalle del alumno. Un botón que no lleva a ningún lado.
-#
-# El buscador sigue actualizando el frame porque declara su destino explícito
-# (`data: { turbo_frame: … }` en shared/_cabecera_de_lista), y eso le gana al
-# `target` del frame.
= turbo_frame_tag "sections-results", target: "_top" do
  -# El estado vacío sale de `PasosDeArranque`, o sea del MISMO lugar que el
  -# mapa del panel: dos redacciones del mismo paso se van separando, y quien
  -# las lee cree que son dos cosas distintas.
  - if @sections.empty?
    .card-academic
      = render "shared/lista_vacia", clave: :secciones,
               acciones: [ { texto: "Agregar", ruta: new_section_path, icono: :agregar } ]
  - else
    .card-academic
      %table.table-academic
        %thead
          %tr
            %th= Section.human_attribute_name(:grade)
            %th= Section.model_name.human
            -# ⚠️ Solo con «Todos los años»: con un año fijado, esta columna
            -# repite el mismo texto en las 18 filas. Es exactamente lo que se
            -# quitó en MOR-90 con la columna «Escuela».
            - if mirando_todos_los_anios?
              %th Año escolar
            %th= Section.human_attribute_name(:leader_teacher)
            %th= Section.human_attribute_name(:capacity)
            %th= Section.human_attribute_name(:classroom)
        %tbody
          - @sections.each do |section|
            %tr
              %td= link_to section.grade.name, section
              %td= section.name
              - if mirando_todos_los_anios?
                %td= section.academic_period.name
              %td= section.leader_teacher&.user&.apellidos_y_nombres || "—"
              %td= "#{section.enrollments.size} / #{section.capacity}"
              %td= section.classroom || "—"
