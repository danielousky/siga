.card-academic
  .card-academic-header
    %h1 Secciones
    = link_to "Nueva sección", new_section_path, class: "btn btn-primary"

- section_fields = []
- section_fields << { type: :select, name: :grade_id,          label: "Grado",             options: @grades_options }
- section_fields << { type: :select, name: :academic_period_id, label: "Período académico", options: @periods_options }
= render "shared/search_filter", url: sections_path, frame_id: "sections-results", clear_url: sections_path, fields: section_fields

-# `target: "_top"` no es un detalle: sin él, TODO enlace de adentro del frame
-# —Ver, Editar, Eliminar— navega DENTRO del frame. Y como ninguna de esas
-# páginas contiene un frame con este id, Turbo pinta «Content missing» en vez
-# del detalle del alumno. Un botón que no lleva a ningún lado.
-#
-# El buscador sigue actualizando el frame porque declara su destino explícito
-# (`data: { turbo_frame: … }` en shared/_search_filter), y eso le gana al
-# `target` del frame.
= turbo_frame_tag "sections-results", target: "_top" do
  .card-academic
    %table.table-academic
      %thead
        %tr
          %th Grado
          %th Sección
          %th Período
          %th Capacidad
          %th Aula
      %tbody
        - @sections.each do |section|
          %tr
            %td= link_to section.grade.name, section
            %td= section.name
            %td= section.academic_period.name
            %td= "#{section.enrollments.size} / #{section.capacity}"
            %td= section.classroom || "—"
