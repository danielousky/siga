%h1 Secciones

= link_to "Nueva Sección", new_section_path, class: "btn btn-primary mb-3"

%table.table.table-striped.table-hover
  %thead
    %tr
      %th Nombre
      %th Grado
      %th Período Académico
      %th Capacidad
      %th Aula
      %th Acciones
  %tbody
    - @sections.each do |section|
      %tr
        %td= section.name
        %td= section.grade.name
        %td= section.academic_period.name
        %td= section.capacity
        %td= section.classroom || "—"
        %td
          = link_to "Ver", section, class: "btn btn-sm btn-outline-primary"
          = link_to "Editar", edit_section_path(section), class: "btn btn-sm btn-outline-secondary"
          = link_to "Eliminar", section, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-sm btn-outline-danger"

== pagy_bootstrap_nav(@pagy)
