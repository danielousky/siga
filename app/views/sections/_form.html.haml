= form_with(model: section) do |f|
  = render "shared/errors", object: section

  .form-group
    = f.label :name, class: "form-label"
    = f.text_field :name, class: "form-control"

  .form-group
    = f.label :grade_id, class: "form-label"
    = f.select :grade_id, Grade.all.map { |g| [g.name, g.id] }, { include_blank: "Seleccione..." }, class: "form-select"

  .form-group
    = f.label :academic_period_id, class: "form-label"
    = f.select :academic_period_id, AcademicPeriod.all.map { |p| [p.name, p.id] }, { include_blank: "Seleccione..." }, class: "form-select"

  -# El profesor guía (MOR-150). Va acá, en la SECCIÓN, y no en el grado: es
  -# quien pasa lista de ESTOS alumnos y responde por ellos. «1er Año A» tiene su
  -# guía y «1er Año B» el suyo.
  .form-group
    = f.label :leader_teacher_id, class: "form-label"
    = f.select :leader_teacher_id, Teacher.includes(:user).order("users.last_name").map { |t| [t.user.apellidos_y_nombres, t.id] }, { include_blank: "Sin asignar" }, class: "form-select"
    %p.nota-ayuda
      Quien pasa lista de esta sección. Sin guía asignado, la asistencia solo la
      puede tomar la dirección.

  .form-group
    = f.label :capacity, class: "form-label"
    = f.number_field :capacity, class: "form-control", min: 1

  .form-group
    = f.label :classroom, class: "form-label"
    = f.text_field :classroom, class: "form-control"

  .form-acciones
    = f.submit class: "btn btn-primary"
    - if local_assigns[:volver]
      = link_to volver, class: "btn btn-secondary" do
        = icono(:volver, tamano: 16)
        %span Volver
