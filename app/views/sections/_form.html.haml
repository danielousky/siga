= form_with(model: section) do |f|
  = render "shared/errors", object: section

  -# Grado e identificador van juntos porque juntos NOMBRAN la sección: «1er Año
  -# A» se lee de un tirón, y llenarlos en dos renglones separados obliga a
  -# armar el nombre en la cabeza.
  .form-row
    .form-group
      -# ⚠️ Agrupados por nivel y en el orden de la ley. `Grade.all` los devolvía
      -# en el orden en que se crearon y sin separación: catorce renglones
      -# seguidos donde «1er Nivel», «1er Grado» y «1er Año» se confunden.
      = f.label :grade_id, class: "form-label"
      -# ⚠️ `incluyendo:` para que EDITAR una sección de otro nivel no le borre el
      -# grado. Ver el helper: el nivel de la sesión filtra lo que se ofrece, no
      -# lo que ya está guardado.
      = f.select :grade_id, grouped_options_for_select(grados_por_nivel(incluyendo: f.object.grade), f.object.grade_id), { include_blank: "Seleccione…" }, class: "form-select"

    -# ⚠️ PASTILLAS de lo que el colegio ya usa, más «Otra…» (MOR-170).
    -#
    -# Daniel: «si ya hay secciones debería hacerlas seleccionables… con el
    -# tiempo es probable que haga su universo de 4 o 5 valores fijos. Además se
    -# siente como que el sistema está autoaprendiendo».
    -#
    -# Era un `datalist`, y la idea estaba bien: ofrece lo que ya se usa sin
    -# encerrar —el colegio que abre su primera «D» tiene que poder—. Lo que no
    -# funciona es dónde: en un teléfono el `datalist` no se ve hasta que se
    -# empieza a teclear, así que el autoaprendizaje no existe justo para quien
    -# arma las secciones desde el teléfono en septiembre.
    -#
    -# ⚠️ El campo de texto SIGUE SIENDO el valor. Las pastillas solo lo
    -# escriben: sin JavaScript se ve y se llena como siempre.
    - usados = Section.identificadores_usados
    .form-group{ data: { controller: "identificadores-usados" } }
      = f.label :name, class: "form-label"

      - if usados.any?
        .opciones-en-botones.opciones-compactas
          - usados.each do |identificador|
            %button.opcion-boton{ type: "button", data: { identificadores_usados_target: "pastilla",
                                                         valor: identificador,
                                                         action: "identificadores-usados#elegir",
                                                         identificadores_usados_valor_param: identificador } }
              = identificador
          %button.opcion-boton.opcion-boton--otra{ type: "button", hidden: true,
                                                   data: { identificadores_usados_target: "otra",
                                                           action: "identificadores-usados#otra" } }
            Otra…

      -# ⚠️ Tres capas, y las tres hacen falta.
      -#
      -#   `campo-filtrado`   NO DEJA ESCRIBIR lo que no corresponde
      -#   `pattern`          el navegador tampoco deja enviarlo
      -#   el modelo          `strip.upcase` + la validación de formato
      -#
      -# La primera es la que faltaba, y la encontró Daniel: `pattern` es
      -# validación del navegador —impide ENVIAR, no escribir— así que se podía
      -# teclear «A Ñ{*}¡» y descubrir el error recién al guardar.
      -#
      -# La tercera no sobra: un POST que no pasa por el formulario mete lo que
      -# quiera, y ahí no hay JavaScript que valga.
      %div
        = f.text_field :name, class: "form-control campo-mayuscula", maxlength: 8, autocapitalize: "characters", pattern: "[A-Za-z0-9]+", placeholder: (usados.first || "A"), data: { tooltip: "Solo letras y números, sin espacios ni símbolos", identificadores_usados_target: "campo", controller: "campo-filtrado", campo_filtrado_permite_value: "A-Za-z0-9", campo_filtrado_mayuscula_value: true, action: "input->campo-filtrado#filtrar input->identificadores-usados#escribir" }

  -# ⚠️ El año escolar de una sección NO se pregunta y NO se edita (MOR-165).
  -#
  -# Al CREAR sale de la sesión: es el año que está eligido en la barra de arriba,
  -# y volver a preguntarlo abría la puerta a crear «1er Año A» en el año pasado
  -# sin darse cuenta.
  -#
  -# Al EDITAR ni siquiera se muestra como campo. Mover una sección de año se
  -# llevaría consigo sus inscripciones, su asistencia y sus notas —que son de ese
  -# año y de ningún otro—. Si de verdad hace falta, se crea la sección en el año
  -# nuevo; el histórico se queda donde pasó.
  - if section.persisted?
    .form-group
      %span.form-label= Section.human_attribute_name(:academic_period)
      %p.dato-secundario= section.academic_period.name

  - elsif Current.academic_period
    .form-group
      %span.form-label= Section.human_attribute_name(:academic_period)
      %p.dato-secundario= Current.academic_period.name

  - else
    -# Mirando «Todos los años» no hay nada que deducir, así que se pregunta.
    .form-group
      = f.label :academic_period_id, class: "form-label"
      = f.select :academic_period_id, AcademicPeriod.order(start_date: :desc).map { |p| [ p.name, p.id ] }, { include_blank: "Seleccione…" }, class: "form-select"

  -# ⚠️ Los TRES se difieren: ninguno hace falta para que la sección exista.
  -#
  -# Una sección es un grado y un identificador —«1er Año A»— y con eso ya se le
  -# pueden inscribir alumnos. El guía se decide en la reunión de septiembre, el
  -# cupo se ajusta cuando se ve la matrícula y el aula la asigna quien arma los
  -# horarios: tres decisiones de tres personas distintas, en tres momentos
  -# distintos, presentadas hoy como si fueran parte de crearla.
  -#
  -# ⚠️ Se abre solo si YA tienen algo: al editar una sección armada, esconder
  -# lo que está lleno obliga a buscarlo para ver qué dice.
  -# ⚠️ El cupo nace con `CUPO_PROPUESTO`, así que «tiene cupo» ya no dice que
  -# alguien lo llenó: lo dice que sea OTRO número.
  - hay_detalle = section.persisted? || section.leader_teacher_id.present? || section.classroom.present? || section.capacity != Section::CUPO_PROPUESTO
  %details.form-avanzado{ open: hay_detalle }
    %summary.form-avanzado-titulo
      Guía, cupo y aula
      %span.solicitud-opcional opcional

    -# El profesor guía (MOR-209). Va acá, en la SECCIÓN, y no en el grado: es
    -# quien pasa lista de ESTOS alumnos y responde por ellos. «1er Año A» tiene
    -# su guía y «1er Año B» el suyo.
    .form-group
      = f.label :leader_teacher_id, class: "form-label"
      = f.select :leader_teacher_id, Teacher.includes(:user).order("users.last_name").map { |t| [t.user.apellidos_y_nombres, t.id] }, { include_blank: "Sin asignar" }, class: "form-select"
      -# ⚠️ Se queda VISIBLE dentro del panel. No explica qué es el campo: dice
      -# qué pasa si se deja vacío, y eso cambia quién puede trabajar el lunes.
      %p.nota-ayuda
        Quien pasa lista de esta sección. Sin guía asignado, la asistencia solo la
        puede tomar la dirección.

    -# Los dos en una línea: son cortos y se llenan juntos.
    .form-row
      .form-group
        = f.label :capacity, class: "form-label"
        = f.number_field :capacity, class: "form-control", min: 1

      .form-group
        = f.label :classroom, class: "form-label"
        = f.text_field :classroom, class: "form-control"

  .form-acciones
    = f.submit class: "btn btn-guardar"
    - if local_assigns[:volver]
      = boton "Volver", volver, icono: :volver, tono: :secondary
