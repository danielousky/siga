.card-academic
  .card-academic-header
    %h1= "#{@section.grade.name} – Sección #{@section.name}"
    - if administrador?
      -# "Eliminar" vive en la pantalla de edición, en el bloque que explica
        qué se pierde y solo aparece si va a funcionar (`shared/_borrar`). Una
        sección con alumnos inscritos no se puede borrar, y ofrecerlo acá era
        un botón que confirmaba y después fallaba.
      = boton "Editar", edit_section_path(@section), icono: :editar, tono: :secondary
    - else
      = boton "← Volver", dashboards_profesor_path, icono: :volver, tono: :secondary

  .detail-row
    .detail-item
      %span.detail-label Período Académico
      %p.detail-value= @section.academic_period.name
    .detail-item
      %span.detail-label Capacidad
      %p.detail-value= "#{@enrollments.size} / #{@section.capacity} alumnos"
    -# Quién pasa lista de esta sección. Se muestra también cuando NO hay: sin
    -# guía la asistencia solo la puede tomar la dirección, y eso hay que
    -# enterarse mirando la sección, no descubriéndolo un lunes a las siete.
    .detail-item
      %span.detail-label Profesor guía
      - if @section.leader_teacher
        %p.detail-value= link_to @section.leader_teacher.user.apellidos_y_nombres, teacher_path(@section.leader_teacher)
      - else
        %p.detail-value.dato-secundario Sin asignar
    - if @section.classroom.present?
      .detail-item
        %span.detail-label Aula
        %p.detail-value= @section.classroom

/ =============================================
/ VISTA PROFESOR: Solo lectura
/ =============================================
- if profesor?
  .card-academic
    %h2 Materias y profesores
    - if @teacher_sections.any?
      %table.table-academic
        %thead
          %tr
            %th= Subject.model_name.human
            %th= Teacher.model_name.human
        %tbody
          - @teacher_sections.each do |ts|
            %tr
              %td= ts.subject.name
              %td
                - if ts.teacher.user_id == current_user.id
                  %strong= "#{ts.teacher.user.nombre_completo}"
                  %span.seccion-soy-yo (tú)
                - else
                  = "#{ts.teacher.user.nombre_completo}"
    - else
      .empty-state
        %p No hay materias asignadas aún.

  .card-academic
    %h2 Alumnos inscritos
    %p.seccion-conteo= contar(@enrollments.size, "alumno", "alumnos") + " en esta sección"

    - if @enrollments.any?
      %table.table-academic
        %thead
          %tr
            %th #
            %th= Section.human_attribute_name(:name)
            %th Apellido
            %th Nro. expediente
        %tbody
          - @enrollments.each_with_index do |enrollment, i|
            %tr
              %td= i + 1
              %td= enrollment.student.user.first_name
              %td= enrollment.student.user.apellidos
              %td= enrollment.student.school_card
    - else
      .empty-state
        %h3 Sin alumnos inscritos
        %p Esta sección aún no tiene alumnos inscritos.

/ =============================================
/ VISTA ADMINISTRADOR: Gestión completa
/ =============================================
- if administrador?
  .card-academic
    %h2 Profesores asignados
    - if @teacher_sections.any?
      %table.table-academic
        %thead
          %tr
            %th= Teacher.model_name.human
            %th Cédula
            %th= Subject.model_name.human
            %th Acciones
        %tbody
          - @teacher_sections.each do |ts|
            %tr
              %td= "#{ts.teacher.user.nombre_completo}"
              %td= ts.teacher.user.document || "—"
              %td= "#{ts.subject.code} - #{ts.subject.name}"
              %td
                = boton "Quitar", section_teacher_section_path(@section, ts), data: { turbo_method: :delete, turbo_confirm: "¿Quitar este profesor de esta materia?" }, icono: :borrar, tono: :danger, sm: true
    - else
      .empty-state
        %p No hay profesores asignados.

    - if @available_subjects&.any? && @available_teachers&.any?
      %hr.seccion-separador
      %h3.seccion-subtitulo Asignar profesor a materia
      = form_with url: section_teacher_sections_path(@section), method: :post do |f|
        .form-row
          .form-group
            = f.label :subject_id, class: "form-label"
            = f.select :subject_id, options_for_select(@available_subjects.map { |s| ["#{s.code} - #{s.name}", s.id] }), {}, class: "form-select"
          .form-group
            = f.label :teacher_id, class: "form-label"
            = f.select :teacher_id, options_for_select(@available_teachers.map { |t| ["#{t.user.apellidos_y_nombres} (#{t.user.identificador})", t.user_id] }), {}, class: "form-select"
          .form-group.form-group--boton
            = f.submit "Asignar", class: "btn btn-guardar"

  .card-academic
    %h2 Alumnos inscritos
    %p.seccion-conteo= "#{@enrollments.size} de #{@section.capacity} lugares ocupados"

    - if @enrollments.any?
      %table.table-academic
        %thead
          %tr
            %th #
            %th= Section.human_attribute_name(:name)
            %th Apellido
            %th Nro. expediente
            %th Inscrito el
        %tbody
          - @enrollments.each_with_index do |enrollment, i|
            %tr
              %td= i + 1
              %td= enrollment.student.user.first_name
              %td= enrollment.student.user.apellidos
              %td= enrollment.student.school_card
              %td= enrollment.enrollment_date.strftime("%d/%m/%Y")
    - else
      .empty-state
        %h3 Sin alumnos inscritos
        %p Aún no hay alumnos inscritos en esta sección.
