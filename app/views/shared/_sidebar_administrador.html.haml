.sidebar-section
  .sidebar-section-title Dashboard
  %ul.sidebar-nav
    %li.sidebar-nav-item
      = link_to "Panel Administrativo", dashboards_administrador_path, class: "sidebar-nav-link #{'active' if controller_path == 'dashboards/administrador'}"

.sidebar-section
  .sidebar-section-title Académico
  %ul.sidebar-nav
    - if can_manage_academic_config?
      %li.sidebar-nav-item
        = link_to "Grados", grades_path, class: "sidebar-nav-link #{'active' if controller_name == 'grades'}"
    %li.sidebar-nav-item
      = link_to "Materias", subjects_path, class: "sidebar-nav-link #{'active' if controller_name == 'subjects'}"
    %li.sidebar-nav-item
      = link_to "Departamentos", departments_path, class: "sidebar-nav-link #{'active' if controller_name == 'departments'}"
    %li.sidebar-nav-item
      = link_to "Momentos de Evaluación", evaluation_moments_path, class: "sidebar-nav-link #{'active' if controller_name == 'evaluation_moments'}"
    - if can_manage_sections?
      %li.sidebar-nav-item
        = link_to "Evaluaciones del Colegio", evaluation_activities_path, class: "sidebar-nav-link #{'active' if controller_name == 'evaluation_activities'}"
    - if can_manage_students?
      %li.sidebar-nav-item
        = link_to "Emitir Boletines", report_cards_path, class: "sidebar-nav-link #{'active' if controller_name == 'report_cards'}"
      %li.sidebar-nav-item
        = link_to "Constancias", constancias_path, class: "sidebar-nav-link #{'active' if controller_name == 'constancias'}"

.sidebar-section
  .sidebar-section-title Períodos
  %ul.sidebar-nav
    - if can_manage_academic_config?
      %li.sidebar-nav-item
        = link_to "Períodos Académicos", academic_periods_path, class: "sidebar-nav-link #{'active' if controller_name == 'academic_periods'}"
    - if can_manage_sections?
      %li.sidebar-nav-item
        = link_to "Secciones", sections_path, class: "sidebar-nav-link #{'active' if controller_name == 'sections'}"
      %li.sidebar-nav-item
        = link_to "Inscripciones", enrollments_path, class: "sidebar-nav-link #{'active' if controller_name == 'enrollments'}"
      %li.sidebar-nav-item
        = link_to "Asistencia", asistencias_path, class: "sidebar-nav-link #{'active' if controller_name == 'asistencias' && action_name != 'reporte'}"
      %li.sidebar-nav-item
        = link_to "Inasistencias", reporte_asistencia_path, class: "sidebar-nav-link #{'active' if action_name == 'reporte'}"

.sidebar-section
  .sidebar-section-title Personas
  %ul.sidebar-nav
    - if can_manage_students?
      %li.sidebar-nav-item
        = link_to "Estudiantes", students_path, class: "sidebar-nav-link #{'active' if controller_name == 'students'}"
    - if can_manage_students?
      %li.sidebar-nav-item
        = link_to "Representantes", representatives_path, class: "sidebar-nav-link #{'active' if controller_name == 'representatives'}"
    - if can_manage_teachers?
      %li.sidebar-nav-item
        = link_to "Profesores", teachers_path, class: "sidebar-nav-link #{'active' if controller_name == 'teachers'}"
    - if %w[desarrollador director].include?(rol_de_admin)
      %li.sidebar-nav-item
        = link_to "Administradores", admins_path, class: "sidebar-nav-link #{'active' if controller_name == 'admins'}"

.sidebar-section
  .sidebar-section-title Sistema
  %ul.sidebar-nav
    %li.sidebar-nav-item
      = link_to dashboards_activity_logs_path, class: "sidebar-nav-link #{'active' if controller_path == 'dashboards/activity_logs'}" do
        Registro de Actividad
