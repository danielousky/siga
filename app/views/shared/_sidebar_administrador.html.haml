        = icono(:panel, tamano: 18)
        %span Panel
    - if can_manage_students?
      %li.sidebar-nav-item
        = link_to students_path, class: "sidebar-nav-link #{'active' if controller_name == 'students'}" do
          = icono(:alumnos, tamano: 18)
          %span Estudiantes
    - if can_manage_sections?
      %li.sidebar-nav-item
        = link_to asistencias_path, class: "sidebar-nav-link #{'active' if controller_name == 'asistencias' && action_name != 'reporte'}" do
          = icono(:asistencia, tamano: 18)
          %span Asistencia
      %li.sidebar-nav-item
        = link_to reporte_asistencia_path, class: "sidebar-nav-link #{'active' if action_name == 'reporte'}" do
          = icono(:inasistencias, tamano: 18)
          %span Inasistencias
    - if can_manage_students?
      %li.sidebar-nav-item
        = link_to report_cards_path, class: "sidebar-nav-link #{'active' if controller_name == 'report_cards'}" do
          = icono(:boletines, tamano: 18)
          %span Boletines
      %li.sidebar-nav-item
        = link_to constancias_path, class: "sidebar-nav-link #{'active' if controller_name == 'constancias'}" do
          = icono(:constancias, tamano: 18)
          %span Constancias

