- title      ||= "Filtros"
- fields     ||= []
- clear_url  ||= "#"

.card-academic
  %h2= title
  = form_with url: url, method: :get, local: false,
      data: { controller: "search-filter", turbo_frame: frame_id, action: "submit->search-filter#hideSpinner" } do |f|

    .form-row
      - fields.each do |field|
        - flex_style = field[:flex] ? "flex: #{field[:flex]}; min-width: #{field[:min_width] || '220px'};" : nil
        - align_style = field[:type] == :clear_button ? "display: flex; align-items: flex-end;" : nil
        .form-group{style: [flex_style, align_style].compact.join("").presence}

          - case field[:type]
          - when :text
            = f.label field[:name], field[:label], class: "form-label"
            .search-input-wrap
              = f.text_field field[:name],
                  value: params[field[:name]],
                  placeholder: field[:placeholder],
                  class: "form-select",
                  autocomplete: "off",
                  data: { "search-filter-target": "input", action: "input->search-filter#search" }
              %span.search-spinner.hidden{data: { "search-filter-target": "spinner" }}

          - when :select
            = f.label field[:name], field[:label], class: "form-label"
            = f.select field[:name],
                field[:options],
                { selected: params[field[:name]] },
                { class: "form-select", data: { action: "change->search-filter#search" } }

          - when :date
            = f.label field[:name], field[:label], class: "form-label"
            = f.date_field field[:name],
                value: params[field[:name]],
                class: "form-select",
                data: { action: "change->search-filter#search" }

      .form-group.form-group--boton
        = link_to "Limpiar", clear_url, class: "btn btn-secondary"
