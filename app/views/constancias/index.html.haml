- opciones_de_seccion = @secciones.map { |s| ["#{s.grade.name} – #{s.name} · #{s.academic_period.name}", s.id] }
- opciones_de_alumno  = [["Toda la sección (#{contar(@alumnos.size, 'alumno', 'alumnos')})", ""]] + @alumnos.map { |i| [i.student.user.apellidos_y_nombres, i.id] }

- content_for :titulo, "Constancias de estudio"

.card-academic
  = render "shared/cabecera", titulo: "Documentos"

  = render "shared/pestanas", pestanas: pestanas_de_documentos, etiqueta: "Documentos que emite el colegio"

  - if @secciones.empty?
    .empty-state
      %h3 Sin secciones
      %p No hay secciones cargadas todavía.

  - else
    %p.nota-ayuda
      Para el pasaporte, una beca, el seguro o una embajada. Sale con la
      %strong situación de hoy
      y el espacio para la firma y el sello.

    = form_with url: constancias_path, method: :get, data: { controller: "auto-envio", turbo: false } do
      .form-group
        = label_tag :section_id, "Sección", class: "form-label"
        = select_tag :section_id, options_for_select(opciones_de_seccion, @seccion&.id), class: "form-select", data: { action: "change->auto-envio#enviar" }

    -# En OTRA pestaña, como todo documento (`EntregaDocumentos`).
    = form_with url: constancias_path, method: :post, html: { target: "_blank" }, data: { turbo: false } do |f|
      = hidden_field_tag :section_id, @seccion&.id

      .form-group
        = label_tag :enrollment_id, "Alumno", class: "form-label"
        = select_tag :enrollment_id, options_for_select(opciones_de_alumno), class: "form-select"

      %p.nota-ayuda
        Elija un alumno para una constancia, o deje «toda la sección» para que
        salga un PDF con una página por alumno. Se abre en otra pestaña, y desde
        ahí se imprime o se descarga.

      = f.submit "Emitir", class: "btn btn-documento"

-# ⚠️ Era una tarjeta entera con 375 caracteres de prosa, siempre abierta. Es
-# una explicación buena y se lee UNA vez: quien emite la constancia número
-# treinta ya sabe por qué no se archiva. El título dice de qué se trata; quien
-# quiera la respuesta la abre.
= mas_detalle "Qué comprueba el código de una constancia" do
  %p
    Cada constancia sale con su
    %strong código y su QR,
    igual que el boletín. Quien lo escanee ve que el plantel emitió ese papel
    ese día, y qué decía.
  %p
    ⚠️ Lo que NO dice es que hoy siga siendo cierto. El boletín certifica
    %strong calificaciones
    —lo que decía en diciembre sigue diciéndolo en marzo— y la constancia, una
    %strong situación del día.
    Si el alumno cambia de sección, la constancia de mañana dice lo nuevo y la
    de ayer sigue diciendo lo de ayer.
