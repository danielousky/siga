%h1= "#{@student.user.name} #{@student.user.last_name}"

.card
  .card-body
    %dl.row
      %dt.col-sm-3 Nombre
      %dd.col-sm-9= @student.user.name
      %dt.col-sm-3 Apellido
      %dd.col-sm-9= @student.user.last_name
      %dt.col-sm-3 Cédula
      %dd.col-sm-9= @student.user.id_card || "—"
      %dt.col-sm-3 Email
      %dd.col-sm-9= @student.user.email
      %dt.col-sm-3 Carnet Escolar
      %dd.col-sm-9= @student.school_card

.mt-3
  = link_to "Editar", edit_student_path(@student), class: "btn btn-outline-secondary"
  = link_to "Volver", students_path, class: "btn btn-outline-primary"
  = link_to "Eliminar", @student, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-outline-danger"
