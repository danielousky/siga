-# La ficha del alumno (MOR-135).
-#
-# Antes: un `dl` del generador con cinco campos que ya estaban en la fila de la
-# lista, maquetado con clases de Bootstrap —`.card`, `.col-sm-3`,
-# `.btn-outline-secondary`— que esta app **no carga**. Salía sin una sola regla
-# de estilo aplicada. Ver `StudentsController#show` para el orden de la
-# pantalla, que es el de la secretaría, no el del esquema.
- alumno = @student.user

.ficha
  .ficha-cabecera
    -# La foto, o las iniciales con su color. Es lo que hace que quien abre la
    -# ficha reconozca al niño antes de leer el nombre.
    .ficha-identidad
      = avatar(alumno, tamano: :grande)
      %div
        %h1.ficha-nombre= alumno.apellidos_y_nombres
        %p.ficha-situacion
          - if @inscripcion
            = "#{@inscripcion.section.grade.name} – #{@inscripcion.section.name}"
            %span.ficha-punto ·
            = @inscripcion.section.academic_period.name
          - else
            %span.ficha-sin-cupo Sin inscripción activa

    .ficha-acciones
      = boton "Editar", edit_student_path(@student), icono: :editar, tono: :secondary
      -# ⚠️ La constancia DE ESTE ALUMNO, y se descarga con el clic. Llevaba a
      -# «Documentos ▸ Constancias» con la sección puesta, donde había que volver
      -# a buscarlo entre treinta. Daniel, 13 de octubre de 2026: *«ese enlace
      -# debe ir directamente a la descarga de la constancia del alumno en
      -# particular, no a la sección»*. Ver `students/_emitir`.
      - if @inscripcion && puede?(:emitir_documentos)
        = render "students/emitir", texto: "Constancia", ruta: constancias_path,
                 inscripcion: @inscripcion, tooltip: "La constancia de estudio de hoy, en PDF"

  -# ── 1. A quién llamar ────────────────────────────────────────────────────
  -# Va primero porque es el motivo número uno por el que se abre esta pantalla,
  -# y hasta hoy el dato no estaba acá: había que ir a Representantes y buscar
  -# al revés, alumno por alumno.
  .card-academic
    = render "shared/cabecera", titulo: "A quién llamar", nivel: 2

    - if @responsables.any?
      %ul.ficha-responsables
        - @responsables.each do |vinculo|
          - persona = vinculo.representative.user
          %li.ficha-responsable
            %div
              %span.ficha-responsable-nombre= persona.nombre_completo
              %span.ficha-responsable-vinculo= vinculo.etiqueta
              - if vinculo.principal?
                %span.ficha-principal Principal
            .ficha-responsable-contacto
              - if vinculo.representative.phone.present?
                -# `tel:` y no texto plano: desde el teléfono de la secretaría es
                -# un toque, y es desde donde se llama.
                = link_to vinculo.representative.phone, "tel:#{vinculo.representative.phone.gsub(/\s/, '')}", class: "ficha-telefono"
              - else
                %span.ficha-falta Sin teléfono
              %span.ficha-correo= persona.email
    - else
      -# ⚠️ Con la salida al lado, no solo el diagnóstico (MOR-180).
      -#
      -# Decía qué faltaba y ahí terminaba: el director leía «nadie figura como
      -# responsable» y tenía que irse a Representantes, crear uno y volver a
      -# buscar a este alumno entre doscientas casillas. El enlace lleva el id
      -# puesto, así que el formulario abre con su casilla ya marcada.
      .empty-state
        %h3 Sin representante registrado
        %p
          Nadie figura como responsable de #{alumno.first_name}. Si el colegio llama a
          la familia, hoy tiene que buscar el número por fuera del sistema.
        .empty-state-acciones
          - if can_manage_students?
            = link_to new_representative_path(alumno_id: @student.id), class: "btn btn-guardar" do
              = icono(:agregar, tamano: 16)
              %span= "Registrar a su representante"

  -# ── 2. Cómo va ───────────────────────────────────────────────────────────
  - if @inscripcion && @boletin
    .card-academic
      = render "shared/cabecera", titulo: "Cómo va", nivel: 2

      - if @lapsos.many?
        .filter-pills
          - @lapsos.each do |lapso|
            = link_to lapso.name, student_path(@student, lapso: lapso.id),
                      class: "filter-pill #{'active' if @lapso == lapso}"

      %ul.ficha-materias
        - @boletin["materias"].each do |fila|
          %li.ficha-materia
            %span.ficha-materia-nombre= fila["materia"]
            - if fila["nota"]
              %span.ficha-nota{class: fila["nota"] >= 10 ? "ficha-nota--aprobada" : "ficha-nota--aplazada"}
                = EscalaLiteral.mostrar(fila["nota"], escala: @inscripcion.section.grade.escala)
            - else
              -# Nunca un cero. Sin nota quiere decir que el profesor no ha
              -# corregido, y confundirlos reprueba a un alumno en el teléfono.
              %span.ficha-pendiente Pendiente

      - if @boletin["promedio"]
        %p.ficha-promedio
          Promedio de #{@lapso.name.downcase}:
          %strong= EscalaLiteral.mostrar(@boletin["promedio"], escala: @inscripcion.section.grade.escala)
      - else
        %p.nota-ayuda Todavía no hay notas cargadas en este lapso.

  -# ── 3. Los datos ─────────────────────────────────────────────────────────
  .card-academic
    = render "shared/cabecera", titulo: "Datos", nivel: 2

    .detail-row
      .detail-item
        %span.detail-label Cédula escolar
        %p.detail-value= alumno.cedula_escolar.presence || "—"
      .detail-item
        %span.detail-label Cédula de identidad
        %p.detail-value= alumno.document.presence || "—"
      .detail-item
        %span.detail-label Carnet del colegio
        %p.detail-value= @student.school_card.presence || "—"
    .detail-row
      .detail-item
        %span.detail-label Fecha de nacimiento
        %p.detail-value= alumno.birth_date ? l(alumno.birth_date, format: :long) : "—"
      .detail-item
        %span.detail-label Sexo
        %p.detail-value= User::SEX_LABELS[alumno.sex] || "—"
      .detail-item
        %span.detail-label Correo
        %p.detail-value= alumno.email

  -# ── 4. Los documentos oficiales del MPPE (MOR-99) ────────────────────────
  -#
  -# Van en la ficha del alumno porque se piden de a uno: la mamá llega a la
  -# secretaría por el papel de SU hijo.
  -#
  -# ⚠️ Pero ya NO es el único sitio. Hasta el 1 de octubre de 2026 este
  -# comentario decía «y no en un menú aparte», y eso valía para la 31059; los
  -# otros cuatro son papeles de fin de año que se le entregan a TODA la sección.
  -# Con la ficha como única puerta eran veinticuatro clics por sección — y
  -# además nadie los encontraba: Cyndi los dio por faltantes. Ahora están
  -# también en «Documentos ▸ Certificados», de a uno o de a veinticuatro.
  -#
  -# Lo que sigue siendo solo de acá es el Excel de la 31059: es para completar
  -# a mano, de un alumno por vez.
  -#
  -# ⚠️ Y desde el 13 de octubre de 2026 están AQUÍ también la constancia y el
  -# boletín, cada uno a un clic. Daniel, en la muestra: *«en los documentos
  -# oficiales debe ir un enlace directo a la constancia de estudio y la
  -# boleta»*. Son los dos papeles que más se piden de a uno, y la tarjeta solo
  -# ofrecía el de fin de año. Cada botón va a la misma acción que
  -# «Documentos» (`students/_emitir`), con este alumno ya elegido.
  .card-academic
    = render "shared/cabecera", titulo: "Documentos oficiales", nivel: 2

    - if @inscripcion && puede?(:emitir_documentos)
      - seccion = @inscripcion.section
      .ficha-documento
        %p
          %strong Constancia de estudio
          \— dice que hoy cursa #{seccion.grade.name} – #{seccion.name}. Para el
          pasaporte, una beca, el seguro o una embajada.
        .acciones-de-cabecera
          = render "students/emitir", texto: "Emitir", ruta: constancias_path,
                   inscripcion: @inscripcion

      -# ⚠️ Un botón por lapso, y el anual: las mismas opciones que «Qué se
      -# emite» en «Documentos ▸ Boletines». Quien está en la ventanilla sabe
      -# cuál le pidieron; deducirlo sería adivinar.
      .ficha-documento
        %p
          %strong Boletín
          \— las notas de un lapso, o las del año completo, con su código para
          verificarlo.
        .acciones-de-cabecera
          - @lapsos.each do |lapso|
            = render "students/emitir", texto: lapso.name, ruta: report_cards_path, sm: true,
                     inscripcion: @inscripcion, params: { evaluation_moment_id: lapso.id }
          = render "students/emitir", texto: "Anual", ruta: report_cards_path, sm: true,
                   inscripcion: @inscripcion, params: { evaluation_moment_id: "anual" }

    .ficha-documento
      - if @inscripcion&.section&.grade&.media?
        %p
          %strong Certificación de Calificaciones
          \— forma
          %code 31059
          \· Educación Media. Trae todos los años cursados en un solo papel.
        %p.nota-ayuda
          El PDF es el documento terminado. El Excel es el mismo pero editable, para
          completar a mano lo que el sistema todavía no guarda.
        .acciones-de-cabecera
          -# El PDF se ABRE en otra pestaña; el Excel se baja: ningún navegador
          -# previsualiza una planilla (`EntregaDocumentos`).
          = boton "Certificación en PDF", certificacion_de_calificaciones_path(student_id: @student, format: :pdf),
                  icono: :ver, tono: :documento, target: "_blank", rel: "noopener"
          = boton "Certificación en Excel", certificacion_de_calificaciones_path(student_id: @student, format: :xlsx),
                  icono: :descargar, tono: :secondary, data: { turbo: false }

      - elsif @inscripcion&.section&.grade&.primaria?
        %p
          -# El grado decide cuál de los dos: el último de primaria promueve al
          -# nivel de media y lleva CERTIFICADO; los demás llevan CONSTANCIA.
          %strong Certificado de Educación Primaria
          o
          %strong Constancia de Prosecución
          \, según el grado que cursó. Certifica el literal del año.
        -# ⚠️ `documento` (petróleo), no el azul que tenía: de aquí SALE un papel,
        -# igual que «Emitir» del boletín. Lo destapó la auditoría de
        -# tonos del 8 de septiembre — era el único de los dieciséis que estaba en
        -# el tono equivocado, y llevaba así desde que existe.
        -# ⚠️ En OTRA pestaña, y no por gusto: este papel se audita al dibujarse,
        -# y como enlace de Turbo se pedía dos veces por clic —y una más al pasar
        -# el mouse por encima— (`EntregaDocumentos`).
        = boton "Emitir el documento", documento_de_primaria_path(enrollment_id: @inscripcion),
                icono: :ver, tono: :documento, target: "_blank", rel: "noopener"

      - elsif @inscripcion&.section&.grade&.preescolar?
        %p
          -# El grupo decide cuál de los dos: el III —el último— certifica los
          -# estudios y dice que el niño continúa a primaria; los otros dos llevan
          -# la constancia de prosecución entre grupos.
          %strong Certificación de Estudios
          o
          %strong Constancia de Prosecución
          \, según el grupo que cursó.
        -# ⚠️ Sin literal ni calificación: en Educación Inicial no las hay, y el
        -# formato del ministerio tampoco tiene dónde ponerlas.
        %p.nota-ayuda
          En Educación Inicial no se certifica una calificación: el formato dice qué
          grupo cursó y en qué período escolar.
        = boton "Emitir el documento", documento_de_inicial_path(enrollment_id: @inscripcion),
                icono: :ver, tono: :documento, target: "_blank", rel: "noopener"

      - else
        %p.nota-pendiente
          Este alumno no tiene una inscripción activa, así que todavía no hay nada que
          certificar.

  %p.ficha-volver
    = link_to "← Volver a la lista", students_path
