%h1 Editar registro de estudiante

%p.entrada-pagina
  Modificando registro de
  %strong= "#{@student.user.nombre_completo}"

= render "form", student: @student

= render "shared/borrar", registro: @student, aviso: "Se borran también sus calificaciones y su historia académica.", alternativa: "Para un alumno que se va del colegio, lo correcto es retirar su inscripción: la historia se queda."
