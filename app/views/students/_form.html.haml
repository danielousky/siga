= form_with(model: student) do |f|
  = render "shared/errors", object: student

  .card-academic{style: "margin-bottom: var(--space-lg);"}
    %h3{style: "margin-bottom: var(--space-lg);"} Datos del Usuario
    = f.fields_for :user do |u|
      .form-group
        = u.label :name, "Nombre", class: "form-label"
        = u.text_field :name, class: "form-control", placeholder: "Ingrese el nombre"
      .form-group
        = u.label :last_name, "Apellido", class: "form-label"
        = u.text_field :last_name, class: "form-control", placeholder: "Ingrese el apellido"
      .form-group
        = u.label :id_card, "Cédula", class: "form-label"
        = u.text_field :id_card, class: "form-control", placeholder: "V-12345678"
      .form-group
        = u.label :email, "Email", class: "form-label"
        = u.email_field :email, class: "form-control", placeholder: "ejemplo@dominio.com"
      - if student.new_record?
        .form-group
          = u.label :password, "Contraseña", class: "form-label"
          = u.password_field :password, class: "form-control", placeholder: "Mínimo 6 caracteres"
        .form-group
          = u.label :password_confirmation, "Confirmar Contraseña", class: "form-label"
          = u.password_field :password_confirmation, class: "form-control", placeholder: "Reingrese la contraseña"

  .card-academic{style: "margin-bottom: var(--space-lg);"}
    %h3{style: "margin-bottom: var(--space-lg);"} Datos del Estudiante
    .form-group
      = f.label :school_card, "Carnet escolar", class: "form-label"
      = f.text_field :school_card, class: "form-control", placeholder: "Número de carnet"

  .actions-group
    .form-acciones
      = f.submit "Guardar registro", class: "btn btn-primary"
      - if local_assigns[:volver]
        = link_to "Volver", volver, class: "btn btn-secondary"
    = link_to "Cancelar", students_path, class: "btn btn-secondary"
