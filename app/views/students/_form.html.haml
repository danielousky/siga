= form_with(model: student) do |f|
  = render "shared/errors", object: student

  .card-academic
    %h3{style: "margin-bottom: var(--space-lg);"} Datos del usuario
    = f.fields_for :user do |u|
      .form-group
        = u.label :first_name, "Nombres", class: "form-label"
        = u.text_field :first_name, class: "form-control", placeholder: "Álvaro José"
      .form-row
        .form-group
          = u.label :last_name, "Primer apellido", class: "form-label"
          = u.text_field :last_name, class: "form-control", placeholder: "López"
        .form-group
          = u.label :second_last_name, "Segundo apellido", class: "form-label"
          = u.text_field :second_last_name, class: "form-control", placeholder: "Medina"
      .form-group
        = u.label :cedula_escolar, "Cédula escolar", class: "form-label"
        = u.text_field :cedula_escolar, class: "form-control", placeholder: "V20140000001"
        %p.nota-ayuda La asigna el MPPE. Es la que se usa mientras el alumno no tenga cédula de identidad.
      .form-row
        .form-group
          = u.label :document, "Cédula de identidad", class: "form-label"
          = u.text_field :document, class: "form-control", placeholder: "V-12345678"
        .form-group
          = u.label :document_type, "Tipo de documento", class: "form-label"
          = u.select :document_type, User::DOCUMENT_TYPE_LABELS.map { |v, t| [t, v] }, { include_blank: "—" }, class: "form-select"
      .form-row
        .form-group
          = u.label :birth_date, "Fecha de nacimiento", class: "form-label"
          = u.date_field :birth_date, class: "form-control"
        .form-group
          = u.label :sex, "Sexo", class: "form-label"
          = u.select :sex, User::SEX_LABELS.map { |v, t| [t, v] }, { include_blank: "—" }, class: "form-select"
      .form-group
        = u.label :email, "Email", class: "form-label"
        = u.email_field :email, class: "form-control", placeholder: "ejemplo@dominio.com"
      - if student.new_record?
        .form-group
          = u.label :password, "Contraseña", class: "form-label"
          = u.password_field :password, class: "form-control", placeholder: "Mínimo 6 caracteres"
        .form-group
          = u.label :password_confirmation, "Confirmar Contraseña", class: "form-label"
          = u.password_field :password_confirmation, class: "form-control", placeholder: "Reingrese la contraseña"

  .card-academic
    %h3{style: "margin-bottom: var(--space-lg);"} Datos del estudiante
    .form-group
      = f.label :school_card, "Carnet escolar", class: "form-label"
      = f.text_field :school_card, class: "form-control", placeholder: "Número de carnet"

  .actions-group
    .form-acciones
      = f.submit "Guardar registro", class: "btn btn-primary"
      - if local_assigns[:volver]
        = link_to "Volver", volver, class: "btn btn-secondary"
    = link_to "Cancelar", students_path, class: "btn btn-secondary"
