.card-academic
  .card-academic-header
    %h1 Alumnos
    = link_to new_student_path, class: "btn btn-primary" do
      = icono(:agregar, tamano: 16)
      %span Registrar alumno

= render "shared/buscador_de_lista", ruta: students_path, marco: "students-results",
         pista: "Nombre, apellido, cédula o carnet…"

-# ⚠️ Un atajo, no un filtro más del buscador.
-#
-# «Sin representante» no es una manera de acotar una búsqueda: es UNA pregunta
-# concreta que el colegio se hace en septiembre —¿a quién no puedo llamar?— y
-# que el panel enlaza directo. Meterla como un desplegable más la escondería
-# entre los otros controles.
-#
-# Solo aparece si hay alguno: un atajo a una lista vacía es ruido.
- if @cuantos_sin_representante.positive? || sin_representante?
  .card-academic.filtro-atajo
    - if sin_representante?
      %span.filtro-atajo-activo
        = icono(:representantes, tamano: 15)
        = contar(@cuantos_sin_representante, "alumno sin representante", "alumnos sin representante")
      = link_to "Ver todos", students_path, class: "btn btn-secondary btn-sm"
    - else
      %span.filtro-atajo-texto
        = icono(:representantes, tamano: 15)
        = "#{contar(@cuantos_sin_representante, 'alumno', 'alumnos')} sin representante registrado: el colegio no tiene a quién llamar."
      = link_to students_path(sin_representante: 1), class: "btn btn-secondary btn-sm" do
        %span Ver quiénes son

-# `target: "_top"` no es un detalle: sin él, TODO enlace de adentro del frame
-# —Ver, Editar, Eliminar— navega DENTRO del frame. Y como ninguna de esas
-# páginas contiene un frame con este id, Turbo pinta «Content missing» en vez
-# del detalle del alumno. Un botón que no lleva a ningún lado.
-#
-# El buscador sigue actualizando el frame porque declara su destino explícito
-# (`data: { turbo_frame: … }` en shared/_search_filter), y eso le gana al
-# `target` del frame.
= turbo_frame_tag "students-results", target: "_top" do
  -# El estado vacío sale de `PasosDeArranque`, o sea del MISMO lugar que el
  -# mapa del panel: dos redacciones del mismo paso se van separando, y quien
  -# las lee cree que son dos cosas distintas.
  -# ⚠️ Dos vacíos distintos. Buscar «López Guzmán» y leer «Todavía no hay
  -# alumnos» con 200 cargados es lo que Daniel llamó «un primer día
  -# frustrante»: el sistema decía que la matrícula no existe.
  - if @students.empty? && (params[:q].present? || sin_representante?)
    .card-academic
      .empty-state
        - if params[:q].present?
          %h3= "Ningún alumno coincide con “#{params[:q].strip}”"
          %p
            Se busca por nombre, apellido, cédula o carnet, y cada palabra puede
            caer en un campo distinto. La matrícula sigue completa.
        - else
          %h3 Todos los alumnos tienen representante
          %p No queda ninguno sin alguien a quien llamar.

  - elsif @students.empty?
    .card-academic
      = render "shared/lista_vacia", clave: :alumnos,
               acciones: [ { texto: "Subir la matrícula", ruta: importaciones_path, icono: :importar },
                 { texto: "Registrar alumno", ruta: new_student_path, icono: :agregar, clase: "btn-secondary" } ]
  - else
    .card-academic
      -# La escala va DENTRO del frame a propósito: así el número lo actualiza el
      -# buscador. En el encabezado, de afuera, se quedaría diciendo 200 mientras
      -# la tabla muestra 3 resultados — peor que no ponerlo.
      = render "shared/escala", total: @pagy.count, singular: "alumno", plural: "alumnos",
               detalle: (params[:q].present? ? "de la búsqueda “#{params[:q].strip}”" : nil)

      %table.table-academic
        %thead
          %tr
            %th Alumno
            %th Cédula escolar
            %th Cédula
            %th= Student.human_attribute_name(:school_card)
        %tbody
          - @students.each do |student|
            %tr
              -# ⚠️ Acá había una celda de MÁS —`document` repetido— y la tabla
              -# salía corrida: «Cédula escolar» mostraba un guión, «Cédula»
              -# mostraba la cédula escolar y el carnet quedaba sin encabezado.
              -# Cuatro encabezados contra cinco celdas.
              %td= link_to persona_con_avatar(student.user), student
              %td= student.user.cedula_escolar.presence || "—"
              %td= student.user.document.presence || "—"
              %td= student.school_card
