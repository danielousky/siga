%h1 Estudiantes

= link_to "Nuevo Estudiante", new_student_path, class: "btn btn-primary mb-3"

%table.table.table-striped.table-hover
  %thead
    %tr
      %th Nombre
      %th Apellido
      %th Cédula
      %th Carnet Escolar
      %th Escuela
      %th Acciones
  %tbody
    - @students.each do |student|
      %tr
        %td= student.user.name
        %td= student.user.last_name
        %td= student.user.id_card || "—"
        %td= student.school_card
        %td= student.school.name
        %td
          = link_to "Ver", student, class: "btn btn-sm btn-outline-primary"
          = link_to "Editar", edit_student_path(student), class: "btn btn-sm btn-outline-secondary"
          = link_to "Eliminar", student, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-sm btn-outline-danger"

!= pagy_bootstrap_nav(@pagy)
