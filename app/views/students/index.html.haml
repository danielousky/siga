.card-academic
  .card-academic-header
    %h1 Registro de Estudiantes
    = link_to "Registrar Nuevo Estudiante", new_student_path, class: "btn btn-primary"

  %table.table-academic
    %thead
      %tr
        %th Nombre
        %th Apellido
        %th Cédula
        %th Carnet Escolar
        %th Escuela
        %th Acciones
    %tbody
      - @students.each do |student|
        %tr
          %td= student.user.name
          %td= student.user.last_name
          %td= student.user.id_card || "—"
          %td= student.school_card
          %td= student.school.name
          %td
            .actions-group
              = link_to "Ver", student, class: "btn btn-secondary btn-sm"
              = link_to "Editar", edit_student_path(student), class: "btn btn-secondary btn-sm"
              = link_to "Eliminar", student, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar este registro?" }, class: "btn btn-outline-danger btn-sm"

!= pagy_bootstrap_nav(@pagy)
