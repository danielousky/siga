= form_with(model: admin) do |f|
  = render "shared/errors", object: admin

  .form-seccion
    %h2.form-seccion-titulo Datos de la persona
    = f.fields_for :user do |u|
      .form-group
        = u.label :first_name, class: "form-label"
        = u.text_field :first_name, class: "form-control"
      .form-row
        .form-group
          = u.label :last_name, class: "form-label"
          = u.text_field :last_name, class: "form-control"
        .form-group
          = u.label :second_last_name, class: "form-label"
          = u.text_field :second_last_name, class: "form-control"
      .form-row
        .form-group
          = u.label :document, class: "form-label"
          = u.text_field :document, class: "form-control"
        .form-group
          = u.label :document_type, class: "form-label"
          = u.select :document_type, User::DOCUMENT_TYPE_LABELS.map { |v, t| [t, v] }, { include_blank: "—" }, class: "form-select"
      .form-row
        .form-group
          = u.label :birth_date, class: "form-label"
          = u.date_field :birth_date, class: "form-control"
        .form-group
          = u.label :sex, class: "form-label"
          = u.select :sex, User::SEX_LABELS.map { |v, t| [t, v] }, { include_blank: "—" }, class: "form-select"

  .form-seccion
    %h2.form-seccion-titulo Cómo entra al sistema
    = f.fields_for :user do |u|
      .form-group
        = u.label :email, class: "form-label"
        = u.email_field :email, class: "form-control", required: true
        %p.nota-ayuda Esta persona entra al sistema con este correo, y es por donde recupera su contraseña.
      - if admin.new_record?
        -# `required` porque desde `MOR-142` el modelo ya no la exige: una persona
        -# puede existir sin credenciales. Para el personal del colegio eso todavía
        -# no tiene salida —el código de activación existe para representantes y
        -# para el primer director de un colegio, no acá— así que dejarla en blanco
        -# crearía un profesor que no puede entrar y nadie se enteraría.
        .form-group
          = u.label :password, class: "form-label"
          = u.password_field :password, class: "form-control", required: true
        .form-group
          = u.label :password_confirmation, class: "form-label"
          = u.password_field :password_confirmation, class: "form-control", required: true

  .form-seccion
    %h2.form-seccion-titulo Su rol en el colegio
    .form-group
      = f.label :role, class: "form-label"
      = f.select :role, Admin.roles.keys.map { |r| [r.humanize, r] }, { include_blank: "Seleccione..." }, class: "form-select"

  .form-acciones
    = f.submit class: "btn btn-primary"
    - if local_assigns[:volver]
      = link_to volver, class: "btn btn-secondary" do
        = icono(:volver, tamano: 16)
        %span Volver
