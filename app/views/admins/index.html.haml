.card-academic
  .card-academic-header
    %h1 Administradores
    = link_to "Nuevo Administrador", new_admin_path, class: "btn btn-primary"

  %table.table-academic
    %thead
      %tr
        %th Nombre
        %th Apellido
        %th Correo
        %th Rol
        %th Acciones
    %tbody
      - @admins.each do |admin|
        %tr
          %td= admin.user.name
          %td= admin.user.last_name
          %td= admin.user.email
          %td
            %span.role-badge= admin.role.humanize
          %td
            .actions-group
              = link_to "Editar", edit_admin_path(admin), class: "btn btn-secondary btn-sm"
