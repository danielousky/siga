.card-academic
  .card-academic-header
    %h1 Administradores
    = link_to "Nuevo administrador", new_admin_path, class: "btn btn-primary"

  %table.table-academic
    %thead
      %tr
        %th Nombre
        %th Apellido
        %th Correo
        %th Rol
    %tbody
      - @admins.each do |admin|
        %tr
          %td= link_to admin.user.first_name, edit_admin_path(admin)
          %td= admin.user.apellidos
          %td= admin.user.email
          %td
            %span.role-badge= admin.role.humanize
