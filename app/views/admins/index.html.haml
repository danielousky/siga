%h1 Administradores

= link_to "Nuevo Administrador", new_admin_path, class: "btn btn-primary mb-3"

%table.table.table-striped.table-hover
  %thead
    %tr
      %th Nombre
      %th Apellido
      %th Email
      %th Rol
      %th Escuela
      %th Acciones
  %tbody
    - @admins.each do |admin|
      %tr
        %td= admin.user.name
        %td= admin.user.last_name
        %td= admin.user.email
        %td= admin.role.humanize
        %td= admin.school.name
        %td
          = link_to "Ver", admin, class: "btn btn-sm btn-outline-primary"
          = link_to "Editar", edit_admin_path(admin), class: "btn btn-sm btn-outline-secondary"
          = link_to "Eliminar", admin, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-sm btn-outline-danger"

!= pagy_bootstrap_nav(@pagy)
