.card-academic
  .card-academic-header
    %h1= "Promover alumnos a #{@destino.name}"

  - if @origenes.empty?
    .empty-state
      %h3 No hay de dónde promover
      %p= "#{@destino.name} es el único año escolar cargado. La promoción sirve a partir del segundo."

  - elsif !@tiene_secciones
    -# ⚠️ Sin secciones en el año nuevo no hay dónde inscribir a nadie. Se dice
    -# con el camino de salida, no con una lista vacía.
    -#
    -# ⚠️ Y el comentario va ACÁ ADENTRO: en Haml, un comentario ENTRE un `if` y
    -# su `elsif` rompe el bloque con «Got "elsif" with no preceding "if"». Es la
    -# misma trampa del `case`/`when`.
    .empty-state
      %h3= "#{@destino.name} todavía no tiene secciones"
      %p
        Promover es inscribir a cada alumno en una sección del año nuevo, así que
        primero hay que armarlas. Se pueden traer del año anterior de un clic:
        las mismas secciones, con su cupo, su aula y su profesor guía.
      .empty-state-acciones
        = link_to copiar_al_academic_period_path(@destino), class: "btn btn-accion" do
          = icono(:calendario, tamano: 16)
          %span= "Copiar la estructura a #{@destino.name}"

  - else
    %p.nota-ayuda
      Se lee la nota definitiva de cada alumno y se propone dónde queda.
      %strong Nada se escribe hasta que usted confirme.

    = form_with url: promover_al_academic_period_path(@destino), method: :get, class: "form-row" do
      .form-group
        = label_tag :origen_id, "Promover desde", class: "form-label"
        = select_tag :origen_id, options_for_select(@origenes.map { |a| [ a.name, a.id ] }, @origen&.id),
                     class: "form-select", data: { controller: "auto-envio", action: "change->auto-envio#enviar" }

    -# ── Sin notas: el caso NORMAL de un cliente nuevo ─────────────────────
    - unless @hay_notas
      .empty-state
        %h3= "#{@origen.name} no tiene notas definitivas cargadas"
        %p
          Es lo normal el primer año con SIGA: las notas de ese año están en su
          sistema anterior o en papel. Sin ellas SIGA no puede decidir quién
          pasa, así que la decisión es suya.
        .empty-state-acciones
          = link_to promover_al_academic_period_path(@destino, origen_id: @origen.id, sin_datos: 1),
                    class: "btn btn-accion" do
            = icono(:alumnos, tamano: 16)
            %span Pasar a todos al siguiente grado
          = boton "Subir primero las notas anteriores", importaciones_path, icono: :importar, tono: :secondary

    - if @conteo.any?
      .promocion-resumen
        - { promueve: "pasan de grado", repite: "repiten", egresa: "egresan", sin_datos: "sin nota cargada" }.each do |clave, texto|
          - cuantos = @conteo[clave].to_i
          - next if cuantos.zero?
          %span.promocion-cifra{class: "promocion-cifra--#{clave}"}
            %strong= cuantos
            = texto

      %table.table-academic
        %thead
          %tr
            %th Sección
            %th Queda en
            %th Alumnos
        %tbody
          - @por_seccion.each do |seccion, filas|
            - destino_de = filas.map(&:grado_destino).compact.uniq
            %tr
              %td= "#{seccion.grade.name} #{seccion.name}"
              %td
                - if filas.all? { |f| f.situacion == :egresa }
                  %span.dato-secundario egresan
                - elsif filas.any?(&:sin_seccion?)
                  -# El aviso más importante de la pantalla: hay alumnos sin
                  -# dónde caer, y se puede resolver antes de confirmar.
                  %span.nota-pendiente= "falta la sección de #{destino_de.map(&:name).to_sentence}"
                  = link_to "Crear", new_section_path, class: "btn btn-secondary btn-sm"
                - else
                  = destino_de.map(&:name).to_sentence.presence || "—"
              %td
                = contar(filas.count { |f| f.se_inscribe? }, "pasa", "pasan")
                - repiten = filas.count { |f| f.situacion == :repite }
                - if repiten.positive?
                  %span.dato-secundario= "· #{repiten} repiten"
                - sin_datos = filas.count { |f| f.situacion == :sin_datos }
                - if sin_datos.positive?
                  %span.nota-pendiente= "· #{sin_datos} sin nota"

      - a_inscribir = @promocion.propuesta.count(&:se_inscribe?)
      = form_with url: hacer_promocion_al_academic_period_path(@destino), method: :post, class: "form-acciones" do
        = hidden_field_tag :origen_id, @origen.id
        - if params[:sin_datos].present?
          = hidden_field_tag :sin_datos, "1"
        - if a_inscribir.positive?
          = submit_tag "Promover a #{contar(a_inscribir, 'alumno', 'alumnos')}", class: "btn btn-accion", data: { turbo: false }
        = boton "Volver", academic_periods_path, icono: :volver, tono: :secondary

    - elsif @hay_notas
      .empty-state
        %h3= "#{@origen.name} no tiene alumnos inscritos"
        %p No hay a quién promover desde ese año escolar.
