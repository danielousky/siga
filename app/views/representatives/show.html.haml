-# ⚠️ El código va ARRIBA DE TODO, y antes estaba al final (MOR-199).
-#
-# Daniel: *«tampoco sale el código generado»*. Salía —lo comprobé en un
-# navegador— pero al pie de la página, debajo de la tabla de alumnos: en el
-# único momento en que esa pantalla tiene una cosa urgente que decir, esa cosa
-# estaba en el último renglón.
-#
-# Y no es un detalle de gusto: el código **se ve una sola vez**. Si se pierde de
-# vista, la única salida es generar otro — que invalida el que se acaba de
-# mandar por correo.
= render "shared/codigo_generado", usuario: @representative.user

.card-academic
  = render layout: "shared/cabecera", locals: { titulo: @representative.nombre_completo } do
    -# ⚠️ El acceso al sistema, AL LADO DEL NOMBRE (MOR-187). Era una tarjeta
    -# entera —título, una fila de `dl` y un párrafo— para decir dos cosas: si
    -# puede entrar y un botón. Daniel lo marcó en pantalla.
    = render "shared/acceso_al_sistema", usuario: @representative.user,
             url: codigo_representative_path(@representative)
    = boton "Editar", edit_representative_path(@representative), icono: :editar, tono: :secondary

  -# ⚠️ Cada acción AL LADO de su dato, sin una sección aparte (QA de Daniel:
  -# «los botones puedes colocarlos al lado de sus respectivos elementos, no hay
  -# que agregar otra sección para ello»).
  -#
  -# Y tenía razón por una razón concreta: una sección «Escribirle» obliga a leer
  -# el correo arriba, bajar, y volver a decidir a cuál de los dos canales
  -# corresponde. Pegado al dato, el botón ES la acción de ese dato.
  -#
  -# El compositor sigue CERRADO: esta pantalla se abre muchas veces para mirar un
  -# teléfono y pocas para escribir. Es un `<details>` nativo —se abre sin
  -# JavaScript, el teclado lo alcanza y el navegador ya sabe anunciarlo— y su
  -# `summary` va pintado como botón.
  - correo = @representative.user.email
  - whatsapp = Contacto.whatsapp_url(@representative.phone, "Buenos días, le escribimos de #{Current.school.name}.")
  - puede_escribir = can_manage_students?

  %dl.detalle
    %dt Correo
    %dd
      .dato-con-accion
        - if correo.present?
          %span= correo
        - else
          %span.nota-pendiente Sin correo — hay que hacerle llegar el enlace de acceso

        - if correo.present? && puede_escribir
          %details.compositor
            %summary.btn.btn-documento.btn-sm
              = icono(:boletines, tamano: 14)
              %span Enviar correo

            -# ⚠️ El correo sale del dominio de SIGA —ElasticEmail solo despacha
            -# dominios verificados— y la respuesta va a quien escribe. Ver
            -# `ComunicacionMailer`.
            = form_with url: mensaje_al_representative_path(@representative), method: :post, class: "compositor-cuerpo", data: { turbo: false } do
              .form-group
                = label_tag :asunto, "Asunto", class: "form-label"
                = text_field_tag :asunto, nil, class: "form-control", required: true, maxlength: 120, placeholder: "Reunión de representantes"
              .form-group
                = label_tag :cuerpo, "Mensaje", class: "form-label"
                = text_area_tag :cuerpo, nil, class: "form-control", required: true, rows: 6
              %p.nota-ayuda
                = "Le llega a #{correo} de parte del colegio, y si responde le llega a usted."
              .form-acciones
                = submit_tag "Enviar", class: "btn btn-documento"

    %dt Teléfono
    %dd
      .dato-con-accion
        %span= @representative.phone.presence || "—"
        - if whatsapp && puede_escribir
          -# `target` y `rel` porque sale de la app: sin `noopener`, la pestaña
          -# que se abre puede reescribir la de SIGA.
          = boton "WhatsApp", whatsapp, target: "_blank", rel: "noopener", icono: :representantes, tono: :accion, sm: true

    %dt Cédula
    %dd= @representative.user.identificador.presence || "—"

-# ── El seguimiento de lo que se le escribió (MOR-186) ───────────────────────
-#
-# Daniel: «debemos permitir darle seguimiento a los correos... simple, pero que
-# al menos diga qué y cuándo se envió».
-#
-# ⚠️ El registro de actividad NO servía para esto: es una bitácora de quién hizo
-# qué, ordenada por tiempo y mezclada con altas, bajas y cambios de nota. Buscar
-# ahí «qué le escribimos a la mamá de Eduardo» es leer trescientas filas.
- if can_manage_students? && @mensajes.present?
  .card-academic
    = render "shared/cabecera", titulo: "Correos enviados", nivel: 2

    %ul.mensajes
      - @mensajes.each do |mensaje|
        %li.mensaje
          .mensaje-cabecera
            %strong.mensaje-asunto= mensaje.asunto
            %span.dato-secundario= l(mensaje.created_at, format: :long)
          %p.mensaje-cuerpo= mensaje.cuerpo
          %p.dato-secundario
            = "Lo escribió #{mensaje.remitente.nombre_completo} · se envió a #{mensaje.correo}"

.card-academic
  = render "shared/cabecera", titulo: "Alumnos que representa", nivel: 2

  - if @vinculos.empty?
    .empty-state
      %h3 Sin alumnos vinculados
      %p Esta persona todavía no representa a nadie en el colegio.
  - else
    %table.table-academic
      %thead
        %tr
          %th Alumno
          %th Parentesco
      %tbody
        - @vinculos.each do |vinculo|
          %tr
            -# Al detalle del alumno: desde acá se llega a sus notas, su
            -# asistencia y su constancia, que es lo que se viene a mirar después
            -# de ver quién lo representa.
            %td= link_to vinculo.student.user.apellidos_y_nombres, vinculo.student
            %td= vinculo.etiqueta
