.card-academic
  .card-academic-header
    %h1= @representative.nombre_completo
    = link_to "Editar", edit_representative_path(@representative), class: "btn btn-secondary"

  %dl.detalle
    %dt Correo
    %dd
      - if @representative.user.email.present?
        = @representative.user.email
      - else
        %span.nota-pendiente Sin correo — no puede consultar las notas
    %dt Teléfono
    %dd= @representative.phone.presence || "—"
    %dt Cédula
    %dd= @representative.user.identificador.presence || "—"
    %dt Acceso
    %dd
      -# Gris y no ámbar a propósito: que todavía no haya entrado es un HECHO,
      -# no una alerta. La regla de color reserva el ámbar para lo que exige
      -# actuar ya, y acá lo que hay que hacer se dice en palabras.
      - if @representative.user.puede_entrar?
        %span.estado.estado--al-dia Activo
      - else
        %span.estado.estado--inactivo Sin activar

.card-academic
  .card-academic-header
    %h2 Alumnos que representa

  - if @vinculos.empty?
    .empty-state
      %h3 Sin alumnos vinculados
      %p Esta persona todavía no representa a nadie en el colegio.
  - else
    %table.table-academic
      %thead
        %tr
          %th Alumno
          %th Parentesco
      %tbody
        - @vinculos.each do |vinculo|
          %tr
            %td= vinculo.student.user.apellidos_y_nombres
            %td= vinculo.etiqueta
