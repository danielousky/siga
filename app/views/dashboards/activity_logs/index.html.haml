.card-academic
  .card-academic-header
    %h1 Registro de actividad
    %p{style: "color: var(--text-secondary); font-size: 14px; margin: 0;"} Auditoría completa de acciones del sistema

- activity_fields = []
- activity_fields << { type: :text,   name: :usuario_q,      label: "Usuario",        placeholder: "Nombre, apellido, cédula o correo...", flex: 2 }
- activity_fields << { type: :select, name: :activity_action, label: "Tipo de acción", options: [["Todas las acciones", ""]] + ActivityLog::LABELS.map { |k, v| [v, k] } }
- activity_fields << { type: :date,   name: :from,            label: "Desde" }
- activity_fields << { type: :date,   name: :to,              label: "Hasta" }
= render "shared/search_filter", url: dashboards_activity_logs_path, frame_id: "activity-results", clear_url: dashboards_activity_logs_path, fields: activity_fields

- if params[:usuario_q].present? && @usuario_match&.any?
  .filter-pills
    %span{style: "font-size: 13px; color: var(--text-secondary);"} Filtrando por:
    - @usuario_match.each do |u|
      %span.filter-pill
        = "#{u.last_name}, #{u.first_name}"

-# `target: "_top"` no es un detalle: sin él, TODO enlace de adentro del frame
-# —Ver, Editar, Eliminar— navega DENTRO del frame. Y como ninguna de esas
-# páginas contiene un frame con este id, Turbo pinta «Content missing» en vez
-# del detalle del alumno. Un botón que no lleva a ningún lado.
-#
-# El buscador sigue actualizando el frame porque declara su destino explícito
-# (`data: { turbo_frame: … }` en shared/_search_filter), y eso le gana al
-# `target` del frame.
= turbo_frame_tag "activity-results", target: "_top" do
  .card-academic
    .card-academic-header
      %h2 Actividad registrada
      %span.role-badge= "#{@pagy.count} #{'registro'.then { |w| @pagy.count == 1 ? w : w + 's' }}"

    - if @logs.any?
      %table.table-academic
        %thead
          %tr
            %th Fecha y hora
            %th Usuario
            %th Tipo
            %th Descripción
            %th IP
        %tbody
          - @logs.each do |log|
            %tr
              %td{style: "white-space: nowrap; color: var(--text-secondary); font-size: 13px;"}
                = log.created_at.strftime("%d/%m/%Y %H:%M")
              %td= "#{log.user.last_name}, #{log.user.first_name}"
              %td
                %span.activity-badge{class: "activity-badge--#{log.action.split('_').last}"}
                  = log.label
              %td= log.message
              %td{style: "font-size: 12px; color: var(--text-tertiary);"}= log.ip_address || "—"

      .pagy-nav
        != pagy_nav(@pagy)
    - else
      .empty-state
        %h3 Sin registros
        - if params[:usuario_q].present?
          %p No se encontraron usuarios con "#{params[:usuario_q]}"
          %p{style: "font-size: 13px; color: var(--text-tertiary);"} Intente con el nombre completo, número de expediente o correo institucional
        - else
          %p No hay actividad registrada con los filtros seleccionados.
