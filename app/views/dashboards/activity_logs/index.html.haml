-# ⚠️ Ésta es la pantalla donde la cabecera fusionada ocupa DOS líneas, y está
-# bien (MOR-192). Son cuatro filtros —usuario, tipo de acción y un rango de dos
-# fechas—, así que envuelven; el componente es el mismo de las otras seis.
-#
-# Y acá se perdió el subtítulo «Auditoría completa de acciones del sistema»: la
-# pantalla se llama «Registro de actividad» y la tabla que sigue tiene columnas
-# de fecha, usuario y acción. La frase repetía lo que ya se ve.
-# ⚠️ Un `<<` por filtro y no un literal de varias líneas: Haml lee la
-# continuación como indentación y revienta con «Inconsistent indentation».
- acciones = [ [ "Todas las acciones", "" ] ] + ActivityLog::LABELS.map { |k, v| [ v, k ] }
- filtros = []
- filtros << { type: :select, name: :activity_action, label: "Tipo de acción", options: acciones }
- filtros << { type: :date, name: :from, label: "Desde" }
- filtros << { type: :date, name: :to, label: "Hasta" }

= render "shared/cabecera_de_lista", titulo: "Registro de actividad",
         ruta: dashboards_activity_logs_path, marco: "activity-results",
         campo: :usuario_q, pista: "Nombre, apellido, cédula o correo…",
         extra: filtros

- if params[:usuario_q].present? && @usuario_match&.any?
  .filter-pills
    %span.dato-secundario Filtrando por:
    - @usuario_match.each do |u|
      %span.filter-pill
        = u.apellidos_y_nombres

-# `target: "_top"` no es un detalle: sin él, TODO enlace de adentro del frame
-# —Ver, Editar, Eliminar— navega DENTRO del frame. Y como ninguna de esas
-# páginas contiene un frame con este id, Turbo pinta «Content missing» en vez
-# del detalle del alumno. Un botón que no lleva a ningún lado.
-#
-# El buscador sigue actualizando el frame porque declara su destino explícito
-# (`data: { turbo_frame: … }` en shared/_cabecera_de_lista), y eso le gana al
-# `target` del frame.
= turbo_frame_tag "activity-results", target: "_top" do
  .card-academic
    .card-academic-header
      %h2 Actividad registrada
      %span.role-badge= "#{@pagy.count} #{'registro'.then { |w| @pagy.count == 1 ? w : w + 's' }}"

    - if @logs.any?
      %table.table-academic
        %thead
          %tr
            %th Fecha y hora
            %th= ActivityLog.human_attribute_name(:user)
            %th Tipo
            %th Descripción
            %th IP
        %tbody
          - @logs.each do |log|
            %tr
              %td.celda-fecha
                = log.created_at.strftime("%d/%m/%Y %H:%M")
              %td= log.user.apellidos_y_nombres
              %td
                %span.activity-badge{class: "activity-badge--#{log.action.split('_').last}"}
                  = log.label
              %td= log.message
              %td.dato-menor= log.ip_address || "—"

      .pagy-nav
        != pagy_nav(@pagy)
    - else
      .empty-state
        %h3 Sin registros
        - if params[:usuario_q].present?
          %p No se encontraron usuarios con "#{params[:usuario_q]}"
          %p.nota-ayuda Intente con el nombre completo, número de expediente o correo institucional
        - else
          %p No hay actividad registrada con los filtros seleccionados.
