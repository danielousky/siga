.dashboard-alumno
  .card-academic
    = render layout: "shared/cabecera", locals: { titulo: "Mi panel estudiantil" } do
      .admin-info-badge
        = current_user.first_name
        %span.role-badge= @student.school_card

  -# Lo primero: la nota. Es a lo que entra.
  - if @boletin
    .card-academic
      = render layout: "shared/cabecera", locals: { titulo: "Mis notas de #{@lapso.name.downcase}", nivel: 2 } do
        = boton "Ver el detalle", dashboards_notas_path, icono: :ver, tono: :secondary

      - if @lapsos.many?
        .filter-pills
          - @lapsos.each do |lapso|
            = link_to lapso.name, dashboards_estudiante_path(lapso: lapso.id),
                      class: "filter-pill #{'active' if @lapso == lapso}"

      %ul.ficha-materias
        - @boletin["materias"].each do |fila|
          %li.ficha-materia
            %span.ficha-materia-nombre= fila["materia"]
            - if fila["nota"]
              %span.ficha-nota{class: fila["nota"] >= 10 ? "ficha-nota--aprobada" : "ficha-nota--aplazada"}
                = EscalaLiteral.mostrar(fila["nota"], escala: @inscripcion.section.grade.escala)
            - else
              -# Nunca un cero: quiere decir que el profesor no ha corregido.
              %span.ficha-pendiente Pendiente

      - if @boletin["promedio"]
        %p.ficha-promedio
          Promedio del lapso:
          %strong= EscalaLiteral.mostrar(@boletin["promedio"], escala: @inscripcion.section.grade.escala)

  - if @enrollments.any?
    .card-academic
      = render "shared/cabecera", titulo: pluralizar(@enrollments.size, "Mi sección", "Mis secciones"), nivel: 2

      - @enrollments.each do |enrollment|
        - section = enrollment.section
        .section-block
          .section-block-header
            .section-block-title
              %h3= "#{section.grade.name} – #{section.name}"
              %span.section-period= section.academic_period.name
            .section-block-meta
              -# Decía `.status-pendiente` y se pintaba de verde con un `style`
                inline. Ninguna de las dos clases existe en ninguna hoja.
              %span.estado.estado--al-dia Regular

          - if section.teacher_sections.any?
            .section-subjects
              - section.teacher_sections.each do |ts|
                .subject-tag
                  %span.subject-name= ts.subject.name
                  - if ts.teacher&.user
                    %span.subject-teacher= "· #{ts.teacher.user.last_name}"

          .section-actions
            %span.nota-ayuda
              Inscrito el #{enrollment.enrollment_date.strftime('%d/%m/%Y')}

  - else
    .card-academic
      .empty-state
        %h3 Sin secciones inscritas
        %p No tiene inscripciones activas en este momento. Contacte a la secretaría.
