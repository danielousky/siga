-# El panel del profesor (MOR-135). Ver el controller para el porqué del orden.
.dashboard-profesor
  .card-academic
    = render layout: "shared/cabecera", locals: { titulo: "Panel del profesor" } do
      .admin-info-badge
        = current_user.first_name
        - if @led_sections.any?
          %span.role-badge Profesor guía

  -# Lo primero: lo que le falta corregir, con el enlace a la planilla. El
  -# profesor entra a esto, no a mirar cuántas secciones tiene.
  - if @sin_corregir.any?
    .card-academic
      = render "shared/cabecera", titulo: "Le falta cargar notas", nivel: 2

      %ul.por-corregir
        - @sin_corregir.each do |fila|
          - e = fila.evaluacion
          %li.por-corregir-fila
            .por-corregir-que
              %span.por-corregir-nombre= e.description
              %span.por-corregir-donde
                = "#{e.section.grade.name} – #{e.section.name}"
                %span.ficha-punto ·
                = e.subject.name
            .por-corregir-avance
              -# El avance en letras y no una barra: "12 de 20" dice cuántas
              -# faltan, que es la pregunta. Una barra dice "60 %", que no.
              %span.por-corregir-cuenta= "#{fila.puestas} de #{fila.total}"
              = boton "Cargar notas", evaluation_activity_notas_path(e), icono: :subir, tono: :accion, sm: true

      %p.nota-ayuda
        Se listan las evaluaciones cuya fecha ya pasó y a las que les falta
        alguna nota.

  .card-academic
    = render "shared/cabecera", titulo: "Mis secciones", nivel: 2

    -# ⚠️ Cada área con su AVANCE, y el número enlaza a lo que falta (MOR-223).
    -#
    -# Daniel: *«en el panel de cada sección, además de un enlace al detalle,
    -# hay un indicativo de si les falta por calificar alguna nota… al hacer
    -# clic me voy directamente a la calificación que falta»*.
    -#
    -# El panel decía cuántos alumnos tiene cada sección, que es un dato que no
    -# cambia y que el profesor ya sabe. Lo que cambia cada semana —y lo que lo
    -# trae acá— es cuánto le falta corregir.
    - if @teacher_sections.any?
      - @teacher_sections.group_by(&:section).each do |section, asignaciones|
        .section-block
          .section-block-header
            .section-block-title
              %h3= link_to "#{section.grade.name} – #{section.name}", section_path(section)
              %span.section-period= section.academic_period.name
            .section-block-meta
              %span.section-student-count= contar(section.enrollments.size, "alumno", "alumnos")

          .section-subjects
            - asignaciones.each do |ts|
              - avance = @avances[ts]
              .subject-tag
                %span.subject-name= ts.subject.name
                - if avance && !avance.sin_nada_que_calificar?
                  -# El enlace va a la PRIMERA evaluación incompleta, no al
                  -# listado: el profesor entra a poner las que faltan, no a
                  -# buscar cuál era.
                  - destino = avance.primera_incompleta ? evaluation_activity_notas_path(avance.primera_incompleta) : section_path(section, area: ts.subject_id)
                  = link_to destino, class: "subject-avance subject-avance--#{avance.estado}",
                            data: { tooltip: MenuHelper::NOMBRES_DE_ESTADO[avance.estado] } do
                    - if avance.completo?
                      = icono(:ok, tamano: 13)
                    %span= "#{avance.puestas} de #{avance.total}"
                - else
                  %span.subject-avance.subject-avance--sin_evaluaciones sin evaluaciones

    - else
      .empty-state
        %h3 Sin secciones asignadas
        %p Todavía no tiene secciones asignadas. Hable con el coordinador.

  - if @led_sections.any?
    .card-academic
      = render layout: "shared/cabecera", locals: { titulo: pluralizar(@led_sections.size, "Sección que guía", "Secciones que guía"), nivel: 2 } do
        -# El guía es quien pasa lista, así que el atajo va acá y no en el menú.
        = boton "Pasar lista", asistencias_path, icono: :asistencia, tono: :secondary

      %ul.ficha-secciones
        - @led_sections.each do |seccion|
          %li.ficha-seccion
            = link_to "#{seccion.grade.name} – #{seccion.name}", section_path(seccion), class: "ficha-seccion-nombre"
            -# `contar` y no interpolación a mano: `"alumno" + "s"` está bien,
            -# pero la misma pantalla ya se equivocó con "secciónes".
            %span.ficha-seccion-periodo= contar(seccion.enrollments.size, "alumno", "alumnos")

  .stats-grid
    .stat-card
      %h3= @total_sections
      %p= pluralizar(@total_sections, "sección asignada", "secciones asignadas")

    .stat-card
      %h3= @total_students
      %p= pluralizar(@total_students, "alumno", "alumnos")

    .stat-card
      %h3= @total_subjects
      %p= pluralizar(@total_subjects, "área distinta", "áreas distintas")
