-# El panel del director (MOR-135). Ver el controller para el porqué del orden.
-#
-# Acá vivía el aviso de solicitudes de demo pendientes, y ya no vive en ningún
-# lado de esta app (MOR-133). Se tapó tres veces y volvió a filtrarse tres
-# veces: primero el controller dejaba pasar a cualquier `director`; tapado eso,
-# esta vista seguía diciendo CUÁNTAS había pendientes —el tamaño del pipeline
-# comercial de SIGA—; y el enlace del menú delataba que la sección existía.
-# **Tapar la puerta no alcanza si la pared tiene ventana.**
.dashboard-administrador
  -# Primero lo accionable, y solo si existe. Un panel que siempre dice lo mismo
  -# se deja de leer, y el día que dice otra cosa tampoco se lee.
  - if @pendientes.any?
    .card-academic
      .card-academic-header
        %h2 Para atender

      %ul.pendientes
        - @pendientes.each do |p|
          %li.pendiente
            = link_to p[:ruta], class: "pendiente-enlace" do
              %span.pendiente-numero= p[:cuantas]
              %span.pendiente-que= p[:cuantas] == 1 ? p[:singular] : p[:plural]

  - else
    .card-academic
      .card-academic-header
        %h2 Todo al día
      %p.nota-ayuda
        No hay secciones sin profesor ni alumnos sin representante registrado.

  .card-academic
    .card-academic-header
      %h2 El colegio

    .stats-grid
      .stat-card
        %h3= @total_students
        %p= pluralizar(@total_students, "alumno", "alumnos")

      .stat-card
        %h3= @total_teachers
        %p= pluralizar(@total_teachers, "profesor", "profesores")

      .stat-card
        %h3= @total_sections
        %p= pluralizar(@total_sections, "sección", "secciones")

      .stat-card
        %h3= @total_admins
        %p= pluralizar(@total_admins, "administrador", "administradores")

  - if show_recent_activity?
    .card-academic
      .card-academic-header
        %h2 Últimas inscripciones

      - if @recent_enrollments.any?
        %table.table-academic
          %thead
            %tr
              %th Alumno
              %th Sección
              %th Fecha
          %tbody
            - @recent_enrollments.each do |enrollment|
              %tr
                %td= link_to enrollment.student.user.apellidos_y_nombres, enrollment.student
                %td= "#{enrollment.section.grade.name} – #{enrollment.section.name}"
                %td= l(enrollment.created_at.to_date, format: :long)
      - else
        .empty-state
          %h3 Todavía no hay inscripciones
          %p Cuando se inscriba el primer alumno, aparece acá.
