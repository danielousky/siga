.dashboard-administrador
  .card-academic
    %h2 Estadísticas Institucionales
    .stats-grid
      .stat-card
        %h3= @total_students
        %p Estudiantes Registrados

      .stat-card
        %h3= @total_teachers
        %p Profesores Activos

      .stat-card
        %h3= @total_sections
        %p Secciones Activas

      .stat-card
        %h3= @total_admins
        %p Administradores

  -# Solo la administración de SIGA. Esto decía `desarrollador? || director?` y
  -# quedó fuera de la corrección de /demo_requests: el director de un colegio
  -# cliente seguía viendo **cuántas** solicitudes de demo hay pendientes —el
  -# tamaño del pipeline comercial— y un botón que ahora lo rebota con un alert.
  -#
  -# Cuarto caso del mismo hueco: `demo_requests` no tiene `school_id`, así que
  -# ni SchoolScoped ni el RLS lo alcanzan. Ver MOR-133.
  - if current_user.admin.desarrollador?
    - pending_demos = DemoRequest.pending.count
    - if pending_demos > 0
      .card-academic{style: "background: var(--warning-bg); border-color: var(--warning-border);"}
        %h2{style: "color: var(--warning-text); display: flex; align-items: center; gap: var(--space-sm);"}
          %span ⚠️
          Solicitudes de Demo Pendientes
        %p{style: "color: var(--text-secondary); margin-bottom: var(--space-lg);"}
          = "Tienes #{pending_demos} solicitud#{pending_demos != 1 ? 'es' : ''} de demostración esperando tu atención."
        = link_to "Ver Solicitudes", demo_requests_path, class: "btn btn-primary"

  .card-academic
    %h2 Acceso Rápido a Módulos
    .quick-access-grid
      - if can_manage_students?
        = link_to students_path, class: "quick-access-card" do
          .quick-access-icon
            %span 👨‍🎓
          %h3 Estudiantes
          %p Gestionar registro de estudiantes

      - if can_manage_teachers?
        = link_to teachers_path, class: "quick-access-card" do
          .quick-access-icon
            %span 👨‍🏫
          %h3 Profesores
          %p Gestionar registro de profesores

      - if can_manage_sections?
        = link_to sections_path, class: "quick-access-card" do
          .quick-access-icon
            %span 📚
          %h3 Secciones
          %p Gestionar secciones académicas

      - if can_manage_academic_config?
        = link_to academic_periods_path, class: "quick-access-card" do
          .quick-access-icon
            %span 📅
          %h3 Períodos Académicos
          %p Configurar períodos lectivos

      = link_to subjects_path, class: "quick-access-card" do
        .quick-access-icon
          %span 📖
        %h3 Materias
        %p Catálogo de materias

      = link_to departments_path, class: "quick-access-card" do
        .quick-access-icon
          %span 🏛️
        %h3 Departamentos
        %p Gestionar departamentos académicos

  - if show_recent_activity?
    .card-academic
      %h2 Actividad Reciente
      %table.table-academic
        %thead
          %tr
            %th Estudiante
            %th Sección
            %th Fecha
        %tbody
          - @recent_enrollments.each do |enrollment|
            %tr
              %td= enrollment.student.user.name
              %td= "#{enrollment.section.grade.name} - #{enrollment.section.name}"
              %td= enrollment.created_at.strftime("%d/%m/%Y")
