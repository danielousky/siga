-# El panel del director (MOR-135). Ver el controller para el porqué del orden.
-#
-# Acá vivía el aviso de solicitudes de demo pendientes, y ya no vive en ningún
-# lado de esta app (MOR-133). Se tapó tres veces y volvió a filtrarse tres
-# veces: primero el controller dejaba pasar a cualquier `director`; tapado eso,
-# esta vista seguía diciendo CUÁNTAS había pendientes —el tamaño del pipeline
-# comercial de SIGA—; y el enlace del menú delataba que la sección existía.
-# **Tapar la puerta no alcanza si la pared tiene ventana.**
.dashboard-administrador
  -# ⚠️ Mientras el colegio esté arrancando, el mapa manda: lo demás son ceros y
  -# un panel de ceros no le dice a nadie qué hacer. Cuando lo obligatorio está
  -# listo, el mapa desaparece solo y el panel vuelve a ser lo de siempre.
  - if @en_marcha
    = render "puesta_en_marcha"

  -# Primero lo accionable, y solo si existe. Un panel que siempre dice lo mismo
  -# se deja de leer, y el día que dice otra cosa tampoco se lee.
  - if @pendientes.any?
    .card-academic
      = render "shared/cabecera", titulo: "Para atender", nivel: 2

      %ul.pendientes
        - @pendientes.each do |p|
          %li.pendiente
            = link_to p[:ruta], class: "pendiente-enlace" do
              -# ⚠️ El ámbar acá SÍ va: describe un DATO —hay tres secciones sin
              -# profesor— y no el control. La regla de color prohíbe teñir el
              -# botón, no señalar lo que está pendiente.
              %span.pendiente-alerta= icono(:alerta, tamano: 18)
              %span.pendiente-numero= p[:cuantas]
              %span.pendiente-que= p[:cuantas] == 1 ? p[:singular] : p[:plural]
              %span.pendiente-ir= icono(:siguiente, tamano: 16)

  - else
    .card-academic
      -# ⚠️ El `%h2` estaba VACÍO y el icono y el texto le quedaban de hermanos,
      -# no adentro: los tres al mismo nivel de indentación. O sea que la
      -# pantalla decía «Todo al día» con un `<h2></h2>` vacío al lado, y un
      -# lector de pantalla anunciaba un encabezado sin contenido.
      -# Lo destapó la migración a `shared/cabecera`, al tener que decidir qué
      -# era el título.
      - al_dia = safe_join([ icono(:ok, tamano: 20, clase: "titulo-ok"), "Todo al día" ], " ")
      = render "shared/cabecera", titulo: al_dia, nivel: 2
      %p.nota-ayuda
        No hay secciones sin profesor ni alumnos sin representante registrado.

  .card-academic
    = render "shared/cabecera", titulo: "El colegio", nivel: 2

    -# Cada cifra lleva el icono de SU sección del menú, no uno decorativo: es lo
    -# que enseña dónde se va a buscar eso mismo después.
    .stats-grid
      - [[@total_students, :alumnos, "alumno", "alumnos", students_path],
         [@total_teachers, :profesores, "profesor", "profesores", teachers_path],
         [@total_sections, :secciones, "sección", "secciones", sections_path],
         [@total_admins, :profesores, "administrador", "administradores", admins_path]].each do |cuantos, ico, uno, varios, ruta|
        = link_to ruta, class: "stat-card" do
          %span.stat-card-icono= icono(ico, tamano: 18)
          %h3= cuantos
          %p= pluralizar(cuantos, uno, varios)

  - if show_recent_activity?
    .card-academic
      = render "shared/cabecera", titulo: "Últimas inscripciones", nivel: 2

      - if @recent_enrollments.any?
        %table.table-academic
          %thead
            %tr
              %th Alumno
              %th= Section.model_name.human
              %th Fecha
          %tbody
            - @recent_enrollments.each do |enrollment|
              %tr
                %td= link_to persona_con_avatar(enrollment.student.user), enrollment.student
                %td= "#{enrollment.section.grade.name} – #{enrollment.section.name}"
                %td= l(enrollment.created_at.to_date, format: :long)
      - else
        .empty-state
          %h3 Todavía no hay inscripciones
          %p Cuando se inscriba el primer alumno, aparece acá.
