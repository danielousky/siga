- if @enrollment.nil?
  .card-academic
    = render "shared/cabecera", titulo: "Mis notas"
    .empty-state
      %h3 Sin inscripción activa
      %p No tienes una inscripción vigente. Comunícate con la secretaría del colegio.

- else
  .card-academic
    = render layout: "shared/cabecera", locals: { titulo: "Mis notas" } do
      .admin-info-badge
        = "#{@seccion.grade.name} – #{@seccion.name}"
        %span.role-badge= @seccion.academic_period.name

    .stats-grid
      .stat-card
        %h3= @promedio_general || "—"
        %p= @vista_anual ? "Promedio anual" : "Promedio del lapso"
      .stat-card
        %h3= @materias.count { |m| m.nota_lapso.present? || (@vista_anual && m.libro&.final_score) }
        %p Materias con nota
      .stat-card
        %h3= @pendientes_totales
        %p= @pendientes_totales == 1 ? "Evaluación sin corregir" : "Evaluaciones sin corregir"

    - if @lapsos.many? || @lapsos.any?
      .filter-pills
        - @lapsos.each do |lapso|
          = link_to dashboards_notas_path(lapso: lapso.id), class: "filter-pill #{'active' if @lapso == lapso}" do
            = lapso.name
        = link_to "Año completo", dashboards_notas_path(lapso: "anual"), class: "filter-pill #{'active' if @vista_anual}"

  - if @vista_anual
    .card-academic
      = render "shared/cabecera", titulo: "Calificaciones definitivas"
      %table.table-academic.table-academic--tarjetas
        %thead
          %tr
            %th= Subject.model_name.human
            %th Anual
            %th Reparación
            %th Definitiva
        %tbody
          - @materias.each do |materia|
            %tr
              %td= materia.subject.name
              -# Las notas del AÑO llevan el literal cuando el grado se califica
                 así (MOR-129). La reparación no: es el resultado de un examen,
                 no la calificación del año.
              %td= nota_del_ano(materia.libro&.annual_average, @seccion.grade)
              %td= materia.libro&.remedial_exam_score&.to_i || "—"
              %td
                - definitiva = materia.libro&.final_score&.to_i
                - if definitiva
                  %span.nota-valor{class: definitiva >= 10 ? "nota-valor--aprobada" : "nota-valor--aplazada"}= nota_del_ano(definitiva, @seccion.grade)
                - else
                  %span.nota-pendiente Sin nota
      %p.nota-ayuda
        La definitiva es el promedio de los lapsos. Aprueba con 10.
      -# La tabla de la escala literal se lee UNA vez: quien ya sabe que «B» es
      -# 18–17 no necesita el renglón cada vez que abre sus notas. Y el número va
      -# al lado de la letra, así que la tabla es de repaso, no de traducción.
      - if @seccion.grade.escala_literal?
        = mas_detalle "Qué significa cada letra" do
          %p
            %strong A
            20–19 ·
            %strong B
            18–17 ·
            %strong C
            16–14 ·
            %strong D
            13–10 ·
            %strong E
            por debajo de 10, reprobado.

  - else
    - @materias.each do |materia|
      .card-academic
        = render layout: "shared/cabecera", locals: { titulo: materia.subject.name, nivel: 2 } do
          - if materia.nota_lapso
            .nota-cabecera
              %span.nota-valor{class: materia.nota_lapso >= 10 ? "nota-valor--aprobada" : "nota-valor--aplazada"}= materia.nota_lapso
              - if materia.parcial?
                %span.nota-parcial= "parcial · sobre #{number_with_precision(materia.peso_cargado, precision: materia.peso_cargado.to_d.frac.zero? ? 0 : 2)} % corregido"
          - else
            .nota-cabecera
              %span.nota-pendiente Sin nota todavía

        %table.table-academic.table-academic--tarjetas
          %thead
            %tr
              %th Evaluación
              %th Fecha
              %th Peso
              %th Nota
          %tbody
            - materia.actividades.each do |fila|
              %tr
                %td= fila[:actividad].description
                %td= l(fila[:actividad].date_scheduled, format: :long)
                - peso = fila[:actividad].weight_percentage
                %td= "#{number_with_precision(peso, precision: peso.frac.zero? ? 0 : 2)} %"
                %td
                  - if fila[:nota]
                    %span.nota-valor{class: fila[:nota] >= 10 ? "nota-valor--aprobada" : "nota-valor--aplazada"}= fila[:nota]
                  - else
                    -# NUNCA un cero acá: el profesor todavía no corrigió.
                    %span.nota-pendiente Pendiente

        - if materia.peso_definido < 100
          %p.dato-secundario
            El profesor definió el
            = "#{number_with_precision(materia.peso_definido, precision: materia.peso_definido.frac.zero? ? 0 : 2)} %"
            de este lapso. Falta definir el resto.

    - if @sin_evaluaciones.any?
      .card-academic
        = render "shared/cabecera", titulo: "Todavía sin evaluaciones", nivel: 2
        %p.nota-ayuda
          El profesor no cargó evaluaciones de estas materias para
          = succeed "." do
            = @lapso&.name&.downcase
          No es que estés sin nota: todavía no hay nada que calificar.
        .section-subjects
          - @sin_evaluaciones.each do |materia|
            .subject-tag
              %span.subject-name= materia.subject.name
