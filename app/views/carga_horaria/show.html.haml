-# La carga horaria: cuántas horas a la semana lleva cada área en cada grado
-# (spec `horarios`, tanda 1). Una tabla por nivel, como el mapa de evaluaciones.
-#
-# ⚠️ El punto y la casilla vacía NO son lo mismo. El punto: esa área no se cursa
-# en ese grado. La casilla vacía: se cursa, y nadie dijo cuántas horas.
.card-academic
  = render layout: "shared/cabecera", locals: { titulo: "Horarios", detalle: anio_de_trabajo&.name } do
    - unless @carga.vacio?
      = button_to proponer_carga_horaria_path, class: "btn btn-accion",
                  form: { data: { turbo_confirm: "Se llenan solo las casillas vacías de Media General, con las horas del plan oficial de 2017. Lo que ya está escrito no se toca." } } do
        = icono(:materias, tamano: 16)
        %span Proponer las del plan oficial
  = render "shared/pestanas", pestanas: pestanas_de_horarios(activa: :carga), etiqueta: "Partes del horario"

.card-academic
  - if @carga.vacio?
    = render "shared/lista_vacia", clave: :carga_horaria, titulo: "Todavía no hay áreas por grado",
             texto: "La carga horaria se escribe sobre el pensum: primero cada grado necesita sus áreas de aprendizaje.",
             acciones: [ { texto: "Ir a los grados", ruta: grades_path, icono: :grados } ]

  - else
    - if @errores.present?
      .alert.alert-danger
        %h5 No se guardó nada
        %ul.lista-errores
          - @errores.each do |error|
            %li= error

    %p.nota-ayuda
      Horas a la semana de cada área. El total de cada grado se compara con las
      horas de clase que caben en la semana de su turno.

    %ul.mapa-leyenda
      %li
        %span.carga-horaria-no-se-cursa ·
        esa área no se cursa en ese grado
      %li
        %span.carga-horaria-vacia
        en blanco: se cursa y todavía nadie dijo cuántas horas

    = form_with url: carga_horaria_path, method: :patch do |f|
      - @carga.grupos.each do |grupo|
        %section.mapa-grupo{ "aria-label": GradoOficial.etiqueta(grupo.nivel) }
          .mapa-envoltura
            %table.table-academic.carga-horaria
              %thead
                %tr
                  %th{ scope: "col" }= GradoOficial.etiqueta(grupo.nivel)
                  - grupo.grados.each do |grado|
                    %th{ scope: "col" }= grado.name
              %tbody
                - grupo.areas.each do |area|
                  %tr
                    %th{ scope: "row" }= area.name
                    - grupo.grados.each do |grado|
                      - renglon = grupo.casilla(area, grado)
                      %td
                        - if renglon
                          - valor = @escritas ? @escritas[renglon.id.to_s] : renglon.weekly_hours
                          = number_field_tag "horas[#{renglon.id}]", valor, id: dom_id(renglon, :horas),
                                             class: "form-control carga-horaria-campo",
                                             min: GradeSubject::HORAS_POSIBLES.first, max: GradeSubject::HORAS_POSIBLES.last, step: 1,
                                             aria: { label: "#{area.name} en #{grado.name}: horas a la semana" }
                        - else
                          %span.carga-horaria-no-se-cursa{ "aria-label": "#{area.name} no se cursa en #{grado.name}" } ·
              %tfoot
                %tr.carga-horaria-total
                  %th{ scope: "row" } Total
                  - grupo.grados.each do |grado|
                    %td= @carga.total_de(grado)
                %tr
                  %th{ scope: "row" } La semana tiene
                  - grupo.grados.each do |grado|
                    - semana = @carga.semana_de(grado)
                    %td
                      - if semana
                        = semana
                      - else
                        %span.dato-secundario{ data: { tooltip: "Ninguna sección de #{grado.name} tiene turno todavía" } } —
                - if grupo.grados.any? { |grado| @carga.sobran_en(grado) }
                  %tr
                    %th{ scope: "row" }
                    - grupo.grados.each do |grado|
                      %td
                        - if (sobran = @carga.sobran_en(grado))
                          %span.estado.estado--atencion{ data: { tooltip: "Lo escrito suma #{@carga.total_de(grado)} horas y en la semana de su turno caben #{@carga.semana_de(grado)}" } }
                            = "sobran #{sobran}"

      .form-acciones
        = f.submit "Guardar cambios", class: "btn btn-guardar"
