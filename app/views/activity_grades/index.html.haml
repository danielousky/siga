-# La planilla está pensada MÓVIL PRIMERO: una fila por alumno, en vertical, con
-# el campo grande y teclado numérico. Una grilla de 30 × N en un teléfono no se
-# arregla con overflow-x — se arregla no siendo una grilla.
.card-academic{ data: { controller: "planilla" } }
  = render layout: "shared/cabecera", locals: { titulo: @evaluation_activity.description } do
    -# ⚠️ Vuelve a la LIBRETA de su sección, no a la ficha de la evaluación.
    -#
    -# Daniel: *«el volver de evaluaciones debe llevarlo a
    -# /secciones/ID?area=240»*. Y es la misma idea del resto de la tarde: el
    -# profesor entró desde la columna de su libreta, y devolverlo a la ficha
    -# suelta de la evaluación lo saca de la sección donde estaba trabajando.
    -#
    -# ⚠️ Con el LAPSO también: sin él la libreta abre en el que está en curso,
    -# que en marzo no es el que acaba de calificar.
    - a_la_libreta = section_path(@evaluation_activity.section,
                                  area: @evaluation_activity.subject_id,
                                  lapso: @evaluation_activity.evaluation_moment_id)
    = boton "Volver", a_la_libreta, icono: :volver, tono: :secondary

  %p.carga-contexto
    = "#{@evaluation_activity.section.grade.name} – #{@evaluation_activity.section.name}"
    = "· #{@evaluation_activity.subject.name}"
    = "· #{@evaluation_activity.evaluation_moment.name}"
    -# ⚠️ El PESO se resalta como un chip, no como texto en negrita (QA de
    -# Daniel: «esto un poco más resaltado»). Es el dato que cambia lo que estas
    -# notas significan —el mismo 15 vale distinto en una evaluación del 30 %
    -# que en una del 70 %— y en negrita se perdía dentro de la misma frase que
    -# el grado, la sección y el lapso.
    - peso = @evaluation_activity.weight_percentage
    %span.carga-peso= "#{porcentaje(peso)} del lapso"

  - if lapso_cerrado?
    -# ⚠️ Se dice ARRIBA, antes de escribir. El modelo ya lo impide, pero
    -# descubrirlo nota por nota es aprender el límite a golpes.
    %p.plan-sin-evaluar
      = icono(:alerta, tamano: 15)
      %span
        Control de Estudio cerró #{@evaluation_activity.evaluation_moment.name}: las notas ya no se
        pueden cambiar. Si hay un error, la dirección puede reabrir el lapso.

  = render "shared/progreso_de_la_planilla", hechas: @notas_por_alumno.size,
           total: @inscripciones.size, nombre: "cargadas"

  = render "shared/aviso_de_la_planilla"

  - if @inscripciones.any?
    -# ⚠️ `%ol` y no `%ul`: es una lista ORDENADA —la de la clase, por apellido—
    -# y el lector de pantalla dice «elemento 12 de 30», que es la misma
    -# pregunta que contesta el número a la vista.
    %ol.carga-lista
      - @inscripciones.each_with_index do |inscripcion, i|
        - alumno = inscripcion.student
        - nota   = @notas_por_alumno[alumno.id]
        - promedio = @promedios[inscripcion.id]
        %li.carga-fila{ data: { planilla_target: "fila" } }
          -# ⚠️ El número ANTES de la cara: es el índice de la fila, y va donde
          -# el ojo baja en línea recta buscando «¿por dónde iba?».
          = numero_de_fila(i)
          -# La cara antes que el nombre: en una sección de treinta, el profesor
          -# reconoce al alumno antes de terminar de leer el apellido.
          = avatar(alumno.user, tamano: :chico)
          .carga-alumno
            .carga-alumno-nombre= alumno.user.apellidos_y_nombres
            .carga-alumno-carnet
              = alumno.school_card
              - if promedio
                -# ⚠️ Rojo si va aplazado. Es un DATO —el promedio de este alumno
                -# en este lapso— no un control, así que la regla de color aplica
                -# tal cual: un número en rojo es un niño en problemas.
                %span.carga-promedio{class: ("bajo" if promedio.to_i < 10)}
                  = "· lapso #{number_with_precision(promedio, precision: promedio.frac.zero? ? 0 : 1)}"
          -# ⚠️ Un `<form>` de verdad por fila, y Turbo lo manda.
          -#
          -# Antes era un `fetch` escrito a mano con su CSRF, su `Accept` y su
          -# JSON — treinta líneas por planilla, copiadas, y en una de las
          -# copias faltaba el `Accept`.
          = form_with url: evaluation_activity_nota_path(@evaluation_activity, alumno.id),
                      method: :patch, class: "carga-campo",
                      data: { action: "turbo:submit-start->planilla#enviando turbo:submit-end->planilla#llego turbo:fetch-request-error->planilla#sinRed" } do
            -# ⚠️ `id` PROPIO, y no es cosmético: `number_field_tag` le pondría
            -# `id="score"` a los treinta. Además de ser HTML inválido, Turbo
            -# vuelve a enfocar por `id` tras pintar un stream y
            -# `getElementById` devuelve siempre el primero — el foco saltaba al
            -# alumno siguiente y volvía solo al primero de la lista.
            = number_field_tag :score, nota&.score&.to_i, min: 1, max: 20, step: 1,
                               id: "nota_#{alumno.id}",
                               inputmode: "numeric", placeholder: "—", class: "carga-input",
                               autocomplete: "off",
                               "aria-label": "Nota de #{alumno.user.nombre_completo}",
                               readonly: lapso_cerrado?,
                               data: { planilla_target: "campo",
                                       action: "change->planilla#guardar input->planilla#escribir keydown->planilla#navegar" }
          -# ⚠️ La marca va FUERA del formulario. Adentro, reemplazarla por
          -# stream hace que el navegador devuelva el foco al campo que envió —
          -# medido: el foco viajaba al alumno siguiente y volvía solo doce
          -# milisegundos después de pintar el stream, así que Enter parecía no
          -# hacer nada. Y además es correcto: la marca es de la FILA, no un
          -# campo del formulario.
          = render "shared/estado_de_la_fila", id: "estado_#{alumno.id}",
                   estado: (nota ? :guardado : :vacio)

    %p.carga-ayuda
      Cada nota se guarda al salir del campo. Déjelo
      %strong vacío
      para volver a "sin nota" — que no es lo mismo que un 1.
      %br
      Con
      %kbd Enter
      pasa al alumno siguiente.

  - else
    .empty-state
      %h3 Sin alumnos inscritos
      %p Esta sección no tiene inscripciones todavía.
