-# La bandeja de la oficina (spec: `docs/specs/pagos-de-la-familia.md`).
- content_for :titulo, "Pagos"

= render "shared/cabecera", titulo: "Pagos reportados"

.card-academic
  = render "shared/cabecera", titulo: "Esperando revisión", nivel: 2

  - if @esperando.empty?
    .empty-state
      %h3 No hay nada esperando
      %p Cuando una familia reporte un pago, aparece acá.
  - else
    %table.table-academic
      %thead
        %tr
          %th Alumno
          %th Referencia
          %th Banco
          %th Pagado el
          %th Monto
          %th Reportado
          %th.columna-de-decidir
      %tbody
        - @esperando.each do |reporte|
          %tr
            %td= reporte.por_quienes
            %td= reporte.referencia
            %td= reporte.banco_a_la_vista
            %td= l(reporte.pagado_el, format: :long)
            %td= numero_en_dolares(reporte.monto)
            -# ⚠️ Cuántos días lleva esperando, no la fecha: es lo que dice si
            -# hay una familia bloqueada desde el martes.
            %td
              = "hace #{distance_of_time_in_words_to_now(reporte.created_at)}"
              -# ⚠️ Que se CORRIGIÓ tiene que verse antes de abrirlo.
              -#
              -# El caso que muerde no es que la familia se equivoque: es que la
              -# oficina abra el reporte, se vaya al banco a buscar «0098-7745»,
              -# y mientras tanto la familia lo cambie a «0098-7754». Vuelve,
              -# valida, y validó unos números que nunca leyó.
              - if reporte.corregido?
                %span.dato-secundario= "corregido hace #{distance_of_time_in_words_to_now(reporte.corregido_el)}"
            -# ⚠️ DOS salidas, y la de la izquierda es la que se usa 390 veces.
            -#
            -# Daniel: *«si tiene que revisar 400 vouchers en un día… si lo
            -# comparas contra el banco y ves que todo está ok, no necesitas
            -# revisar»*. La oficina tiene el estado de cuenta del banco
            -# abierto al lado: busca la referencia, la ve, y valida. Abrir el
            -# voucher es para las que NO cuadran.
            -#
            -# ⚠️ Y esta NO pregunta «¿está seguro?». Un diálogo por fila son
            -# 400 clics de más, que es exactamente el trabajo que este botón
            -# viene a quitar. Lo que la hace responsable es que se pueda
            -# DESHACER: ver «Revertir la validación» en la ficha.
            %td.decidir-en-la-fila
              = button_to validar_finanza_path(reporte), method: :patch, class: "btn btn-guardar" do
                = icono(:ok, tamano: 16)
                %span Validar
              = boton "Revisar", finanza_path(reporte), icono: :ver, tono: :ver

- if @en_mora.any?
  .card-academic
    = render "shared/cabecera", titulo: "Quién está en mora", nivel: 2
    %p.nota-ayuda
      Cuotas vencidas y sin reportar. Una familia en mora no ve notas,
      asistencia ni constancias.
    %table.table-academic
      %thead
        %tr
          %th Alumno
          %th Cuota
          %th Venció
          %th Monto
      %tbody
        - @en_mora.each do |cobro|
          %tr
            %td= cobro.enrollment.student.user.apellidos_y_nombres
            %td= cobro.fee&.nombre
            %td.dato-en-mora= l(cobro.vence_el, format: :long)
            %td= numero_en_dolares(cobro.monto)

- if @revisados.any?
  .card-academic
    = render "shared/cabecera", titulo: "Ya revisados", nivel: 2
    %table.table-academic
      %thead
        %tr
          %th Alumno
          %th Referencia
          %th Situación
          %th Quién
          %th.columna-de-decidir
      %tbody
        - @revisados.each do |reporte|
          %tr
            %td= reporte.por_quienes
            %td= link_to reporte.referencia, finanza_path(reporte)
            %td= pastilla_de_reporte(reporte)
            %td= reporte.revisado_por&.apellidos_y_nombres
            -# ⚠️ Un rechazado con sus cuotas libres se valida desde acá: es el
            -# caso de «me equivoqué de fila» y no tiene por qué costar tres
            -# pantallas.
            %td.decidir-en-la-fila
              - if reporte.rechazado? && reporte.se_puede_validar?
                = button_to validar_finanza_path(reporte), method: :patch, class: "btn btn-guardar" do
                  = icono(:ok, tamano: 16)
                  %span Validar
