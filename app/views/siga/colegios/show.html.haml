.siga-bloque-cab
  %h1= @colegio.name
  = button_to "Entrar al colegio", siga_visitas_path, params: { school_id: @colegio.id }, class: "btn btn-accion"
%p.siga-subtitulo
  = @colegio.location
  %span.apagado= "· Código DEA #{@colegio.dea_code}"

.siga-cifras
  .siga-cifra
    %span.siga-cifra-numero= @alumnos
    %span.siga-cifra-que alumnos
  .siga-cifra
    %span.siga-cifra-numero= @profesores
    %span.siga-cifra-que profesores
  .siga-cifra
    %span.siga-cifra-numero= @secciones
    %span.siga-cifra-que secciones

- if flash[:codigo].present?
  %section.siga-bloque
    .siga-bloque-cab
      %h2 El enlace para que el director entre
    .siga-codigo{"data-controller": "copiar"}
      %p.siga-nota
        Se ve una sola vez. Sirve por 72 horas y para un solo uso; si se pierde,
        se genera otro desde la ficha de esa persona.
      %p.mono{"data-copiar-target": "fuente"}= activar_url(flash[:codigo])
      = button_tag "Copiar el enlace", type: "button", class: "btn btn-secondary",
                   "data-action": "copiar#copiar", "data-copiar-target": "boton"

%section.siga-bloque
  .siga-bloque-cab
    %h2 Quién administra
  - if @admins.empty?
    %p.siga-vacio
      Este colegio no tiene ningún administrador. Nadie puede entrar.
  - else
    .siga-tabla-envoltura
      %table.siga-tabla
        %thead
          %tr
            %th Persona
            %th Correo
            %th Rol
            %th Acceso
        %tbody
          - @admins.each do |admin|
            %tr
              %td= admin.user.apellidos_y_nombres
              %td.mono= admin.user.email
              %td.apagado= admin.role.humanize
              %td
                - if admin.user.puede_entrar?
                  %span.siga-estado.siga-estado--activa Activo
                - else
                  %span.siga-estado.siga-estado--cancelada Sin activar

%section.siga-bloque
  .siga-bloque-cab
    %h2 Años escolares
  - if @periodos.empty?
    %p.siga-vacio Sin años escolares cargados.
  - else
    .siga-tabla-envoltura
      %table.siga-tabla
        %thead
          %tr
            %th Año
            %th Desde
            %th Hasta
        %tbody
          - @periodos.each do |periodo|
            %tr
              %td= periodo.name
              %td.apagado= l(periodo.start_date, format: :long)
              %td.apagado= l(periodo.end_date, format: :long)
