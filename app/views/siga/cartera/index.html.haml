%h1 Cartera

.siga-cifras
  .siga-cifra
    %span.siga-cifra-numero= numero_en_dolares(@facturacion)
    %span.siga-cifra-que facturación mensual
  .siga-cifra{class: ("siga-cifra--atencion" if @con_problema.positive?)}
    %span.siga-cifra-numero= @con_problema
    %span.siga-cifra-que= "#{pluralizar(@con_problema, 'colegio', 'colegios')} en solo lectura"
  -# ⚠️ Tiene que ser CERO. Desde el cobro por alumno todo colegio nace con su
  -# suscripción (decisión 16 del spec `del-registro-al-cobro`); un colegio sin
  -# ella es un alta que se saltó `Subscription.abrir_gratis!`.
  .siga-cifra{class: ("siga-cifra--atencion" if @sin_suscripcion.positive?)}
    %span.siga-cifra-numero= @sin_suscripcion
    %span.siga-cifra-que sin suscripción

-# ⚠️ Lo que ESPERA va arriba de todo (§ 5.6 del spec `del-registro-al-cobro`):
-# es lo único de esta pantalla que tiene a un colegio esperando, con la
-# planilla de notas cerrada hasta que alguien lo mire.
-#
-# ⚠️ Los dos números, separados y SIN compararlos: lo que le toca está en
-# dólares y lo que pagó, en la unidad de su medio. El puente —la tasa BCV del
-# día— lo hace quien valida, con el comprobante delante (§ 4.4).
%section.siga-bloque
  .siga-bloque-cab
    %h2 Pagos por validar
  - if @por_validar.empty?
    %p.siga-vacio Ningún pago espera validación.
  - else
    - @por_validar.each do |pago|
      .siga-pago
        .siga-pago-cab
          = link_to pago.school.name, siga_colegio_path(pago.school), class: "siga-pago-colegio"
          %span.apagado= "· reportó #{pago.reportado_por.nombre_completo}, hace #{distance_of_time_in_words_to_now(pago.created_at)}"
        .siga-pago-datos
          %span
            %span.apagado Medio
            = pago.nombre_del_medio
          %span
            %span.apagado Pagó
            %strong= importe_del_pago(pago)
          %span
            %span.apagado Referencia
            %span.mono= pago.referencia.presence || "—"
          %span
            %span.apagado Fecha
            = l(pago.pagado_el, format: :long)
        .siga-pago-datos
          %span
            %span.apagado Le toca
            %strong= numero_en_dolares(pago.cotizacion.monto)
            %span.apagado= "(#{contar(pago.alumnos, 'alumno', 'alumnos')}, #{pago.cotizacion.en_el_minimo? ? 'el mínimo' : "a #{numero_en_dolares(pago.precio_por_alumno)}"})"
          - if pago.comprobante.attached?
            = link_to "Ver el comprobante ↗", url_for(pago.comprobante), target: "_blank", rel: "noopener"
          - else
            %span.apagado Sin comprobante
        - if pago.nota.present?
          %p.siga-nota= "Agregó: #{pago.nota}"
        - if siga_staff.maneja_el_cobro?
          .siga-pago-acciones
            -# Validar abre el sistema al colegio en el momento: un diálogo de
            -# confirmación por pago no es trabajo de más — no hay botón para
            -# deshacerlo.
            = button_to "Validar", validar_siga_pago_path(pago), method: :patch, class: "btn btn-guardar",
                        data: { turbo_confirm: "#{pago.school.name} queda activo por un mes desde hoy o desde que vencía. ¿Validamos?" }
            -# ⚠️ El motivo es obligatorio: el colegio lo lee en su pantalla y en
            -# su correo. Va plegado para que rechazar sea una decisión, no el
            -# botón de al lado de «Validar».
            %details.siga-rechazo
              %summary Rechazar…
              = form_with url: rechazar_siga_pago_path(pago), method: :patch, class: "siga-form-inline" do
                = text_field_tag :motivo, nil, class: "form-control", required: true,
                                 placeholder: "Por qué: el colegio lo va a leer",
                                 id: "motivo_#{pago.id}", "aria-label": "Motivo del rechazo"
                = submit_tag "Rechazar", class: "btn btn-danger"
        - else
          %p.siga-nota Valida el fundador.

- if @revisados.any?
  %section.siga-bloque
    .siga-bloque-cab
      %h2 Lo último que se revisó
    .siga-tabla-envoltura
      %table.siga-tabla
        %thead
          %tr
            %th= School.model_name.human
            %th Pagó
            %th Situación
            %th Revisó
        %tbody
          - @revisados.each do |pago|
            %tr
              %td= link_to pago.school.name, siga_colegio_path(pago.school)
              %td= "#{importe_del_pago(pago)} · #{pago.nombre_del_medio}"
              %td
                - if pago.validado?
                  %span.siga-estado.siga-estado--activa Validado
                  - if pago.cubre_desde
                    %span.apagado= "del #{l(pago.cubre_desde, format: :short)} al #{l(pago.cubre_hasta, format: :short)}"
                - else
                  %span.siga-estado.siga-estado--cancelada Rechazado
                  %span.apagado= pago.motivo
              %td.apagado
                = pago.revisado_por&.first_name
                = l(pago.revisado_el.to_date, format: :short) if pago.revisado_el

%p.siga-nota
  Al vencer, un colegio pasa a
  %strong solo lectura
  — nunca se le corta el acceso. Cortárselo a mitad de año escolar es quitarle
  las notas de sus alumnos: se gana la disputa de cobranza y se pierde el
  cliente, más su reputación en una red de 3.900 colegios que se conocen entre
  sí. Sigue viendo y descargando todo; lo que no puede es cargar nada nuevo.

%section.siga-bloque
  .siga-bloque-cab
    %h2 Colegio por colegio
  .siga-tabla-envoltura
    %table.siga-tabla
      %thead
        %tr
          %th= School.model_name.human
          %th.num Matrícula
          %th Suscripción
          %th.num Al mes
          %th Estado
          %th Vence
      %tbody
        - @colegios.each do |colegio|
          - s = @suscripciones[colegio.id]
          - cotizacion = @cotizaciones[colegio.id]
          %tr
            %td= link_to colegio.name, siga_colegio_path(colegio)
            %td.num= @matriculas[colegio.id] || 0
            %td
              - if s
                = s.etiqueta_de_plan
                - if s.por_alumno?
                  %span.apagado= "· #{numero_en_dolares(cotizacion.por_alumno)}"
              - else
                %span.apagado —
            -# ⚠️ Lo que le tocaría HOY, con su matrícula de hoy y su precio
            -# congelado. Al gratis, lo que pagaría si activara: es el número que
            -# se le dice por teléfono.
            %td.num= numero_en_dolares(cotizacion.monto)
            %td
              - if s
                %span.siga-estado{class: "siga-estado--#{s.status}"}= s.etiqueta_de_estado
              - else
                %span.apagado Sin suscripción
            %td.apagado
              - if s&.vigente_hasta
                = l(s.vigente_hasta, format: :short)
                - dias = s.dias_para_vencer
                - if dias && dias.negative?
                  %br
                  %span.siga-desfase= "hace #{-dias} días"
              - else
                —

%p.siga-nota
  El precio se
  %strong observa
  siempre y se
  %strong cobra
  al renovar, cada mes: que un colegio crezca a mitad de mes no cambia lo que
  ya pagó. La columna dice lo que le toca hoy, con la matrícula de hoy y el
  precio con que entró.
