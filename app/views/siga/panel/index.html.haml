%h1 Panel de la plataforma

.siga-cifras
  .siga-cifra
    %span.siga-cifra-numero= @colegios.size
    %span.siga-cifra-que= pluralizar(@colegios.size, "colegio", "colegios")
  .siga-cifra
    %span.siga-cifra-numero= number_with_delimiter(@total_alumnos)
    %span.siga-cifra-que alumnos en total
  .siga-cifra{class: ("siga-cifra--atencion" if @solicitudes_pendientes.positive?)}
    %span.siga-cifra-numero= @solicitudes_pendientes
    %span.siga-cifra-que= "#{pluralizar(@solicitudes_pendientes, 'solicitud', 'solicitudes')} sin responder"

%section.siga-bloque
  .siga-bloque-cab
    %h2 Colegios
    -# El `if` va como bloque: como modificador se lleva el `do` y `link_to`
    -# toma la ruta como texto del enlace. Ver `siga/colegios/index`.
    - if siga_staff.puede_dar_de_alta_colegios?
      = boton "Dar de alta", new_siga_colegio_path, icono: :agregar, tono: :guardar

  - if @colegios.empty?
    %p.siga-vacio Todavía no hay ningún colegio en la plataforma.
  - else
    .siga-tabla-envoltura
      %table.siga-tabla
        %thead
          %tr
            %th= School.model_name.human
            %th Ubicación
            %th.num Alumnos
            %th.num Profesores
            %th.num Secciones
            %th.num Le tocaría al mes
        %tbody
          - @colegios.each do |colegio|
            - alumnos = @alumnos_por_colegio[colegio.id] || 0
            %tr
              %td= link_to colegio.name, siga_colegio_path(colegio)
              %td.apagado= colegio.location
              %td.num= alumnos
              %td.num= @profesores_por_colegio[colegio.id] || 0
              %td.num= @secciones_por_colegio[colegio.id] || 0
              %td.num= numero_en_dolares(Subscription.cotizar(alumnos).total)

    -# ⚠️ El precio NO va escrito a mano. Esta nota decía «$25 · $50 · $90» el 5
    -# de octubre de 2026, dos subidas después: era la última copia de los
    -# precios que quedaba fuera de la constante. Lo cuida
    -# `los_precios_de_un_solo_lugar_test`.
    - por_alumno = numero_en_dolares(Subscription::PRECIO_POR_ALUMNO)
    - minimo     = numero_en_dolares(Subscription::MINIMO_MENSUAL)
    %p.siga-nota
      = "Sale de la matrícula: #{por_alumno} por alumno al mes, más IVA, con un mínimo de #{minimo}."
      Es lo que le tocaría hoy, no lo que paga: eso está en la
      = succeed "." do
        = link_to "Cartera", siga_cartera_index_path

%section.siga-bloque
  .siga-bloque-cab
    %h2 Lo último que pasó
  - if @actividad.empty?
    %p.siga-vacio Sin actividad registrada.
  - else
    .siga-tabla-envoltura
      %table.siga-tabla
        %thead
          %tr
            %th Cuándo
            %th= School.model_name.human
            %th Qué
        %tbody
          - @actividad.each do |registro|
            %tr
              %td.apagado= l(registro.created_at, format: :short)
              %td.apagado= registro.school&.name || "—"
              %td= registro.message
