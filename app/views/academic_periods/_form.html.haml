= form_with(model: academic_period, class: "mb-3") do |f|
  = render "shared/errors", object: academic_period

  .mb-3
    = f.label :name, "Nombre", class: "form-label"
    = f.text_field :name, class: "form-control"

  -# El colegio NO se elige: sale de la sesión (Current.school). Un selector acá
  -# lista los colegios de toda la plataforma y deja que el id venga del request,
  -# que es justo de donde el inquilino nunca puede venir (MOR-86).

  .mb-3
    = f.label :start_date, "Fecha Inicio", class: "form-label"
    = f.date_field :start_date, class: "form-control"

  .mb-3
    = f.label :end_date, "Fecha Fin", class: "form-label"
    = f.date_field :end_date, class: "form-control"

  = f.submit class: "btn btn-primary"
