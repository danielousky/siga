.card-academic
  .card-academic-header
    %h1 Años escolares
    = link_to new_academic_period_path, class: "btn btn-primary" do
      = icono(:agregar, tamano: 16)
      %span Registrar año escolar

  - if @academic_periods.empty?
    = render "shared/lista_vacia", clave: :ano_escolar,
             acciones: [ { texto: "Registrar año escolar", ruta: new_academic_period_path, icono: :agregar } ]
  - else
    %table.table-academic
      %thead
        %tr
          %th= AcademicPeriod.human_attribute_name(:name)
          %th Fecha inicio
          %th Fecha fin
          %th= Section.model_name.human(count: 2)
      %tbody
        - @academic_periods.each do |period|
          %tr
            %td= link_to period.name, edit_academic_period_path(period)
            %td= l(period.start_date, format: :long)
            %td= l(period.end_date, format: :long)
            -# ⚠️ Cuántas secciones tiene, y el atajo para traerlas si no tiene.
            -#
            -# Un año escolar recién creado está vacío, y armar diez secciones
            -# con ochenta asignaciones a mano es la clase de trabajo que hace
            -# que un colegio no renueve (MOR-166). El atajo va acá porque es
            -# donde el director está parado cuando acaba de crear el año.
            - cuantas = Section.where(academic_period_id: period.id).count
            -# ⚠️ Un BOTÓN, no un enlace de texto (QA de Daniel: «el botón de clonar
            -# debemos resaltarlo más, hacerlo más evidente; de casualidad lo
            -# vi»). Es la acción más valiosa de la pantalla —ahorra ochenta
            -# asignaciones escritas a mano— y estaba pintada como el resto del
            -# texto de la tabla.
            -#
            -# Y es el ÚNICO botón primario de la fila: el año que ya tiene
            -# secciones muestra el conteo, no una acción.
            %td.anio-acciones
              - if cuantas.zero?
                = link_to copiar_al_academic_period_path(period), class: "btn btn-accion btn-sm" do
                  = icono(:calendario, tamano: 14)
                  %span Copiar de otro año
              - else
                = contar(cuantas, "sección", "secciones")
                -# Con secciones y sin alumnos, lo que falta es promover: es el
                -# paso 3 de septiembre y el que deja el año listo para trabajar.
                - inscritos = Enrollment.where(section: Section.where(academic_period_id: period.id)).count
                - if inscritos.zero?
                  = link_to promover_al_academic_period_path(period), class: "btn btn-accion btn-sm" do
                    = icono(:alumnos, tamano: 14)
                    %span Promover alumnos
                - else
                  %span.dato-secundario= "· #{contar(inscritos, 'alumno', 'alumnos')}"
