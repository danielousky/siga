.card-academic
  .card-academic-header
    %h1 Períodos académicos
    = link_to new_academic_period_path, class: "btn btn-primary" do
      = icono(:agregar, tamano: 16)
      %span Nuevo período

  %table.table-academic
    %thead
      %tr
        %th= AcademicPeriod.human_attribute_name(:name)
        %th Fecha inicio
        %th Fecha fin
    %tbody
      - @academic_periods.each do |period|
        %tr
          %td= link_to period.name, edit_academic_period_path(period)
          %td= period.start_date.strftime("%d/%m/%Y")
          %td= period.end_date.strftime("%d/%m/%Y")
