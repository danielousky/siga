.card-academic
  .card-academic-header
    %h1 Períodos académicos
    = link_to "Nuevo período", new_academic_period_path, class: "btn btn-primary"

  %table.table-academic
    %thead
      %tr
        %th Nombre
        %th Fecha inicio
        %th Fecha fin
        %th Acciones
    %tbody
      - @academic_periods.each do |period|
        %tr
          %td= period.name
          %td= period.start_date.strftime("%d/%m/%Y")
          %td= period.end_date.strftime("%d/%m/%Y")
          %td
            .actions-group
              = link_to "Editar", edit_academic_period_path(period), class: "btn btn-secondary btn-sm"
