.card-academic
  .card-academic-header
    %h1 Períodos Académicos
    = link_to "Nuevo Período", new_academic_period_path, class: "btn btn-primary"

  %table.table-academic
    %thead
      %tr
        %th Nombre
        %th Escuela
        %th Fecha Inicio
        %th Fecha Fin
        %th Acciones
    %tbody
      - @academic_periods.each do |period|
        %tr
          %td= period.name
          %td= period.school.name
          %td= period.start_date.strftime("%d/%m/%Y")
          %td= period.end_date.strftime("%d/%m/%Y")
          %td
            .actions-group
              = link_to "Ver", period, class: "btn btn-secondary btn-sm"
              = link_to "Editar", edit_academic_period_path(period), class: "btn btn-secondary btn-sm"
              = link_to "Eliminar", period, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar este período?" }, class: "btn btn-danger btn-sm"

  .pagy-nav
    != pagy_nav(@pagy)
