%h1= @academic_period.name

.card
  .card-body
    %dl.row
      %dt.col-sm-3 Nombre
      %dd.col-sm-9= @academic_period.name
      %dt.col-sm-3 Fecha Inicio
      %dd.col-sm-9= l(@academic_period.start_date, format: :long) rescue @academic_period.start_date
      %dt.col-sm-3 Fecha Fin
      %dd.col-sm-9= l(@academic_period.end_date, format: :long) rescue @academic_period.end_date

.mt-3
  = link_to "Editar", edit_academic_period_path(@academic_period), class: "btn btn-outline-secondary"
  = link_to "Volver", academic_periods_path, class: "btn btn-outline-primary"
  = link_to "Eliminar", @academic_period, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-outline-danger"
