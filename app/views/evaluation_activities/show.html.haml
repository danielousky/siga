.card-academic
  .card-academic-header
    %h1= @evaluation_activity.description
    = boton "Volver", evaluation_activities_path, icono: :volver, tono: :secondary

  .detail-row
    .detail-item
      .detail-label Sección
      .detail-value= "#{@evaluation_activity.section.grade.name} – #{@evaluation_activity.section.name}"
    .detail-item
      .detail-label Materia
      .detail-value= @evaluation_activity.subject.name

  .detail-row
    .detail-item
      .detail-label Lapso
      .detail-value= "#{@evaluation_activity.evaluation_moment.name} · #{@evaluation_activity.section.academic_period.name}"
    .detail-item
      .detail-label Fecha
      .detail-value= l(@evaluation_activity.date_scheduled, format: :long)

  .detail-row
    .detail-item
      .detail-label Peso dentro del lapso
      - peso = @evaluation_activity.weight_percentage
      .detail-value= "#{number_with_precision(peso, precision: peso.frac.zero? ? 0 : 2)} %"
    .detail-item
      .detail-label Notas cargadas
      .detail-value= "#{@notas_cargadas} de #{@inscritos} inscritos"

  - if profesor?
    .section-actions
      = boton "Cargar notas", evaluation_activity_notas_path(@evaluation_activity), icono: :subir
      = boton "Editar", edit_evaluation_activity_path(@evaluation_activity), icono: :editar, tono: :secondary
