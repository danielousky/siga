- if @grupos.any?
  .card-academic
    .card-academic-header
      %h1 Evaluaciones

    %p.weight-meter-intro
      Cada lapso de una materia tiene que cerrar en 100 %. Lo que falta todavía no
      se le descuenta a nadie: el promedio se calcula sobre lo cargado.

    - @grupos.each do |grupo|
      .weight-meter
        .weight-meter-label
          %strong= "#{grupo[:seccion].grade.name} – #{grupo[:seccion].name}"
          = "· #{grupo[:materia].name} · #{grupo[:lapso].name}"
        .weight-meter-bar
          - usado = grupo[:usado].to_f
          .weight-meter-fill{class: ("weight-meter-fill--completo" if usado >= 100), style: "width: #{[usado, 100].min}%"}
        .weight-meter-value
          = "#{number_with_precision(usado, precision: usado.to_d.frac.zero? ? 0 : 2)} %"
          - if usado < 100
            %span.weight-meter-falta= "· Faltan #{number_with_precision(100 - usado, precision: (100 - usado).to_d.frac.zero? ? 0 : 2)} %"

-# ⚠️ El alta la ve SOLO el profesor: una evaluación la crea quien la va a
-# calificar. La cabecera acepta que no haya `alta:` y no dibuja el botón.
- alta = ({ ruta: new_evaluation_activity_path, nombre: "Registrar evaluación" } if profesor?)
= render "shared/cabecera_de_lista",
         titulo: (profesor? ? "Mis Evaluaciones" : "Evaluaciones del Colegio"),
         alta: alta

.card-academic
  - if @lapsos_disponibles.many?
    .filter-pills
      = link_to "Todos los lapsos", evaluation_activities_path, class: "filter-pill #{'active' unless @lapso_filtrado}"
      - @lapsos_disponibles.each do |lapso|
        = link_to evaluation_activities_path(lapso: lapso.id), class: "filter-pill #{'active' if @lapso_filtrado == lapso}" do
          = lapso.name
          %small= " · #{lapso.academic_period.name}"

  - if @evaluation_activities.any?
    %table.table-academic
      %thead
        %tr
          %th= EvaluationActivity.human_attribute_name(:section)
          %th= EvaluationActivity.human_attribute_name(:subject)
          %th= EvaluationActivity.human_attribute_name(:evaluation_moment)
          %th Evaluación
          %th Peso
          %th Fecha
          %th
      %tbody
        - @evaluation_activities.each do |actividad|
          %tr
            %td= "#{actividad.section.grade.name} – #{actividad.section.name}"
            %td= actividad.subject.name
            %td= actividad.evaluation_moment.name
            %td= link_to actividad.description, actividad
            %td= "#{number_with_precision(actividad.weight_percentage, precision: actividad.weight_percentage.frac.zero? ? 0 : 2)} %"
            %td= l(actividad.date_scheduled, format: :long)
            -# Se queda SOLO la acción principal del profesor. "Ver" y "Editar"
              se fueron a la ficha, adonde ahora lleva el nombre de la
              evaluación: cargar notas es lo que se hace todas las semanas, y
              no se llega a ella desde ningún otro lado en un paso.
            %td
              - if profesor?
                = boton "Cargar notas", evaluation_activity_notas_path(actividad), icono: :subir, sm: true

  - else
    -# ⚠️ Esta pantalla se quedaba EN BLANCO (MOR-204).
    -#
    -# Daniel: *«Evaluaciones está en blanco; entiendo que es porque no hay año
    -# escolar ni nada, pero debería haber un mensaje indicativo como el resto de
    -# las vistas en la misma condición»*.
    -#
    -# Y se escapó del test que cuida justamente eso —«ningún listado vacío deja
    -# una tabla con encabezados y nada debajo»— porque acá no quedaba ni la
    -# tabla: el `- if …any?` no tenía `- else`, así que la tarjeta salía sin una
    -# sola palabra adentro. Un vacío con encabezados al menos se ve raro; uno
    -# totalmente en blanco se lee como una pantalla rota.
    -#
    -# Las precondiciones se dicen EN ORDEN y una sola: decirle a alguien que le
    -# faltan tres cosas a la vez no le dice cuál hacer primero.
    -# ⚠️ Una línea por condición: Haml lee la continuación de un `if` de varias
    -# líneas como indentación y revienta con «indented 5 levels deeper».
    - falta = nil
    - falta ||= :ano_escolar unless AcademicPeriod.exists? && EvaluationMoment.exists?
    - falta ||= :secciones unless Section.exists?
    - falta ||= :materias unless TeacherSection.exists?

    - if falta
      - paso = PasosDeArranque.paso(Current.school, falta)
      .card-academic
        .empty-state
          %h3 Todavía no se puede evaluar
          %p
            Antes hace falta
            %strong= paso.titulo.downcase
            \: una evaluación cuelga de un lapso, de una sección y de quien la dicta.
          = boton paso.verbo, "#{ruta_del_paso(paso)}?recorrido=#{paso.clave}", icono: paso.icono
    - else
      .card-academic
        = render "shared/lista_vacia", clave: :evaluaciones,
                 titulo: (profesor? ? "Todavía no ha creado ninguna evaluación" : "Todavía no hay evaluaciones cargadas"),
                 texto: "Una evaluación es cada examen, taller o trabajo con su peso. Los pesos de un lapso tienen que cerrar en 100 %.",
                 acciones: (profesor? ? [ { texto: "Agregar", ruta: new_evaluation_activity_path, icono: :agregar } ] : [])
