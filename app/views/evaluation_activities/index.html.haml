-# «Evaluaciones»: el MAPA de los planes del colegio en un lapso, para la
-# dirección (`MapaDeEvaluaciones`).
-#
-#     Lapso  [1er Lapso] 2do Lapso 3er Lapso
-#     EDUCACIÓN PRIMARIA   CNA  CSO  EDF  EST  ING  LEN  MAT
-#     1er Grado A           ✓    ✓   70   70    ✓    ✓    ✓
-#     2do Grado A           ✓    ✓    ✓    ✓    ·    ✓    ✓
-#
-# Daniel, el 13 de octubre de 2026, mirando 588 barras casi todas en 100 %:
-# *«debe haber una mejor manera de mostrarlo»*. Eligió este dibujo entre tres:
-# el colegio entero en una pantalla, y lo que falta salta a la vista porque
-# rompe el patrón de las casillas completas.
-#
-# ⚠️ Cada casilla ABRE el plan de esa sección y esa área, en ese lapso: es ahí
-# donde están las evaluaciones. Por eso la tabla con cada evaluación del
-# colegio, paginada de a veinte, se retiró: listaba lo que la casilla ya abre.
-#
-# ⚠️ Los códigos de las áreas se explican DEBAJO de cada tabla, y no con un
-# tooltip en el encabezado: dentro de `.table-academic` el tooltip sale hacia
-# arriba, y el del encabezado quedaría recortado por el borde de la tabla.
-# Tampoco hay tooltip en un teléfono.
-#
-# ⚠️ El PROFESOR con secciones no llega aquí: va a calificar la primera. Lo
-# que ve sin mapa es quien todavía no dicta nada, y para él va el vacío.
- alta = ({ ruta: new_evaluation_activity_path, nombre: "Registrar evaluación" } if profesor?)
.card-academic
  = render "shared/cabecera",
           titulo: (profesor? ? "Mis Evaluaciones" : "Evaluaciones del colegio"),
           alta: alta

  - if @mapa && !@mapa.vacio?
    - if @lapsos.many?
      = render "shared/pastillas", etiqueta: "Lapso",
               opciones: @lapsos.map { |lapso| [ lapso.name, evaluation_activities_path(lapso: lapso.id), lapso == @lapso ] }

    %p.nota-ayuda
      Cada casilla es el plan de un área en una sección, y tiene que cerrar en
      100 %. Tóquela para abrirlo.

    %ul.mapa-leyenda
      %li
        %span.mapa-marca.mapa-marca--completa ✓
        cerró en 100 %
      %li
        %span.mapa-marca.mapa-marca--a-medias 70
        lleva 70 %
      %li
        %span.mapa-marca.mapa-marca--vacia ·
        sin evaluaciones
      %li
        %span.mapa-marca
        en blanco: esa área no se dicta en esa sección

    - @mapa.grupos.each do |grupo|
      %section.mapa-grupo{ "aria-label": GradoOficial.etiqueta(grupo.nivel) }
        -# ⚠️ En su propia caja con scroll: la Media lleva catorce áreas y, con
        -# el menú abierto, a 1024 px la tabla empujaba la página entera de lado.
        .mapa-envoltura
          %table.table-academic.mapa-de-evaluaciones
            %thead
              %tr
                %th{ scope: "col" }= GradoOficial.etiqueta(grupo.nivel)
                - grupo.areas.each do |area|
                  %th{ scope: "col" }= area.code
            %tbody
              - grupo.filas.each do |seccion, casillas|
                %tr
                  %th.mapa-seccion{ scope: "row" }= "#{seccion.grade.name} #{seccion.name}"
                  - grupo.areas.each do |area|
                    - casilla = casillas[area.id]
                    %td
                      - if casilla
                        - estado = if casilla.completa? then "completa" elsif casilla.sin_evaluaciones? then "vacia" else "a-medias" end
                        - lleva = casilla.completa? ? "cerró en 100 %" : (casilla.sin_evaluaciones? ? "sin evaluaciones" : "lleva #{porcentaje(casilla.peso)}")
                        - quien = casilla.profesor&.user&.apellidos_y_nombres || "sin profesor asignado"
                        = link_to planificar_section_path(seccion, area: area.id, lapso: @mapa.lapso.id),
                                  class: "mapa-marca mapa-marca--#{estado}",
                                  data: { tooltip: "#{area.name} · #{quien} · #{lleva}" },
                                  "aria-label": "#{area.name} en #{seccion.grade.name} #{seccion.name}: #{lleva}" do
                          - if casilla.completa?
                            ✓
                          - elsif casilla.sin_evaluaciones?
                            ·
                          - else
                            = casilla.peso.round
        %p.mapa-areas
          = safe_join(grupo.areas.map { |area| safe_join([ tag.strong(area.code), " ", area.name ]) }, " · ")

  - else
    -# ⚠️ Esta pantalla se quedaba EN BLANCO (MOR-204).
    -#
    -# Daniel: *«Evaluaciones está en blanco; entiendo que es porque no hay año
    -# escolar ni nada, pero debería haber un mensaje indicativo como el resto de
    -# las vistas en la misma condición»*.
    -#
    -# Las precondiciones se dicen EN ORDEN y una sola: decirle a alguien que le
    -# faltan tres cosas a la vez no le dice cuál hacer primero.
    -# ⚠️ Una línea por condición: Haml lee la continuación de un `if` de varias
    -# líneas como indentación y revienta con «indented 5 levels deeper».
    - falta = nil
    - falta ||= :ano_escolar unless AcademicPeriod.exists? && EvaluationMoment.exists?
    - falta ||= :secciones unless Section.exists?
    - falta ||= :materias unless TeacherSection.exists?

    - if falta
      - paso = PasosDeArranque.paso(Current.school, falta)
      .empty-state
        %h3 Todavía no se puede evaluar
        %p
          Antes hace falta
          %strong= paso.titulo.downcase
          \: una evaluación cuelga de un lapso, de una sección y de quien la dicta.
        = boton paso.verbo, ruta_del_paso(paso, recorrido: true), icono: paso.icono, tono: :guardar
    - else
      = render "shared/lista_vacia", clave: :evaluaciones,
               titulo: (profesor? ? "Todavía no ha creado ninguna evaluación" : "Todavía no hay evaluaciones cargadas"),
               texto: "Una evaluación es cada examen, taller o trabajo con su peso. Los pesos de un lapso tienen que cerrar en 100 %.",
               acciones: (profesor? ? [ { texto: "Agregar", ruta: new_evaluation_activity_path, icono: :agregar } ] : [])
