= form_with(model: enrollment) do |f|
  = render "shared/errors", object: enrollment

  .form-group
    = f.label :student_id, "Estudiante", class: "form-label"
    = f.select :student_id, Student.includes(:user).map { |s| ["#{s.user.nombre_completo} (#{s.user.document})", s.user_id] }, { include_blank: "Seleccione..." }, class: "form-select"

  .form-group
    = f.label :section_id, "Sección", class: "form-label"
    = f.select :section_id, Section.includes(:grade, :academic_period).map { |s| ["#{s.grade.name} - #{s.name} (#{s.academic_period.name})", s.id] }, { include_blank: "Seleccione..." }, class: "form-select"

  .form-group
    = f.label :enrollment_date, "Fecha de inscripción", class: "form-label"
    = f.date_field :enrollment_date, class: "form-control"

  .form-group
    = f.label :status, "Estado", class: "form-label"
    = f.select :status, Enrollment.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "form-select"

  .form-acciones
    = f.submit class: "btn btn-primary"
    - if local_assigns[:volver]
      = link_to volver, class: "btn btn-secondary" do
        = icono(:volver, tamano: 16)
        %span Volver
