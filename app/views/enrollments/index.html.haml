.card-academic
  .card-academic-header
    %h1 Inscripciones
    = link_to "Nueva Inscripción", new_enrollment_path, class: "btn btn-primary"

= render "shared/search_filter",
    url:      enrollments_path,
    frame_id: "enrollments-results",
    clear_url: enrollments_path,
    fields: [
      { type: :text,   name: :q,        label: "Estudiante", placeholder: "Nombre, apellido o cédula...", flex: 2 },
      { type: :select, name: :grade_id, label: "Grado",      options: @grades_options }
    ]

= turbo_frame_tag "enrollments-results" do
  .card-academic
    %table.table-academic
      %thead
        %tr
          %th Estudiante
          %th Sección
          %th Grado
          %th Fecha de Inscripción
          %th Estado
          %th Acciones
      %tbody
        - @enrollments.each do |enrollment|
          %tr
            %td= "#{enrollment.student.user.last_name}, #{enrollment.student.user.name}"
            %td= enrollment.section.name
            %td= enrollment.section.grade.name
            %td= enrollment.enrollment_date.strftime("%d/%m/%Y")
            %td
              %span.role-badge{style: enrollment.regular? ? "" : "background: #f57f17; border-color: #f57f17;"}
                = enrollment.regular? ? "Regular" : enrollment.status.humanize
            %td
              .actions-group
                = link_to "Ver", enrollment, class: "btn btn-secondary btn-sm"
                = link_to "Editar", edit_enrollment_path(enrollment), class: "btn btn-secondary btn-sm"
                = link_to "Eliminar", enrollment, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar esta inscripción?" }, class: "btn btn-danger btn-sm"

    .pagy-nav
      != pagy_nav(@pagy)
