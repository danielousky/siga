%h1 Inscripciones

= link_to "Nueva Inscripción", new_enrollment_path, class: "btn btn-primary mb-3"

%table.table.table-striped.table-hover
  %thead
    %tr
      %th Estudiante
      %th Sección
      %th Grado
      %th Fecha Inscripción
      %th Estado
      %th Acciones
  %tbody
    - @enrollments.each do |enrollment|
      %tr
        %td= "#{enrollment.student.user.name} #{enrollment.student.user.last_name}"
        %td= enrollment.section.name
        %td= enrollment.section.grade.name
        %td= enrollment.enrollment_date
        %td
          %span.badge{class: enrollment.regular? ? "bg-success" : "bg-warning"}= enrollment.status.humanize
        %td
          = link_to "Ver", enrollment, class: "btn btn-sm btn-outline-primary"
          = link_to "Editar", edit_enrollment_path(enrollment), class: "btn btn-sm btn-outline-secondary"
          = link_to "Eliminar", enrollment, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-sm btn-outline-danger"

!= pagy_bootstrap_nav(@pagy)
