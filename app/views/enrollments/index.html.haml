.card-academic
  .card-academic-header
    %h1 Inscripciones
    = link_to "Nueva inscripción", new_enrollment_path, class: "btn btn-primary"

- enrollment_fields = []
- enrollment_fields << { type: :text,   name: :q,        label: "Estudiante", placeholder: "Nombre, apellido o cédula...", flex: 2 }
- enrollment_fields << { type: :select, name: :grade_id, label: "Grado",      options: @grades_options }
= render "shared/search_filter", url: enrollments_path, frame_id: "enrollments-results", clear_url: enrollments_path, fields: enrollment_fields

-# `target: "_top"` no es un detalle: sin él, TODO enlace de adentro del frame
-# —Ver, Editar, Eliminar— navega DENTRO del frame. Y como ninguna de esas
-# páginas contiene un frame con este id, Turbo pinta «Content missing» en vez
-# del detalle del alumno. Un botón que no lleva a ningún lado.
-#
-# El buscador sigue actualizando el frame porque declara su destino explícito
-# (`data: { turbo_frame: … }` en shared/_search_filter), y eso le gana al
-# `target` del frame.
= turbo_frame_tag "enrollments-results", target: "_top" do
  .card-academic
    %table.table-academic
      %thead
        %tr
          %th Estudiante
          %th Sección
          %th Grado
          %th Fecha de inscripción
          %th Estado
          %th Acciones
      %tbody
        - @enrollments.each do |enrollment|
          %tr
            %td= "#{enrollment.student.user.last_name}, #{enrollment.student.user.name}"
            %td= enrollment.section.name
            %td= enrollment.section.grade.name
            %td= enrollment.enrollment_date.strftime("%d/%m/%Y")
            %td
              %span.role-badge{style: enrollment.regular? ? "" : "background: #f57f17; border-color: #f57f17;"}
                = enrollment.regular? ? "Regular" : enrollment.status.humanize
            %td
              .actions-group
                = link_to "Editar", edit_enrollment_path(enrollment), class: "btn btn-secondary btn-sm"
