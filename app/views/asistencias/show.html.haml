-# La toma de asistencia (MOR-111).
-#
-# Un minuto para treinta alumnos. Todos presentes por defecto; se tocan las
-# excepciones, que la mayoría de los días son dos o tres.
.card-academic{data: {controller: "asistencia",
                      asistencia_url_value: seccion_asistencia_path(@seccion),
                      asistencia_dia_value: @dia.to_s,
                      asistencia_total_value: @inscripciones.size}}
  = render layout: "shared/cabecera", locals: { titulo: "Asistencia" } do
    .admin-info-badge
      = "#{@seccion.grade.name} – #{@seccion.name}"
      %span.role-badge= l(@dia, format: :long)

  -# Van también acá porque `index` redirige derecho a esta pantalla cuando el
  -# profesor tiene una sola sección: sin esto, un guía nunca vería la pestaña de
  -# Inasistencias. Ver `pestanas_de_asistencia`.
  = render "shared/pestanas", pestanas: pestanas_de_asistencia, etiqueta: "Vistas de la asistencia"

  = render "planilla", ruta_del_dia: ->(dia) { seccion_asistencia_path(@seccion, dia: dia) }
