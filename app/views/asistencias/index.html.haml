- content_for :titulo, "Asistencia"

.card-academic
  = render layout: "shared/cabecera", locals: { titulo: "Asistencia" } do
    .admin-info-badge= l(Date.current, format: :long)

  = render "shared/pestanas", pestanas: pestanas_de_asistencia, etiqueta: "Vistas de la asistencia"

  - if @secciones.empty?
    .empty-state
      %h3 Sin secciones a cargo
      %p
        La asistencia la toma el profesor guía de cada sección. Si le
        corresponde y no aparece aquí, pídale a la dirección que le asigne su
        sección como guía.

  - else
    %p.nota-ayuda Elija la sección para tomar la asistencia de hoy.

    .asistencia-secciones
      - @secciones.each do |seccion|
        = link_to seccion_asistencia_path(seccion, dia: Date.current), class: "asistencia-seccion" do
          %span.asistencia-seccion-nombre
            = icono(:secciones, tamano: 16)
            = "#{seccion.grade.name} – #{seccion.name}"
          %span.asistencia-seccion-dato
            - if @tomadas_hoy&.any? { |id| seccion.enrollment_ids.include?(id) }
              %span.asistencia-marca-tomada
                = icono(:ok, tamano: 14)
                Tomada hoy
            - else
              = contar(seccion.enrollments.size, "alumno", "alumnos")
