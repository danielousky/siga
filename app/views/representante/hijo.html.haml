-# Cómo va mi hijo. Una pregunta, una pantalla (MOR-110).
-#
-# El representante entra tres veces al año, desde el teléfono, a saber una sola
-# cosa. No es un tablero: es una respuesta. Por eso la nota está arriba de todo
-# y todo lo demás viene después.
.portal-hijo
  -# ⚠️ La misma cabecera que el resto de la app, también acá.
  -# Daniel: *«un único tipo de títulos tanto para administradores, profesores,
  -# estudiantes y representantes»*. El portal tenía la suya —`.portal-cabecera`,
  -# con su borde de 2 px— y era otra de las siete formas. El nombre del hijo es
  -# el título; su sección y su año escolar son el detalle, que es exactamente
  -# para lo que existe `detalle:`.
  - donde_estudia = [ "#{@inscripcion.section.grade.name} – #{@inscripcion.section.name}",
                      @inscripcion.section.academic_period.name ].join(" · ") if @inscripcion
  -# ⚠️ En su propia tarjeta, como en el resto de la app: sin ella la
  -# franja del título quedaba pegada al borde de la pantalla.
  .card-academic
    = render "shared/cabecera", titulo: @hijo[:student].user.nombre_completo,
             detalle: donde_estudia

- if @inscripcion.nil?
  .card-academic
    .empty-state
      %h3 Sin inscripción activa
      %p
        = "#{@hijo[:student].user.first_name} no tiene una inscripción vigente."
        Consulte con la secretaría del colegio.

- else
  -# Elegir lapso. Píldoras grandes: en un teléfono un select es dos toques y
     una espera; esto es uno.
  .filter-pills.portal-lapsos
    - @lapsos.each do |lapso|
      = link_to hijo_representante_path(@hijo[:student], lapso: lapso.id), class: "filter-pill #{'active' if !@anual && @lapso == lapso}" do
        = lapso.name
    = link_to "Año completo", hijo_representante_path(@hijo[:student], lapso: "anual"), class: "filter-pill #{'active' if @anual}"

  .card-academic
    = render "shared/cabecera", titulo: @anual ? "Calificaciones del año" : "Calificaciones de #{@lapso&.name&.downcase}", nivel: 2

    %ul.portal-materias
      - @materias.each do |fila|
        - valor = @anual ? fila[:definitiva] : fila[:lapso]
        %li.portal-materia
          .portal-materia-fila
            %span.portal-materia-nombre= fila[:materia].name
            - if valor
              -# En el AÑO va el literal si el grado califica así (MOR-129); en
                el LAPSO va el nivel de la rúbrica del colegio cuando la definió
                (MOR-136). Los dos llevan el número al lado: «la niña sacó 19,
                por eso tiene PC» — la familia lee el nivel, y el número es lo
                que el colegio tiene que poder verificar.
              %span.portal-nota{class: valor >= 10 ? "portal-nota--aprobada" : "portal-nota--aplazada"}
                - if @anual
                  = EscalaLiteral.mostrar(valor, escala: fila[:escala])
                - elsif fila[:nivel]
                  -# ⚠️ SOLO el nivel, sin el número al lado.
                  -#
                  -# Daniel, después de revisarlo: *«por ley debe aparecer la
                  -# rúbrica y no la numérica»*. Cambia una decisión anterior
                  -# —«los dos, no uno: la niña sacó 19, por eso tiene PC»— y se
                  -# cambia a sabiendas: lo que la familia LEE en primaria es el
                  -# nivel, y el número sigue disponible para el colegio, que es
                  -# quien tiene que poder verificarlo.
                  = fila[:nivel]
                - else
                  = valor
            - else
              -# NUNCA un cero: el profesor todavía no corrigió. Confundirlos hace
                que una familia crea que su hijo está reprobando.
              %span.portal-pendiente Pendiente

          -# ⚠️ Qué se trabajó en el lapso (MOR-136). Es para lo único que
            existen las competencias, y lo que `MOR-216` pedía: que los padres
            entiendan qué se evaluó, no solo con qué nota salió.
          - if fila[:competencias].present?
            %ul.portal-competencias
              -# ⚠️ Claves de TEXTO, no símbolos: la pantalla y el boletín emitido
                comparten `PlanEvaluado`, y su salida es la misma que se
                congela en el `snapshot` —que es JSON y no tiene símbolos—.
              - fila[:competencias].each do |competencia|
                %li.portal-competencia
                  .portal-competencia-fila
                    %span= competencia["texto"]
                    -# «Sin evaluar» en LETRAS, nunca el nivel más bajo: ése
                      reprueba, y esto es que todavía no le tomaron nada.
                    %span.portal-competencia-nivel
                      = competencia["nivel_de_rubrica"] || "Sin evaluar"
                  -# ⚠️ Solo los indicadores que alguna evaluación MIDIÓ, cada
                    uno con el nivel de esa evaluación. Un indicador lo mide una
                    sola, así que el nivel es una lectura y no un promedio
                    inventado — ver `PlanEvaluado`.
                  - medidos = PlanEvaluado.indicadores_de(competencia)
                  - if medidos.any?
                    %ul.portal-indicadores
                      - medidos.each do |indicador|
                        %li.portal-indicador
                          %span= indicador["texto"]
                          - if indicador["nivel_de_rubrica"]
                            %span.portal-indicador-nivel= indicador["nivel_de_rubrica"]

    -# ⚠️ La leyenda de la rúbrica está OCULTA por ahora (Daniel, 10 de sept:
    -# «de momento, vamos a ocultar ese panel»).
    -#
    -# El argumento para tenerla sigue en pie —sin ella, «PA» es una sigla que la
    -# familia tiene que adivinar— así que no se borra: se apaga en un solo sitio
    -# y vuelve cambiando este `false`. Borrarla obligaría a reescribir la
    -# rúbrica del colegio, que es de donde salen los cinco niveles.
    -#
    -# Y hay una razón para que estorbe hoy: con las notas en «Pendiente» —que es
    -# como está el lapso recién abierto— la leyenda es lo ÚNICO con contenido en
    -# la tarjeta, así que ocupa el centro de una pantalla que no tiene nada que
    -# decir todavía.
    - if false && !@anual && rubricas_del_colegio.any?
      = mas_detalle "Qué significa cada nivel" do
        %ul.portal-leyenda
          - rubricas_del_colegio.each do |nivel|
            %li
              %strong= nivel.code
              = nivel.name.downcase
              %span.dato-secundario= "desde #{nivel.valor}"
        %p.nota-ayuda El número va al lado de cada nota para que se lea igual.

    - if @anual && @materias.any? { |f| f[:escala].to_s == "literal" }
      = mas_detalle "Qué significa cada letra" do
        %p
          %strong A
          20–19 ·
          %strong B
          18–17 ·
          %strong C
          16–14 ·
          %strong D
          13–10 ·
          %strong E
          por debajo de 10.
        %p El número va al lado de cada nota para que se lea igual.

    -# ⚠️ El informe descriptivo va DESPUÉS de las notas (MOR-216): primero
    -# cuánto sacó, después cómo le fue. Al revés, la familia lee la opinión
    -# antes que el dato que la sostiene.
    - if @informe
      .informe-descriptivo
        .informe-descriptivo-titulo Informe del docente
        %p.informe-descriptivo-cuerpo= @informe.cuerpo

  .card-academic
    = render "shared/cabecera", titulo: "Asistencia", nivel: 2

    .stats-grid
      .stat-card
        %h3= @asistencia[:presente]
        %p Días presente
      .stat-card
        %h3= @asistencia[:ausente]
        %p Ausencias
      .stat-card
        %h3= @asistencia[:tarde]
        %p Tardanzas

    - if @asistencia[:sin_justificar].positive?
      .alert.alert-warning
        = contar(@asistencia[:sin_justificar], "falta", "faltas")
        sin justificar. Si ya entregaste el justificativo, avísale a la
        secretaría del colegio.

    - if @asistencia[:ultimas].any?
      %table.table-academic.table-academic--tarjetas
        %thead
          %tr
            %th Fecha
            %th Estado
        %tbody
          - @asistencia[:ultimas].each do |registro|
            %tr
              %td= l(registro.date, format: :long)
              %td
                %span.asistencia-marca{class: "asistencia-marca--#{registro.status}"}= registro.etiqueta
                - if registro.justificada?
                  %span.portal-justificada justificada

  - if @boletines.any?
    .card-academic
      = render "shared/cabecera", titulo: "Boletines", nivel: 2
      %ul.portal-boletines
        - @boletines.each do |boletin|
          %li
            %span= boletin.titulo
            %span.portal-boletin-codigo= boletin.code
            -# ⚠️ Descargarlo es el punto: hasta ahora la familia veía que el
            -# boletín existía y tenía que pedirlo por la oficina.
            -#
            -# La pantalla ya está bloqueada si hay deuda, así que llegar acá
            -# significa estar al día: el botón no necesita volver a preguntarlo.
            = boton "Descargar", boletin_path(boletin), icono: :descargar, tono: :documento,
                    sm: true, tooltip: "Descargar el #{boletin.titulo} en PDF"
