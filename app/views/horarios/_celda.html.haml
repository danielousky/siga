-# Lo que va en una casilla, según la mirada (`RejillaDeHorarios::Celda`).
-#
-#    clase           el área y el profesor; al armar, con su × para quitarla
-#    del_profesor    la sección y el área
-#    del_area        las secciones que la tienen a esa hora, y con quién
-#    libre           al armar: tocarla ubica el área elegida
-#    bloqueada       al armar: rayada y con «?»; tocarla dice por qué (decisión 23)
- datos = celda.datos
- cuando = "el #{Lesson::DIAS[dia - 1].downcase} a las #{HoraDelDia.texto(fila.hora.starts_min)}"
- case celda.tipo
- when :clase
  - clase = datos[:clase]
  .horario-clase{ class: ("elegida" if datos[:elegida]), style: "--area: #{color_del_area(clase.subject)}" }
    %b= clase.subject.name
    %small= clase.teacher ? apellido_del_profesor(clase.teacher) : "sin profesor"
    - if @armando
      = button_to section_lesson_path(clase.section_id, clase, **desde_la_seccion), method: :delete, class: "horario-quitar",
                  form_class: "horario-quitar-form", "aria-label": "Quitar #{clase.subject.name} #{cuando}" do
        ×
- when :del_profesor
  - clase = datos[:clase]
  .horario-clase{ style: "--area: #{color_del_area(clase.subject)}" }
    %b= nombre_de_la_seccion(clase.section)
    %small= clase.subject.name
- when :del_area
  .horario-varias{ style: "--area: #{color_del_area(datos[:clases].first.subject)}" }
    - datos[:clases].each do |clase|
      %span
        %b= corto_de_la_seccion(clase.section)
        = "· #{clase.teacher ? apellido_del_profesor(clase.teacher) : 'sin profesor'}"
- when :bloqueada
  - otra = datos[:otra]
  = link_to ruta_del_horario(porque: "#{dia}-#{fila.numero}"), class: class_names("horario-bloqueada", marcada: datos[:marcada]),
            "aria-label": "No se puede #{cuando}: #{apellido_del_profesor(datos[:profesor])} está en #{nombre_de_la_seccion(otra.section)}" do
    %b= apellido_del_profesor(datos[:profesor])
    %span= "en #{corto_de_la_seccion(otra.section)}"
    %i.horario-por-que{ "aria-hidden": "true" } ?
- when :libre
  - area = datos[:area]
  = button_to section_lessons_path(@seccion), params: { subject_id: area.materia.id, dia: dia, time_slot_id: datos[:hora].id, **desde_la_seccion },
              class: "horario-libre", form_class: "horario-libre-form", style: "--area: #{color_del_area(area.materia)}",
              "aria-label": "Ubicar #{area.materia.name} #{cuando}" do
    = "+ #{area.materia.name}"
- when :libre_sin_area, :libre_del_profesor
  .horario-vacia
    %span libre
- else
  .horario-vacia
