.card-academic
  .card-academic-header
    %h1 Catálogo de Materias
    = link_to "Registrar Nueva Materia", new_subject_path, class: "btn btn-primary"

  %table.table-academic
    %thead
      %tr
        %th Código
        %th Nombre
        %th Departamento
        %th Acciones
    %tbody
      - @subjects.each do |subject|
        %tr
          %td
            %code{style: "font-family: var(--font-sans); color: var(--text-primary); background: var(--surface-canvas); padding: 2px 6px; border-radius: 3px; font-size: 13px;"}= subject.code
          %td= subject.name
          %td= subject.department.name
          %td
            .actions-group
              = link_to "Ver", subject, class: "btn btn-secondary btn-sm"
              = link_to "Editar", edit_subject_path(subject), class: "btn btn-secondary btn-sm"
              = link_to "Eliminar", subject, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar este registro?" }, class: "btn btn-danger btn-sm"

  .pagy-nav
    != pagy_nav(@pagy)
