.card-academic
  .card-academic-header
    %h1 Catálogo de materias
    = link_to new_subject_path, class: "btn btn-primary" do
      = icono(:agregar, tamano: 16)
      %span Registrar nueva materia

  %table.table-academic
    %thead
      %tr
        %th Código
        %th Nombre
        %th Departamento
    %tbody
      - @subjects.each do |subject|
        %tr
          %td
            %code{style: "font-family: var(--font-sans); color: var(--text-primary); background: var(--surface-canvas); padding: 2px 6px; border-radius: 3px; font-size: 13px;"}= subject.code
          %td= link_to subject.name, subject
          %td= subject.department.name
