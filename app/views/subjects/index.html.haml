.card-academic
  = render "shared/cabecera", titulo: Vocabulario::AREAS, ruta: subjects_path,
           marco: "subjects-results", pista: "Nombre o código de la materia…",
           alta: { ruta: new_subject_path, nombre: "Registrar materia" },
           importar: :pensum
-# ⚠️ `target: "_top"`: sin él, cada enlace de adentro navega DENTRO del frame
-# y Turbo pinta «Content missing», porque la página de destino no tiene un
-# frame con este id. El buscador sigue actualizando el frame porque declara
-# su destino explícito, y eso le gana al `target`.
= turbo_frame_tag "subjects-results", target: "_top" do
  -# El estado vacío sale de `PasosDeArranque`, o sea del MISMO lugar que el
  -# mapa del panel: dos redacciones del mismo paso se van separando, y quien
  -# las lee cree que son dos cosas distintas.
  - if @subjects.empty?
    .card-academic
      = render "shared/lista_vacia", clave: :materias,
               acciones: [ { tipo: :pensum },
                 { texto: "Agregar", ruta: new_subject_path, icono: :agregar },
                 { texto: "Cargar profesores", ruta: teachers_path, icono: :profesores, clase: "btn-secondary" } ]
  - else
    .card-academic
      = render "shared/escala", total: @pagy.count, singular: "materia",
               plural: "materias",
               detalle: (params[:q].present? ? "de la búsqueda “#{params[:q].strip}”" : nil)

      %table.table-academic
        %thead
          %tr
            %th= Subject.human_attribute_name(:code)
            %th= Subject.human_attribute_name(:name)
            %th= Subject.human_attribute_name(:department)
        %tbody
          - @subjects.each do |subject|
            %tr
              %td
                %code.codigo-corto= subject.code
              %td= link_to subject.name, subject
              -# El guion, no el vacío: una celda en blanco se lee como un dato
              -# que falta, y no falta nada — el departamento es opcional.
              %td= subject.department&.name || "—"
