%h1 Materias

= link_to "Nueva Materia", new_subject_path, class: "btn btn-primary mb-3"

%table.table.table-striped.table-hover
  %thead
    %tr
      %th Código
      %th Nombre
      %th Departamento
      %th Escuela
      %th Acciones
  %tbody
    - @subjects.each do |subject|
      %tr
        %td= subject.code
        %td= subject.name
        %td= subject.department.name
        %td= subject.department.school.name
        %td
          = link_to "Ver", subject, class: "btn btn-sm btn-outline-primary"
          = link_to "Editar", edit_subject_path(subject), class: "btn btn-sm btn-outline-secondary"
          = link_to "Eliminar", subject, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-sm btn-outline-danger"

== pagy_bootstrap_nav(@pagy)
