= form_with(model: subject) do |f|
  = render "shared/errors", object: subject

  -# Las mismas tres capas que el identificador de sección y la cédula: filtrar
  -# al escribir, `pattern` para el envío, y el modelo para lo que llegue por
  -# otra puerta. Ver `campo-filtrado`.
  .form-row
    .form-group
      = f.label :code, class: "form-label"
      -# ⚠️ Es un CÓDIGO: alfanumérico, sin espacios ni símbolos, en mayúscula.
      -# Sale impreso en el boletín y en la certificación 31059.
      = f.text_field :code, class: "form-control campo-mayuscula", required: requerido?(Subject, :code), maxlength: 12, pattern: "[A-Za-z0-9]+", placeholder: "MAT", data: { tooltip: "Solo letras y números, sin espacios ni símbolos", controller: "campo-filtrado", campo_filtrado_permite_value: "A-Za-z0-9", campo_filtrado_mayuscula_value: true, action: "input->campo-filtrado#filtrar" }

    .form-group
      = f.label :name, class: "form-label"
      -# El nombre es libre —acentos, espacios— pero se guarda en mayúscula, como
      -# el de una persona: lo cargado a mano y lo importado tienen que quedar
      -# igual, o el listado sale desparejo. `permite` vacío = no filtra nada.
      = f.text_field :name, class: "form-control campo-mayuscula", required: requerido?(Subject, :name), placeholder: "Castellano y Literatura", data: { controller: "campo-filtrado", campo_filtrado_mayuscula_value: true, action: "input->campo-filtrado#filtrar blur->campo-filtrado#recortar" }

  -# ⚠️ OPCIONAL, y hay que decirlo ACÁ.
  -#
  -# Sin la marca, tres campos se ven iguales y el único modo de averiguar cuál
  -# es obligatorio es guardar y leer el error. Daniel: «le di guardar y no
  -# validó ningún campo de la materia».
  .form-group
    = f.label :department_id, class: "form-label"
    %span.solicitud-opcional opcional
    - hay_departamentos = Department.exists?
    = f.select :department_id, Department.order(:name).map { |d| [ d.name, d.id ] }, { include_blank: hay_departamentos ? "Sin departamento" : "Todavía no hay departamentos" }, class: "form-select", disabled: !hay_departamentos

    -# Se queda VISIBLE: es la consecuencia de dejarlo vacío, no la explicación
    -# del campo. Y sobre todo, desactiva la sospecha de que falta un paso.
    %p.nota-ayuda
      - if hay_departamentos
        Reúnen las áreas de aprendizaje afines —el de Ciencias, el de Letras— para
        ver el rendimiento por departamento. Un área sin departamento funciona igual.
      - else
        Un colegio chico no los necesita: reúnen las áreas de aprendizaje afines
        —el de Ciencias, el de Letras— y sirven para ver el rendimiento por departamento.
        = succeed "." do
          = link_to "Se crean acá", departments_path
        Puede seguir sin ellos.

  .form-acciones
    = f.submit class: "btn btn-guardar"
    - if local_assigns[:volver]
      = boton "Volver", volver, icono: :volver, tono: :secondary
