.card-academic.acceso
  - if @usuario.puede_entrar?
    %h1.acceso-titulo Elija una contraseña nueva
  - else
    %h1.acceso-titulo= "Bienvenido, #{@usuario.first_name}"

  -# ⚠️ Decir DE QUIÉN es la cuenta no es decoración.
  -#
  -# El formulario de Devise no lo dice —construye un usuario en blanco a partir
  -# del token y nunca carga la persona—, así que quien abre el enlace no tiene
  -# forma de saber a qué cuenta le está poniendo contraseña. Le pasó a Daniel
  -# con este mismo enlace: "no sé de cuál usuario estoy reseteando".
  -#
  -# Y no filtra nada: quien tiene el código ya controla esa cuenta.
  %p.acceso-quien
    = @usuario.nombre_completo
    - if @usuario.email.present?
      %span.acceso-quien-correo= @usuario.email

  %p.nota-ayuda
    - if @usuario.puede_entrar?
      La anterior deja de servir en cuanto guarde esta.
    - else
      De ahora en adelante entra a SIGA con ella.

  = form_with(model: @usuario, url: activacion_path, method: :patch, scope: :user) do |f|
    = render "shared/errors", object: @usuario
    = hidden_field_tag "user[token]", @token

    -# El correo solo se pide si falta. Se pide JUNTO con la contraseña y no
    -# después porque aceptarlos por separado deja a alguien con contraseña
    -# puesta y sin correo: o sea, sin ninguna forma de recuperarla. Devise solo
    -# sabe escribirle al correo del usuario.
    - if @pide_correo
      .form-group
        = con_pista "Con este correo entra al sistema, y es por donde va a poder recuperar su contraseña si la olvida." do
          = f.label :email, "Su correo electrónico", class: "form-label"
        = f.email_field :email, autofocus: true, required: true, class: "form-control"

    .form-group
      = f.label :password, "Contraseña", class: "form-label"
      = f.password_field :password, autocomplete: "new-password", required: true,
                         autofocus: !@pide_correo, class: "form-control",
                         placeholder: "Mínimo #{User.password_length.min} caracteres"

    .form-group
      = f.label :password_confirmation, "Repita la contraseña", class: "form-label"
      = f.password_field :password_confirmation, autocomplete: "new-password",
                         required: true, class: "form-control"

    = f.submit "Entrar a SIGA", class: "btn btn-primary acceso-enviar"
