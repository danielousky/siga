%h1 Momentos de Evaluación

= link_to "Nuevo Momento de Evaluación", new_evaluation_moment_path, class: "btn btn-primary mb-3"

%table.table.table-striped.table-hover
  %thead
    %tr
      %th Nombre
      %th Peso (%)
      %th Acciones
  %tbody
    - @evaluation_moments.each do |moment|
      %tr
        %td= moment.name
        %td= number_with_precision(moment.weight, precision: 2)
        %td
          = link_to "Ver", moment, class: "btn btn-sm btn-outline-primary"
          = link_to "Editar", edit_evaluation_moment_path(moment), class: "btn btn-sm btn-outline-secondary"
          = link_to "Eliminar", moment, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-sm btn-outline-danger"

== pagy_bootstrap_nav(@pagy)
