.card-academic
  .card-academic-header
    %h1 Momentos de evaluación
    = link_to new_evaluation_moment_path, class: "btn btn-primary" do
      = icono(:agregar, tamano: 16)
      %span Nuevo momento

  %table.table-academic
    %thead
      %tr
        %th Período
        %th Nombre
        %th Peso (%)
    %tbody
      - @evaluation_moments.each do |moment|
        %tr
          %td= link_to moment.academic_period.name, edit_evaluation_moment_path(moment)
          %td= moment.name
          %td= number_with_precision(moment.weight, precision: 0)
