.card-academic
  .card-academic-header
    %h1 Momentos de Evaluación
    = link_to "Nuevo Momento", new_evaluation_moment_path, class: "btn btn-primary"

  %table.table-academic
    %thead
      %tr
        %th Período
        %th Nombre
        %th Peso (%)
        %th Acciones
    %tbody
      - @evaluation_moments.each do |moment|
        %tr
          %td= moment.academic_period.name
          %td= moment.name
          %td= number_with_precision(moment.weight, precision: 0)
          %td
            .actions-group
              = link_to "Ver", moment, class: "btn btn-secondary btn-sm"
              = link_to "Editar", edit_evaluation_moment_path(moment), class: "btn btn-secondary btn-sm"
              = link_to "Eliminar", moment, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar este momento de evaluación?" }, class: "btn btn-danger btn-sm"

  .pagy-nav
    != pagy_nav(@pagy)
