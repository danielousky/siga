%h1= @evaluation_moment.name

.card
  .card-body
    %dl.row
      %dt.col-sm-3 Nombre
      %dd.col-sm-9= @evaluation_moment.name
      %dt.col-sm-3 Peso (%)
      %dd.col-sm-9= number_with_precision(@evaluation_moment.weight, precision: 2)

.mt-3
  = link_to "Editar", edit_evaluation_moment_path(@evaluation_moment), class: "btn btn-outline-secondary"
  = link_to "Volver", evaluation_moments_path, class: "btn btn-outline-primary"
  = link_to "Eliminar", @evaluation_moment, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-outline-danger"
