= form_with(model: evaluation_moment, class: "mb-3") do |f|
  = render "shared/errors", object: evaluation_moment

  -# La lista de períodos ya viene filtrada al colegio de la sesión: AcademicPeriod
  -# es SchoolScoped, así que `AcademicPeriod.includes(:school)` no puede traer los
  -# de otro colegio aunque alguien lo intente.
  .mb-3
    = f.label :academic_period_id, "Período académico", class: "form-label"
    = f.select :academic_period_id, AcademicPeriod.order(:name).map { |p| [p.name, p.id] }, { include_blank: "Seleccione..." }, class: "form-select"

  .mb-3
    = f.label :name, "Nombre", class: "form-label"
    = f.text_field :name, class: "form-control"

  .mb-3
    = f.label :weight, "Peso (%)", class: "form-label"
    = f.number_field :weight, class: "form-control", step: 0.01, min: 0, max: 100
    %small.form-text.text-muted
      Describe qué parte del año representa el lapso. La nota anual es el
      %strong promedio
      de los lapsos, sin ponderar (Art. 111 del Reglamento General de la LOE).

  = f.submit class: "btn btn-primary"
