-# La ficha del profesor (MOR-135). Ver `TeachersController#show`.
- persona = @teacher.user

.ficha
  .ficha-cabecera
    %div
      %h1.ficha-nombre= persona.apellidos_y_nombres
      %p.ficha-situacion
        = contar(@asignaciones.size, "asignación", "asignaciones")
        - if @guia_de.any?
          %span.ficha-punto ·
          = "guía de #{@guia_de.map { |s| "#{s.grade.name} – #{s.name}" }.to_sentence}"
        -# El coordinador de grado es otro cargo, y quien lo tiene suele tener
        -# también sus secciones: se dicen los dos, no uno u otro.
        - if @coordina.any?
          %span.ficha-punto ·
          = "coordina #{@coordina.map(&:name).to_sentence}"

    .ficha-acciones
      = link_to edit_teacher_path(@teacher), class: "btn btn-secondary" do
        = icono(:editar, tamano: 16)
        %span Editar

  .card-academic
    .card-academic-header
      %h2 Qué dicta

    - if @asignaciones.any?
      %table.table-academic
        %thead
          %tr
            %th= Section.model_name.human
            %th= Subject.model_name.human
            %th Año escolar
        %tbody
          - @asignaciones.each do |asignacion|
            %tr
              %td= link_to "#{asignacion.section.grade.name} – #{asignacion.section.name}", section_path(asignacion.section)
              %td= asignacion.subject.name
              %td= asignacion.section.academic_period.name
    - else
      .empty-state
        %h3 Sin secciones asignadas
        %p
          #{persona.first_name} no dicta ninguna materia todavía. Las asignaciones se
          hacen desde la sección.

  .card-academic
    .card-academic-header
      %h2 Datos

    .detail-row
      .detail-item
        %span.detail-label Cédula
        %p.detail-value= persona.document.presence || "—"
      .detail-item
        %span.detail-label Correo
        %p.detail-value= persona.email

  -# ⚠️ Los DOS parciales, y en este orden (MOR-187).
  -#
  -# `acceso_al_sistema` se redujo a un chip y un botón para poder ir junto al
  -# nombre; el código recién generado necesita ancho y va aparte. Al separarlos
  -# olvidé este segundo render acá, y el código dejó de mostrarse en la ficha del
  -# profesor —en silencio, hasta que un test lo dijo.
  = render "shared/acceso_al_sistema", usuario: persona, url: codigo_teacher_path(@teacher)
  = render "shared/codigo_generado"

  %p.ficha-volver
    = link_to "← Volver a los profesores", teachers_path
