%h1= "#{@teacher.user.name} #{@teacher.user.last_name}"

.card
  .card-body
    %dl.row
      %dt.col-sm-3 Nombre
      %dd.col-sm-9= @teacher.user.name
      %dt.col-sm-3 Apellido
      %dd.col-sm-9= @teacher.user.last_name
      %dt.col-sm-3 Cédula
      %dd.col-sm-9= @teacher.user.id_card || "—"
      %dt.col-sm-3 Email
      %dd.col-sm-9= @teacher.user.email
      %dt.col-sm-3 Escuela
      %dd.col-sm-9= @teacher.school.name

.mt-3
  = link_to "Editar", edit_teacher_path(@teacher), class: "btn btn-outline-secondary"
  = link_to "Volver", teachers_path, class: "btn btn-outline-primary"
  = link_to "Eliminar", @teacher, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-outline-danger"
