= form_with(model: teacher) do |f|
  = render "shared/errors", object: teacher

  .form-seccion
    %h2.form-seccion-titulo Datos de la persona
    = f.fields_for :user do |u|
      = render "shared/datos_de_la_persona", u: u

  .form-seccion
    %h2.form-seccion-titulo Cómo entra al sistema
    = f.fields_for :user do |u|
      .form-group
        = con_pista "El profesor entra al sistema con este correo, y es por donde recupera su contraseña si la olvida." do
          = u.label :email, class: "form-label"
        = u.email_field :email, class: "form-control", pattern: "[^@\s]+@[^@\s]+\.[^@\s]+", data: { tooltip: "Escriba una dirección completa, con punto en el dominio: nombre@colegio.edu" }, required: true
      - if teacher.new_record?
        -# `required` porque desde `MOR-142` el modelo ya no la exige: una persona
        -# puede existir sin credenciales. Para el personal del colegio eso todavía
        -# no tiene salida —el código de activación existe para representantes y
        -# para el primer director de un colegio, no acá— así que dejarla en blanco
        -# crearía un profesor que no puede entrar y nadie se enteraría.
        -# Con el ojo, y las dos. Quien carga la clave de un profesor no la va a
        -# volver a ver: si se equivoca al tipear y la confirmación coincide con
        -# el error, el profesor no entra y nadie sabe por qué.
        = render "shared/campo_de_contrasena", f: u, campo: :password, required: true
        = render "shared/campo_de_contrasena", f: u, campo: :password_confirmation,
                 etiqueta: User.human_attribute_name(:password_confirmation), required: true

  .form-acciones
    = f.submit class: "btn btn-primary"
    - if local_assigns[:volver]
      = link_to volver, class: "btn btn-secondary" do
        = icono(:volver, tamano: 16)
        %span Volver
