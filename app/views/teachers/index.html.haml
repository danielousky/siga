.card-academic
  .card-academic-header
    %h1 Registro de Profesores
    = link_to "Registrar Nuevo Profesor", new_teacher_path, class: "btn btn-primary"

  = render "shared/escala", total: @pagy.count, singular: "profesor", plural: "profesores"

  %table.table-academic
    %thead
      %tr
        %th Nombre
        %th Apellido
        %th Cédula
        %th Email
        %th Acciones
    %tbody
      - @teachers.each do |teacher|
        %tr
          %td= teacher.user.name
          %td= teacher.user.last_name
          %td= teacher.user.id_card || "—"
          %td= teacher.user.email
          %td
            .actions-group
              = link_to "Ver", teacher, class: "btn btn-secondary btn-sm"
              = link_to "Editar", edit_teacher_path(teacher), class: "btn btn-secondary btn-sm"
