%h1 Profesores

= link_to "Nuevo Profesor", new_teacher_path, class: "btn btn-primary mb-3"

%table.table.table-striped.table-hover
  %thead
    %tr
      %th Nombre
      %th Apellido
      %th Cédula
      %th Email
      %th Escuela
      %th Acciones
  %tbody
    - @teachers.each do |teacher|
      %tr
        %td= teacher.user.name
        %td= teacher.user.last_name
        %td= teacher.user.id_card || "—"
        %td= teacher.user.email
        %td= teacher.school.name
        %td
          = link_to "Ver", teacher, class: "btn btn-sm btn-outline-primary"
          = link_to "Editar", edit_teacher_path(teacher), class: "btn btn-sm btn-outline-secondary"
          = link_to "Eliminar", teacher, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-sm btn-outline-danger"

== pagy_bootstrap_nav(@pagy)
