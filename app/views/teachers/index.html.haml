.card-academic
  .card-academic-header
    %h1 Registro de profesores
    = link_to "Registrar nuevo profesor", new_teacher_path, class: "btn btn-primary"

  = render "shared/escala", total: @pagy.count, singular: "profesor", plural: "profesores"

  %table.table-academic
    %thead
      %tr
        %th Nombre
        %th Apellido
        %th Cédula
        %th Email
    %tbody
      - @teachers.each do |teacher|
        %tr
          %td= link_to teacher.user.first_name, teacher
          %td= teacher.user.apellidos
          %td= teacher.user.document || "—"
          %td= teacher.user.email
