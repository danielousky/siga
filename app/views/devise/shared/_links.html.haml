.acceso-enlaces
  - if controller_name != "sessions"
    = link_to "Iniciar sesión", new_session_path(resource_name)

  -# Sin enlace a "Crear Cuenta": el registro público no existe (MOR-101). Las
  -# cuentas las da de alta el colegio desde su panel.

  - if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations"
    = link_to "¿Olvidó su contraseña?", new_password_path(resource_name)

  - if devise_mapping.confirmable? && controller_name != "confirmations"
    = link_to "¿No recibió instrucciones de confirmación?", new_confirmation_path(resource_name)

  - if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != "unlocks"
    = link_to "¿No recibió instrucciones de desbloqueo?", new_unlock_path(resource_name)

  - if devise_mapping.omniauthable?
    - resource_class.omniauth_providers.each do |provider|
      = button_to "Iniciar sesión con #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "btn btn-secondary"
