.card-academic{style: "max-width: 480px; margin: var(--space-2xl) auto;"}
  %h1{style: "text-align: center; margin-bottom: var(--space-md);"} Registrarse
  %p{style: "text-align: center; color: var(--text-secondary); margin-bottom: var(--space-xl);"} Crear una nueva cuenta en el sistema SIGA

  = form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
    = render "devise/shared/error_messages", resource: resource

    .form-group
      = f.label :email, "Correo Electrónico", class: "form-label"
      = f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "usuario@ejemplo.com"

    .form-group
      = f.label :password, "Contraseña", class: "form-label"
      - if @minimum_password_length
        %span{style: "font-size: 13px; color: var(--text-tertiary);"}
          (mínimo #{@minimum_password_length} caracteres)
      = f.password_field :password, autocomplete: "new-password", class: "form-control", placeholder: "Cree una contraseña segura"

    .form-group
      = f.label :password_confirmation, "Confirmar Contraseña", class: "form-label"
      = f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: "Reingrese la contraseña"

    .form-group
      = f.submit "Crear Cuenta", class: "btn btn-primary", style: "width: 100%; justify-content: center;"

  %div{style: "margin-top: var(--space-lg); padding-top: var(--space-lg); border-top: 1px solid var(--border-subtle); text-align: center; font-size: 14px;"}
    = render "devise/shared/links"
