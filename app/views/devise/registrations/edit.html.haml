-# Esta pantalla es lo ÚNICO que queda de `:registrations`. Sirve para que un
-# usuario se cambie la contraseña estando adentro; el alta la hace el colegio
-# desde su panel y no hay forma de darse de baja solo. Ver MOR-101.
.card-academic
  .card-academic-header
    %h1 Mi cuenta
    = link_to "Volver", dashboard_path_for_user, class: "btn btn-secondary"

  = form_for(resource, as: resource_name, url: user_registration_path, html: { method: :put }) do |f|
    = render "devise/shared/error_messages", resource: resource

    .form-group
      = f.label :email, "Correo electrónico", class: "form-label"
      = f.email_field :email, autocomplete: "email", class: "form-control"

    - if devise_mapping.confirmable? && resource.pending_reconfirmation?
      .alert.alert-warning
        = "Esperando confirmación de #{resource.unconfirmed_email}"

    .form-group
      = f.label :password, "Contraseña nueva", class: "form-label"
      = f.password_field :password, autocomplete: "new-password", class: "form-control"
      %small.nota-ayuda
        Déjala vacía si no quieres cambiarla.
        - if @minimum_password_length
          = "Mínimo #{@minimum_password_length} caracteres."

    .form-group
      = f.label :password_confirmation, "Repetí la contraseña nueva", class: "form-label"
      = f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control"

    .form-group
      = f.label :current_password, "Contraseña actual", class: "form-label"
      = f.password_field :current_password, autocomplete: "current-password", class: "form-control"
      %small.nota-ayuda
        Hace falta para confirmar que eres tú quien está haciendo el cambio.

    = f.submit "Guardar", class: "btn btn-primary"
