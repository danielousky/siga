.card-academic{style: "max-width: 480px; margin: var(--space-2xl) auto;"}
  %h1{style: "text-align: center; margin-bottom: var(--space-md);"} Iniciar Sesión
  %p{style: "text-align: center; color: var(--text-secondary); margin-bottom: var(--space-xl);"} Acceda al Sistema Integrado de Gestión Académica

  = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
    .form-group
      = f.label :email, "Correo Electrónico", class: "form-label"
      = f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "usuario@ejemplo.com"

    .form-group
      = f.label :password, "Contraseña", class: "form-label"
      .password-toggle-group{data: {controller: "password-visibility"}}
        = f.password_field :password,
          autocomplete: "current-password",
          class: "form-control",
          placeholder: "Ingrese su contraseña",
          data: {password_visibility_target: "input"}
        -# El ojo era la ÚNICA razón por la que toda la app cargaba Font Awesome
        -# desde un CDN, en cada página. Ahora son dos SVG en línea que se
        -# alternan: cero peticiones a terceros (MOR-134).
        %button.password-toggle-btn{type: "button", data: {action: "click->password-visibility#toggle", password_visibility_target: "button"}, aria: {label: "Mostrar contraseña", pressed: "false"}}
          %svg.password-toggle-icon{data: {password_visibility_target: "iconoMostrar"}, viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true"}
            %path{d: "M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"}
            %circle{cx: "12", cy: "12", r: "3"}
          %svg.password-toggle-icon{data: {password_visibility_target: "iconoOcultar"}, hidden: true, viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true"}
            %path{d: "M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"}
            %line{x1: "1", y1: "1", x2: "23", y2: "23"}

    - if devise_mapping.rememberable?
      .form-group
        %label{style: "display: flex; align-items: center; gap: var(--space-xs); font-size: 14px; color: var(--text-secondary); cursor: pointer;"}
          = f.check_box :remember_me, style: "margin: 0;"
          %span Recordarme

    .form-group
      = f.submit "Iniciar Sesión", class: "btn btn-primary", style: "width: 100%; justify-content: center;"

  %div{style: "margin-top: var(--space-lg); padding-top: var(--space-lg); border-top: 1px solid var(--border-subtle); text-align: center; font-size: 14px;"}
    = render "devise/shared/links"
