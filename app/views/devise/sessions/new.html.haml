.card-academic.acceso
  %h1.acceso-titulo Iniciar sesión
  %p.acceso-entrada Acceda al Sistema Integrado de Gestión Académica

  = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
    .form-group
      = f.label :email, "Correo electrónico", class: "form-label"
      = f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "usuario@ejemplo.com"

    -# El mismo parcial que los formularios de alta de personas: el ojo estaba
    -# escrito a mano solo acá, así que donde una secretaria carga la clave de un
    -# profesor no había manera de ver lo escrito (MOR-176).
    = render "shared/campo_de_contrasena", f: f, campo: :password,
             etiqueta: "Contraseña", autocomplete: "current-password"

    - if devise_mapping.rememberable?
      .form-group
        %label.acceso-recordarme
          = f.check_box :remember_me
          %span Recordarme

    .form-group
      = f.submit "Iniciar sesión", class: "btn btn-guardar acceso-enviar"

  .acceso-pie
    = render "devise/shared/links"

    -# ⚠️ El enlace al registro va acá y no en la barra pública (MOR-158).
    -#
    -# Quien llega a la pantalla de entrada ya decidió usar SIGA. Ponerlo también
    -# arriba invitaría a registrarse a quien vino a leer qué es esto, y el
    -# producto todavía no se explica solo a un desconocido.
    %p.acceso-registro
      ¿Su colegio todavía no está en SIGA?
      = link_to "Créelo aquí", new_user_registration_path
