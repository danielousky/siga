.card-academic.acceso
  %h1.acceso-titulo Nueva contraseña

  = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f|
    = render "devise/shared/error_messages", resource: resource
    = f.hidden_field :reset_password_token

    -# El mínimo va en el campo: es formato, y ese es el trabajo del placeholder.
    = render "shared/campo_de_contrasena", f: f, campo: :password, etiqueta: "Contraseña nueva",
             autofocus: true, placeholder: ("Mínimo #{@minimum_password_length} caracteres" if @minimum_password_length)
    = render "shared/campo_de_contrasena", f: f, campo: :password_confirmation,
             etiqueta: "Repita la contraseña nueva"

    = f.submit "Guardar la contraseña", class: "btn btn-guardar acceso-enviar"

  .acceso-pie
    = render "devise/shared/links"
