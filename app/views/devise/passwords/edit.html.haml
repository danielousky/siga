.card-academic.acceso
  %h1.acceso-titulo Nueva contraseña

  = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f|
    = render "devise/shared/error_messages", resource: resource
    = f.hidden_field :reset_password_token

    .form-group
      = f.label :password, "Contraseña nueva", class: "form-label"
      = f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control"
      - if @minimum_password_length
        %small.nota-ayuda= "Mínimo #{@minimum_password_length} caracteres."

    .form-group
      = f.label :password_confirmation, "Repita la contraseña nueva", class: "form-label"
      = f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control"

    = f.submit "Guardar la contraseña", class: "btn btn-primary acceso-enviar"

  .acceso-pie
    = render "devise/shared/links"
