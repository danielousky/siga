- content_for :titulo, "Recibimos su solicitud"
- content_for :descripcion, "Le escribimos por WhatsApp en menos de 24 horas."

.solicitud
  .solicitud-cabecera
    .solicitud-recibida ✓
    %h1.solicitud-titulo Recibimos su solicitud
    %p.solicitud-entrada
      - if @telefono.present?
        Le escribimos por WhatsApp al
        %strong= @telefono
        en menos de 24 horas.
      - else
        Le escribimos por WhatsApp en menos de 24 horas.

  .solicitud-gracias
    -# Acá decía "Te hemos enviado un email de confirmación. Revisa también tu
    -# carpeta de spam". No se envía ningún correo: `action_mailer` no está
    -# configurado. Era mandar a la directora a buscar en spam algo que no
    -# existe, en la PRIMERA frase que lee de nosotros.
    %p
      No le enviamos ningún correo de confirmación: esta pantalla es la
      confirmación. Si el número de arriba tiene un dígito mal,
      = succeed "." do
        = link_to "vuelva a enviarlo", new_demo_request_path
      No se duplica nada.

    - if whatsapp_configurado?
      %p.solicitud-directo-texto ¿Prefiere adelantarse y escribirnos usted?
      = link_to "Escribirnos por WhatsApp", enlace_de_whatsapp("Hola, acabo de pedir una demostración de SIGA."),
                class: "btn btn-primary solicitud-whatsapp",
                target: "_blank", rel: "noopener"

  %p.solicitud-volver
    = link_to "Volver al inicio", root_path
