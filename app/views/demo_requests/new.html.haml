- content_for :titulo, "Conversemos sobre su colegio"
- content_for :descripcion, "Déjenos por dónde escribirle y le mostramos SIGA funcionando, sin compromiso. Respondemos por WhatsApp en menos de 24 horas."

.solicitud
  .solicitud-cabecera
    = image_tag "logo.svg", alt: "", class: "solicitud-marca"
    %h1.solicitud-titulo Conversemos sobre su colegio
    %p.solicitud-entrada
      Le mostramos SIGA funcionando: notas, boletines y constancias.
      Sin instalar nada y sin compromiso.

  .solicitud-cuerpo
    .solicitud-formulario
      - if @demo_request.errors.any?
        .alert.alert-danger
          %p.solicitud-error-titulo Falta algo para poder escribirle:
          %ul.solicitud-errores
            - @demo_request.errors.full_messages.each do |mensaje|
              %li= mensaje

      -# Sin `autofocus`: en un teléfono abre el teclado al cargar y tapa la
      -# página entera, así que la directora ve medio campo de texto y nada más.
      -# Los `autocomplete` son lo que convierte cuatro campos en dos toques.
      = form_with model: @demo_request, url: demo_requests_path, class: "solicitud-form" do |f|
        .form-group
          = f.label :name, "Su nombre y apellido", class: "form-label"
          = f.text_field :name, class: "form-control", required: true,
                                autocomplete: "name", placeholder: "María González"

        .form-group
          = f.label :institution, "Colegio", class: "form-label"
          = f.text_field :institution, class: "form-control", required: true,
                                       autocomplete: "organization",
                                       placeholder: "U.E. Colegio San José"

        .form-group
          = f.label :phone, "WhatsApp", class: "form-label"
          -# «Es por donde le vamos a escribir» sobraba: el campo se llama
          -# WhatsApp y el placeholder muestra el formato. Decirlo era ruido.
          = f.telephone_field :phone, class: "form-control", required: true,
                                      autocomplete: "tel", inputmode: "tel",
                                      placeholder: "0424 123 4567"


        .form-group
          = f.label :email, "Correo", class: "form-label"
          %span.solicitud-opcional opcional
          = f.email_field :email, class: "form-control", autocomplete: "email",
                                  inputmode: "email", placeholder: "direccion@sucolegio.edu.ve"

        .form-group
          = con_pista "Nos sirve para prepararle la demostración con su caso, no con uno genérico." do
            = f.label :current_system, "¿Con qué llevan hoy las notas?", class: "form-label"
          %span.solicitud-opcional opcional
          -# El «?» y no un párrafo: quien ya entendió la pregunta no necesita
          -# leer por qué se la hacemos.
          = f.select :current_system,
            DemoRequest::CURRENT_SYSTEM_LABELS.map { |valor, etiqueta| [ etiqueta, valor ] },
            { include_blank: "Prefiero contarlo en la llamada" }, class: "form-select"


        = f.submit "Pedir la demostración", class: "btn btn-primary solicitud-enviar"

        %p.solicitud-letra-chica
          No compartimos sus datos con nadie ni le mandamos publicidad.

    %aside.solicitud-aparte
      .solicitud-pasos
        %h2.solicitud-aparte-titulo Qué pasa después
        %ol.solicitud-lista-pasos
          %li
            %strong Le escribimos por WhatsApp
            %span en menos de 24 horas, para acordar cuándo.
          %li
            %strong Una llamada de veinte minutos
            %span donde ve el sistema con un colegio como el suyo.
          %li
            %strong Usted decide
            %span si le sirve, cargamos su colegio; si no, quedamos como amigos.

      - if whatsapp_configurado?
        .solicitud-directo
          %p.solicitud-directo-texto ¿Prefiere escribir usted?
          = link_to "Escribirnos por WhatsApp", enlace_de_whatsapp,
                    class: "btn btn-secondary solicitud-whatsapp",
                    target: "_blank", rel: "noopener"

      .solicitud-confianza
        %p
          SIGA lo hace gente que lleva años en gestión académica universitaria:
          la Facultad de Odontología, la de Arquitectura y la de Humanidades y
          Educación de la UCV, además de fundaciones educativas.

  %p.solicitud-volver
    = link_to "Volver al inicio", root_path
