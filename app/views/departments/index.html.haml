.card-academic
  .card-academic-header
    %h1 Departamentos académicos
    = link_to "Crear nuevo departamento", new_department_path, class: "btn btn-primary"

  %table.table-academic
    %thead
      %tr
        %th Nombre del departamento
    %tbody
      - @departments.each do |department|
        %tr
          %td= link_to department.name, edit_department_path(department)
