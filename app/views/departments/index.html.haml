%h1 Departamentos

= link_to "Nuevo Departamento", new_department_path, class: "btn btn-primary mb-3"

%table.table.table-striped.table-hover
  %thead
    %tr
      %th Nombre
      %th Escuela
      %th Acciones
  %tbody
    - @departments.each do |department|
      %tr
        %td= department.name
        %td= department.school.name
        %td
          = link_to "Ver", department, class: "btn btn-sm btn-outline-primary"
          = link_to "Editar", edit_department_path(department), class: "btn btn-sm btn-outline-secondary"
          = link_to "Eliminar", department, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-sm btn-outline-danger"

== pagy_bootstrap_nav(@pagy)
