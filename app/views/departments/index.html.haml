.card-academic
  .card-academic-header
    %h1 Departamentos Académicos
    = link_to "Crear Nuevo Departamento", new_department_path, class: "btn btn-primary"

  %table.table-academic
    %thead
      %tr
        %th Nombre del Departamento
        %th Escuela
        %th Acciones
    %tbody
      - @departments.each do |department|
        %tr
          %td= department.name
          %td= department.school.name
          %td
            .actions-group
              = link_to "Ver", department, class: "btn btn-secondary btn-sm"
              = link_to "Editar", edit_department_path(department), class: "btn btn-secondary btn-sm"
              = link_to "Eliminar", department, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar este registro?" }, class: "btn btn-outline-danger btn-sm"

!= pagy_bootstrap_nav(@pagy)
