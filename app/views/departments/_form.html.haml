= form_with(model: department, class: "mb-3") do |f|
  = render "shared/errors", object: department

  .mb-3
    = f.label :name, "Nombre", class: "form-label"
    = f.text_field :name, class: "form-control"

  -# El colegio NO se elige: sale de la sesión (Current.school). Un selector acá
  -# lista los colegios de toda la plataforma y deja que el id venga del request,
  -# que es justo de donde el inquilino nunca puede venir (MOR-86).

  = f.submit class: "btn btn-primary"
