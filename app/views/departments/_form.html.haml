= form_with(model: department, class: "mb-3") do |f|
  = render "shared/errors", object: department

  .mb-3
    = f.label :name, "Nombre", class: "form-label"
    = f.text_field :name, class: "form-control"

  .mb-3
    = f.label :school_id, "Escuela", class: "form-label"
    = f.select :school_id, School.all.map { |s| [s.name, s.id] }, { include_blank: "Seleccione..." }, class: "form-select"

  = f.submit class: "btn btn-primary"
