%h1= @department.name

.card
  .card-body
    %dl.row
      %dt.col-sm-3 Nombre
      %dd.col-sm-9= @department.name
      %dt.col-sm-3 Escuela
      %dd.col-sm-9= @department.school.name

.mt-3
  = link_to "Editar", edit_department_path(@department), class: "btn btn-outline-secondary"
  = link_to "Volver", departments_path, class: "btn btn-outline-primary"
  = link_to "Eliminar", @department, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-outline-danger"
