.card-academic
  = render "shared/cabecera", titulo: "Grados",
           alta: { ruta: new_grade_path, nombre: "Registrar grado" }

.card-academic
  - if @grades.empty?
    -# ⚠️ El botón NO es «Nuevo grado»: los grados los fija la ley y se siembran
    -# marcando niveles (MOR-153). Mandar a crearlos de a uno es mandar a llenar
    -# catorce formularios con información que no es del colegio.
    = render "shared/lista_vacia", clave: :niveles

  - else
    = render "shared/escala", total: @pagy.count, singular: "grado", plural: "grados"

    %table.table-academic
      %thead
        %tr
          %th= Grade.human_attribute_name(:name)
          -# ⚠️ La columna «Nivel» solo aparece con «Todos» elegido.
          -#
          -# Daniel la tachó en el mockup, y tiene razón: con un nivel puesto
          -# arriba, repetirlo en catorce filas es decir lo mismo catorce veces.
          -# Con «Todos» sí distingue, y por eso vuelve.
          - if mirando_todos_los_niveles?
            %th= Grade.human_attribute_name(:level)
          %th Coordinador
      %tbody
        - @grades.each do |grade|
          %tr
            %td= link_to grade.name, grade
            - if mirando_todos_los_niveles?
              %td= GradoOficial.etiqueta(grade.level)
            %td= grade.coordinator_teacher&.user&.nombre_completo || "—"
