.card-academic
  .card-academic-header
    %h1 Grados
    = link_to "Nuevo grado", new_grade_path, class: "btn btn-primary"

  %table.table-academic
    %thead
      %tr
        %th Nombre
        %th Nivel
        %th Profesor guía
    %tbody
      - @grades.each do |grade|
        %tr
          %td= link_to grade.name, grade
          %td= grade.level.humanize
          %td= grade.leader_teacher&.user&.nombre_completo || "—"
