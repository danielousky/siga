%h1 Grados

= link_to "Nuevo Grado", new_grade_path, class: "btn btn-primary mb-3"

%table.table.table-striped.table-hover
  %thead
    %tr
      %th Nombre
      %th Nivel
      %th Profesor Guía
      %th Acciones
  %tbody
    - @grades.each do |grade|
      %tr
        %td= grade.name
        %td= grade.level.humanize
        %td= grade.leader_teacher&.user&.name || "—"
        %td
          = link_to "Ver", grade, class: "btn btn-sm btn-outline-primary"
          = link_to "Editar", edit_grade_path(grade), class: "btn btn-sm btn-outline-secondary"
          = link_to "Eliminar", grade, data: { turbo_method: :delete, turbo_confirm: "¿Está seguro?" }, class: "btn btn-sm btn-outline-danger"

== pagy_bootstrap_nav(@pagy)
