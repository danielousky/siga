= form_with(model: grade, class: "mb-3") do |f|
  = render "shared/errors", object: grade

  -# El colegio NO se elige: sale de la sesión (Current.school). Un selector acá
  -# permitiría mandar el id de otro colegio en el formulario, que es justamente
  -# de donde el inquilino nunca puede venir.
  -#
  -# El selector de profesor guía de más abajo tampoco necesita filtro explícito:
  -# Teacher es SchoolScoped, así que ya solo trae los del colegio de la sesión.
  .mb-3
    = f.label :name, "Nombre", class: "form-label"
    = f.text_field :name, class: "form-control"

  .mb-3
    = f.label :level, "Nivel", class: "form-label"
    = f.select :level, Grade.levels.keys.map { |l| [l.humanize, l] }, { include_blank: "Seleccione..." }, class: "form-select"

  -# Cómo se escribe la calificación del año en este grado (MOR-129).
  -#
  -# Va acá y no en la ficha del colegio porque un mismo colegio tiene primaria
  -# por literal y bachillerato por número. Al elegir el nivel, el grado nuevo ya
  -# viene con la escala que le toca; esto es para cambiarla.
  .mb-3
    = f.label :escala, "Escala de calificación", class: "form-label"
    = f.select :escala, [["Numérica — del 1 al 20 (media general)", "numerica"], ["Literal — A, B, C, D, E (primaria)", "literal"]], {}, class: "form-select"
    %small.form-text.text-muted
      La nota siempre se carga del 1 al 20. La escala solo cambia cómo se
      %strong muestra
      la calificación del año: con literal se lee "A (19)". Las notas de lapso
      van en número en los dos casos.

  .mb-3
    = f.label :leader_teacher_id, "Profesor Guía", class: "form-label"
    = f.select :leader_teacher_id, Teacher.includes(:user).map { |t| [t.user.name + " " + t.user.last_name, t.user_id] }, { include_blank: "Ninguno" }, class: "form-select"

  = f.submit class: "btn btn-primary"
