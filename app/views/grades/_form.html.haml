= form_with(model: grade, class: "mb-3") do |f|
  = render "shared/errors", object: grade

  -# Provisional: hoy el colegio se elige a mano porque no existe contexto de
  -# inquilino. Cuando MOR-86 traiga Current.school, este selector desaparece y
  -# el colegio sale de la sesión — nunca de un parámetro del formulario.
  .mb-3
    = f.label :school_id, "Colegio", class: "form-label"
    = f.select :school_id, School.order(:name).map { |sc| [sc.name, sc.id] }, { include_blank: "Seleccione..." }, class: "form-select"

  .mb-3
    = f.label :name, "Nombre", class: "form-label"
    = f.text_field :name, class: "form-control"

  .mb-3
    = f.label :level, "Nivel", class: "form-label"
    = f.select :level, Grade.levels.keys.map { |l| [l.humanize, l] }, { include_blank: "Seleccione..." }, class: "form-select"

  .mb-3
    = f.label :leader_teacher_id, "Profesor Guía", class: "form-label"
    = f.select :leader_teacher_id, Teacher.includes(:user).map { |t| [t.user.name + " " + t.user.last_name, t.user_id] }, { include_blank: "Ninguno" }, class: "form-select"

  = f.submit class: "btn btn-primary"
