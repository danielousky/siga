-# Los turnos del año: a qué hora suena el timbre (spec `horarios`, tanda 1).
-#
-# Casi todos los colegios tienen uno. El segundo aparece cuando hay Primaria con
-# otro horario o un turno de tarde: por eso un turno lleva nombre.
.card-academic
  = render "shared/cabecera", titulo: "Horarios", detalle: @anio&.name,
           alta: { ruta: new_bell_schedule_path, nombre: "Registrar turno" }
  = render "shared/pestanas", pestanas: pestanas_de_horarios(activa: :turnos), etiqueta: "Partes del horario"

.card-academic
  - if @turnos.empty?
    = render "shared/lista_vacia", clave: :turnos, titulo: "Todavía no hay turnos",
             texto: "Un turno dice a qué hora suena el timbre: la entrada, cuánto dura cada hora y cuándo es el receso. Se registra con cuatro números.",
             acciones: [ { texto: "Agregar", ruta: new_bell_schedule_path, icono: :agregar } ]

  - else
    = render "shared/escala", total: @turnos.size, singular: "turno", plural: "turnos"

    %table.table-academic
      %thead
        %tr
          %th= BellSchedule.model_name.human
          %th Horas
          %th= Section.model_name.human(count: 2)
      %tbody
        - @turnos.each do |turno|
          - cuantas = @secciones_por_turno.fetch(turno.id, 0)
          %tr
            %td= link_to turno.name, turno
            %td= resumen_del_turno(turno)
            %td
              - if cuantas.zero?
                %span.dato-secundario ninguna todavía
              - else
                = contar(cuantas, "sección", "secciones")
