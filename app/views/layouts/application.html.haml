!!!
%html
  %head
    %title SIGA
    %meta{name: "viewport", content: "width=device-width,initial-scale=1"}
    = csrf_meta_tags
    = csp_meta_tag

    %link{rel: "stylesheet", href: "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", integrity: "sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH", crossorigin: "anonymous"}
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags

  %body
    %nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4
      .container-fluid
        %a.navbar-brand{href: root_path} SIGA
        %button.navbar-toggler{"data-bs-toggle": "collapse", "data-bs-target": "#navbarNav", type: "button", "aria-controls": "navbarNav", "aria-expanded": "false", "aria-label": "Toggle navigation"}
          %span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
          %ul.navbar-nav.me-auto
            %li.nav-item.dropdown
              %a.nav-link.dropdown-toggle#academicDropdown{href: "#", role: "button", "data-bs-toggle": "dropdown", "aria-expanded": "false"} Académico
              %ul.dropdown-menu{"aria-labelledby": "academicDropdown"}
                %li= link_to "Grados", grades_path, class: "dropdown-item"
                %li= link_to "Materias", subjects_path, class: "dropdown-item"
                %li= link_to "Departamentos", departments_path, class: "dropdown-item"
                %li= link_to "Momentos de Evaluación", evaluation_moments_path, class: "dropdown-item"
            %li.nav-item.dropdown
              %a.nav-link.dropdown-toggle#periodsDropdown{href: "#", role: "button", "data-bs-toggle": "dropdown", "aria-expanded": "false"} Períodos
              %ul.dropdown-menu{"aria-labelledby": "periodsDropdown"}
                %li= link_to "Períodos Académicos", academic_periods_path, class: "dropdown-item"
                %li= link_to "Secciones", sections_path, class: "dropdown-item"
                %li= link_to "Inscripciones", enrollments_path, class: "dropdown-item"
            %li.nav-item.dropdown
              %a.nav-link.dropdown-toggle#peopleDropdown{href: "#", role: "button", "data-bs-toggle": "dropdown", "aria-expanded": "false"} Personas
              %ul.dropdown-menu{"aria-labelledby": "peopleDropdown"}
                %li= link_to "Estudiantes", students_path, class: "dropdown-item"
                %li= link_to "Profesores", teachers_path, class: "dropdown-item"
                %li= link_to "Administradores", admins_path, class: "dropdown-item"
          - if user_signed_in?
            %span.navbar-text.me-3= current_user.name
            = link_to "Cerrar sesión", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-outline-light btn-sm"

    .container
      - if notice.present?
        .alert.alert-success.alert-dismissible.fade.show{role: "alert"}
          = notice
          %button.btn-close{"data-bs-dismiss": "alert", type: "button", "aria-label": "Close"}
      - if alert.present?
        .alert.alert-danger.alert-dismissible.fade.show{role: "alert"}
          = alert
          %button.btn-close{"data-bs-dismiss": "alert", type: "button", "aria-label": "Close"}
      = yield

    %script{src: "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js", integrity: "sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz", crossorigin: "anonymous"}
