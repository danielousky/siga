!!!
%html
  %head
    -# Primero de todo, y no por gusto: el estándar solo garantiza que se lea si
    -# aparece en los primeros 1024 bytes. Rails ya manda `charset=utf-8` en la
    -# cabecera HTTP y con eso alcanza en condiciones normales; esto cubre las
    -# que no lo son —una exportación estática, una página guardada, un proxy
    -# que reescribe cabeceras—, donde el español se rompe entero: "Gestión"
    -# pasa a "GestiÃ³n" en cada acento de cada pantalla.
    %meta{charset: "utf-8"}
    %title= titulo_de_pagina
    %meta{name: "viewport", content: "width=device-width,initial-scale=1"}
    %meta{name: "description", content: descripcion_de_pagina}
    = csrf_meta_tags
    = csp_meta_tag

    -# La tarjeta que ve quien recibe el enlace por WhatsApp — que es el canal de
    -# venta real. Ver `MetadatosHelper`: las URL van absolutas a propósito,
    -# porque quien pide la imagen es el servidor de WhatsApp, no el navegador.
    - if pagina_publica?
      %meta{property: "og:type", content: "website"}
      %meta{property: "og:site_name", content: "SIGA"}
      %meta{property: "og:locale", content: "es_VE"}
      %meta{property: "og:title", content: titulo_de_pagina}
      %meta{property: "og:description", content: descripcion_de_pagina}
      %meta{property: "og:url", content: request.original_url}
      %meta{property: "og:image", content: asset_url("siga-og.jpg")}
      %meta{property: "og:image:width", content: "1200"}
      %meta{property: "og:image:height", content: "630"}
      %meta{property: "og:image:alt", content: "SIGA · Notas, boletines y constancias desde el teléfono"}
      %meta{name: "twitter:card", content: "summary_large_image"}
      %meta{name: "theme-color", content: "#07142f"}
    -# El favicon en SVG: 26 KB contra los 43 KB del PNG que había antes, y sin
    -# perder nitidez en pantalla retina. Los navegadores que no lo soportan
    -# simplemente no muestran ícono, que es un precio ínfimo.
    = favicon_link_tag "logo.svg", type: "image/svg+xml"

    -# Acá vivía Font Awesome, traído de un CDN en CADA carga de CADA página.
    -# Se usaba para UN ícono: el ojito del formulario de login. Ahora ese ojo es
    -# un SVG en línea y no queda ninguna petición a un tercero (MOR-134).
    -#
    -# No es purismo: en un colegio con conexión mala, un CDN lento es la página
    -# entera esperando, y un CDN caído son los íconos que no aparecen.
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags

  %body
    -# ⚠️ La barra del producto y la del colegio son UNA sola desde MOR-184, y
    -# está FIJA. Antes eran dos franjas apiladas que se comían 120 px en cada
    -# pantalla y desaparecían al bajar por una lista larga: con ellas se iban el
    -# selector de año escolar y el buscador, que es justo lo que hace falta a
    -# mitad de una lista de doscientos alumnos.
    -#
    -# Sin sesión no hay colegio ni año que mostrar, así que la barra reducida
    -# —solo el logo— va aparte: la portada y el login la usan.
    - if user_signed_in? && current_user_type.present?
      = render "shared/barra_superior"
    - else
      %header.barra-superior
        .barra-superior-inner
          = link_to root_path, class: "navbar-brand" do
            = image_tag "logo.svg", alt: "", class: "navbar-brand-logo"
            %span.navbar-brand-text SIGA
          - if user_signed_in?
            .barra-superior-espacio
            .session-menu
              = link_to "Cerrar sesión", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-outline-light btn-sm"

    -# ⚠️ Quien acaba de registrarse TODAVÍA no tiene rol, y eso es correcto: su
    -# rol nace cuando crea su colegio. Sin esta excepción el layout le tapa el
    -# formulario con «contacte al administrador» — y el administrador es él.
    -#
    -# Se pregunta por el CONTROLADOR y no por una bandera: la pantalla que crea
    -# el colegio es la única que tiene sentido sin rol, y cualquier otra sí debe
    -# mostrar el aviso.
    - if user_signed_in? && current_user_type.nil? && controller_name == "mi_colegio"
      .container-academic
        = yield

    - elsif user_signed_in? && current_user_type.nil?
      / Usuario autenticado sin rol asignado
      .container-academic
        .no-role-container
          .no-role-card
            .no-role-icon ⚠️
            %h2 Sin rol asignado
            %p Usted no tiene un rol asignado en el sistema. Contacte al administrador para que le asigne uno.
            = link_to "Cerrar sesión", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-secondary"

    - elsif user_signed_in?
      = render 'shared/avisos_de_la_pagina'

      .app-layout{"data-controller": "sidebar"}
        -# El controlador `menu` va acá, en la barra entera, y no en cada grupo:
        -# los grupos tienen que coordinarse entre sí —en el navbar del teléfono
        -# abrir uno cierra los otros—, y eso desde un grupo suelto obliga a
        -# alcanzar a sus hermanos por el padre.
        %aside.sidebar-index{"data-controller": "menu"}
          -# ⚠️ El botón va ARRIBA, y antes estaba al pie.
          -#
          -# Lo puse abajo razonando que «encoger se hace una vez y no merece el
          -# mejor sitio». El razonamiento era mío y estaba mal: un control que
          -# no se encuentra tampoco se usa esa única vez. Daniel tuvo que
          -# buscarlo hasta el final del menú para descubrir que además no
          -# funcionaba.
          -#
          -# Acá arriba no compite con el primer enlace: está en su propia franja,
          -# alineado a la derecha, que es donde lo pone todo producto que tiene
          -# esta función.
          .sidebar-cabecera
            %span.sidebar-cabecera-titulo Menú
            %button.sidebar-encoger{type: "button", "data-action": "sidebar#alternar",
                                    "data-sidebar-target": "boton",
                                    "aria-expanded": "true", "aria-label": "Encoger el menú"}
              = icono(:volver, tamano: 16)

          - if administrador?
            = render 'shared/sidebar_administrador'
          - elsif profesor?
            = render 'shared/sidebar_profesor'
          - elsif estudiante?
            = render 'shared/sidebar_estudiante'
          - elsif representante?
            = render 'shared/sidebar_representante'

        %main.container-academic
          -# ⚠️ Va DENTRO del `main` y en el flujo, no `position: fixed`.
          -# En una laptop de 13" ya hay barra de contexto y a veces avisos de
          -# suscripción: una cuarta banda fija son doscientos píxeles de cromo
          -# antes del primer dato.
          - if recorrido_activo?
            = render "shared/franja_de_recorrido"

          - if notice.present?
            .alert.alert-success
              = notice
          - if alert.present?
            .alert.alert-danger
              = alert
          = yield
    - else
      .container-academic
        - if notice.present?
          .alert.alert-success
            = notice
        - if alert.present?
          .alert.alert-danger
            = alert
        = yield
