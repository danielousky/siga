!!!
%html
  %head
    %title SIGA - Sistema Integrado de Gestión Académica
    %meta{name: "viewport", content: "width=device-width,initial-scale=1"}
    = csrf_meta_tags
    = csp_meta_tag

    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags

  %body
    %nav.nav-institutional
      .container-fluid
        %a.navbar-brand{href: root_path} SIGA
        - if user_signed_in?
          .d-flex.align-items-center
            %span.user-info= current_user.name
            = link_to "Cerrar sesión", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-outline-light btn-sm"

    - if user_signed_in?
      .academic-context
        .academic-context-inner
          .period-indicator Período Académico Activo
          %span Sistema Integrado de Gestión Académica

      .app-layout
        %aside.sidebar-index
          .sidebar-section
            .sidebar-section-title Académico
            %ul.sidebar-nav
              %li.sidebar-nav-item
                = link_to "Grados", grades_path, class: "sidebar-nav-link #{'active' if controller_name == 'grades'}"
              %li.sidebar-nav-item
                = link_to "Materias", subjects_path, class: "sidebar-nav-link #{'active' if controller_name == 'subjects'}"
              %li.sidebar-nav-item
                = link_to "Departamentos", departments_path, class: "sidebar-nav-link #{'active' if controller_name == 'departments'}"
              %li.sidebar-nav-item
                = link_to "Momentos de Evaluación", evaluation_moments_path, class: "sidebar-nav-link #{'active' if controller_name == 'evaluation_moments'}"

          .sidebar-section
            .sidebar-section-title Períodos
            %ul.sidebar-nav
              %li.sidebar-nav-item
                = link_to "Períodos Académicos", academic_periods_path, class: "sidebar-nav-link #{'active' if controller_name == 'academic_periods'}"
              %li.sidebar-nav-item
                = link_to "Secciones", sections_path, class: "sidebar-nav-link #{'active' if controller_name == 'sections'}"
              %li.sidebar-nav-item
                = link_to "Inscripciones", enrollments_path, class: "sidebar-nav-link #{'active' if controller_name == 'enrollments'}"

          .sidebar-section
            .sidebar-section-title Personas
            %ul.sidebar-nav
              %li.sidebar-nav-item
                = link_to "Estudiantes", students_path, class: "sidebar-nav-link #{'active' if controller_name == 'students'}"
              %li.sidebar-nav-item
                = link_to "Profesores", teachers_path, class: "sidebar-nav-link #{'active' if controller_name == 'teachers'}"
              %li.sidebar-nav-item
                = link_to "Administradores", admins_path, class: "sidebar-nav-link #{'active' if controller_name == 'admins'}"

        %main.container-academic
          - if notice.present?
            .alert.alert-success
              = notice
          - if alert.present?
            .alert.alert-danger
              = alert
          = yield
    - else
      .container-academic
        - if notice.present?
          .alert.alert-success
            = notice
        - if alert.present?
          .alert.alert-danger
            = alert
        = yield
