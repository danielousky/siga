!!!
%html
  %head
    %title SIGA - Sistema Integrado de Gestión Académica
    %meta{name: "viewport", content: "width=device-width,initial-scale=1"}
    = csrf_meta_tags
    = csp_meta_tag
    = favicon_link_tag 'logo.png'

    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags

  %body
    %nav.nav-institutional
      .container-fluid
        = link_to root_path, class: 'navbar-brand' do
          = image_tag 'logo.png', alt: 'SIGA', class: 'navbar-brand-logo'
          %span.navbar-brand-text SIGA
        - if user_signed_in?
          .d-flex.align-items-center
            %span.user-info= current_user.name
            = link_to "Cerrar sesión", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-outline-light btn-sm"

    - if user_signed_in?
      .academic-context
        .academic-context-inner
          .period-indicator Período Académico Activo
          %span Sistema Integrado de Gestión Académica

      .app-layout
        %aside.sidebar-index
          - if administrador?
            = render 'shared/sidebar_administrador'
          - elsif profesor?
            .sidebar-section
              .sidebar-section-title Dashboard
              %ul.sidebar-nav
                %li.sidebar-nav-item
                  = link_to "Mi Dashboard", root_path, class: "sidebar-nav-link active"
              %p{style: "padding: var(--space-lg); color: var(--text-tertiary); font-size: 13px;"} Dashboard de profesor en desarrollo...
          - elsif estudiante?
            .sidebar-section
              .sidebar-section-title Dashboard
              %ul.sidebar-nav
                %li.sidebar-nav-item
                  = link_to "Mi Dashboard", root_path, class: "sidebar-nav-link active"
              %p{style: "padding: var(--space-lg); color: var(--text-tertiary); font-size: 13px;"} Dashboard de estudiante en desarrollo...

        %main.container-academic
          - if notice.present?
            .alert.alert-success
              = notice
          - if alert.present?
            .alert.alert-danger
              = alert
          = yield
    - else
      .container-academic
        - if notice.present?
          .alert.alert-success
            = notice
        - if alert.present?
          .alert.alert-danger
            = alert
        = yield
