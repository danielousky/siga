.card-academic
  = render "shared/cabecera", titulo: "Verificar un boletín"

  %p.nota-ayuda
    Escriba el código impreso en el boletín para ver exactamente lo que el
    sistema emitió, y compararlo con el papel.

  = form_with url: verificar_path, method: :get, data: { turbo: false } do
    .form-group
      = label_tag :code, "Código de verificación", class: "form-label"
      = text_field_tag :code, nil, class: "form-control", placeholder: "BOL-XXXX-XXXX",
        autocomplete: "off", autocapitalize: "characters", spellcheck: false
      %small.nota-ayuda
        Está al pie del boletín. No lleva ceros ni la letra O: si te parece ver un
        cero, es la letra O… y al revés.

    = submit_tag "Verificar", class: "btn btn-guardar"
