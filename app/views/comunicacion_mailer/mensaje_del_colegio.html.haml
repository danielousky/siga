-# El correo que el colegio le escribe a una familia (MOR-181).
-#
-# La cabecera ya dice de qué colegio viene; acá va lo que la persona escribió.
- content_for :adelanto, truncate(@cuerpo.to_s.squish, length: 110)

= titulo_de_correo @asunto

%p= "#{@destinatario.first_name.to_s.titleize},"

-# `simple_format` respeta los saltos de línea que la persona escribió y
-# escapa el HTML: el texto viene de un formulario.
= simple_format(@cuerpo, {}, sanitize: true)

= nota_de_correo do
  = "Le escribe #{@remitente.nombre_completo}, de #{@colegio.name}."
  - if @remitente.email.present?
    %br
    Puede responder a este correo.
