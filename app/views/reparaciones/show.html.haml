-# La planilla de reparación. Reusa `planilla` entero —guardado incremental,
-# barra de progreso, cola de reintentos, teclado— porque es la MISMA tarea:
-# un profesor cargando notas de a una, probablemente desde el teléfono.
-#
-# Lo único que agrega es la columna de la definitiva, que se actualiza en vivo.
.card-academic{ data: { controller: "planilla" } }
  = render layout: "shared/cabecera", locals: { titulo: "Reparación" } do
    = boton "Volver", reparaciones_path, icono: :volver, tono: :secondary

  %p.carga-contexto
    = "#{@seccion.grade.name} – #{@seccion.name}"
    = "· #{@materia.name}"
    = "· #{@seccion.academic_period.name}"

  = render "shared/progreso_de_la_planilla", hechas: @cargadas,
           total: @aplazados.size, nombre: "cargadas"

  = render "shared/aviso_de_la_planilla"

  - if @aplazados.any?
    -# `%ol`: es la lista de la clase, en orden, y el lector dice «elemento 3 de 8».
    %ol.carga-lista
      - @aplazados.each_with_index do |libro, i|
        - alumno = libro.enrollment.student
        %li.carga-fila{ data: { planilla_target: "fila" } }
          = numero_de_fila(i)
          = avatar(alumno.user, tamano: :chico)
          .carga-alumno
            .carga-alumno-nombre= alumno.user.apellidos_y_nombres
            .carga-alumno-carnet
              = alumno.school_card
              -# El anual va en rojo porque es un dato de un alumno aplazado, que
              -# es exactamente lo que la regla de color reserva para el rojo.
              %span.carga-promedio.bajo= "· anual #{libro.annual_average&.to_i || '—'}"
          = form_with url: nota_de_reparacion_path(@seccion, @materia, alumno.id),
                      method: :patch, class: "carga-campo",
                      data: { action: "turbo:submit-start->planilla#enviando turbo:submit-end->planilla#llego turbo:fetch-request-error->planilla#sinRed" } do
            -# `id` propio: ver la nota de la planilla de notas.
            = number_field_tag :score, libro.remedial_exam_score&.to_i, min: 1, max: 20, step: 1,
                               id: "reparacion_#{alumno.id}",
                               inputmode: "numeric", placeholder: "—", class: "carga-input",
                               autocomplete: "off",
                               "aria-label": "Reparación de #{alumno.user.nombre_completo}",
                               data: { planilla_target: "campo",
                                       action: "change->planilla#guardar input->planilla#escribir keydown->planilla#navegar" }
          -# ⚠️ FUERA del formulario, las dos. Adentro, reemplazarlas por stream
          -# hace que el navegador devuelva el foco al campo que acaba de
          -# enviar, y Enter deja de pasar al alumno siguiente (medido en el
          -# navegador: el foco volvía doce milisegundos después del stream).
          = render "reparaciones/definitiva", alumno: alumno.id, libro: libro
          = render "shared/estado_de_la_fila", id: "estado_#{alumno.id}",
                   estado: (libro.remedial_exam_score.present? ? :guardado : :vacio)

    %p.carga-ayuda
      La definitiva es la mayor entre el anual y la reparación
      = succeed "." do
        %strong Art. 112
      Deje el campo
      %strong vacío
      para quitar la reparación: vuelve a valer el anual.
      %br
      Con
      %kbd Enter
      pasa al alumno siguiente.

  - else
    .empty-state
      %h3 Nadie quedó aplazado
      %p= "En #{@materia.name} todos los alumnos de #{@seccion.grade.name} #{@seccion.name} cerraron el año en 10 o más."
