-# UNA evaluación, dentro del plan (etapa ③).
-#
-# La misma fila sirve colgada de su competencia y en el bloque de las sueltas,
-# porque es el mismo objeto contestando la misma pregunta: qué se evalúa,
-# cuánto pesa y cuándo.
-#
-# ⚠️ El nombre es un ENLACE a su planilla de notas, no al `show`. Desde el plan
-# lo que sigue es CARGAR: el detalle de la evaluación no le dice nada al
-# profesor que ya la escribió él mismo. Y `_top` porque sale del frame «plan».
%li.plan-evaluacion
  = link_to evaluation_activity_notas_path(evaluacion, desde: contexto[:desde]),
            class: "plan-evaluacion-nombre", data: { turbo_frame: "_top" } do
    %span.plan-evaluacion-descripcion= evaluacion.description
    -# El peso se lee acá y se EDITA acá: es donde está la pregunta («¿cuánto
    -# vale este taller?») y donde se ve la respuesta de las otras tres.
    -# Fuera del enlace, o teclear dentro navegaría.
  - if profesor?
    -# ⚠️ `form:` ata el campo al formulario de la barra, que está ARRIBA y
    -# fuera de esta lista. Es HTML estándar y es la única salida: un `<form>`
    -# que envolviera el plan anidaría los `button_to` de borrar.
    .plan-evaluacion-peso
      = number_field_tag "pesos[#{evaluacion.id}]", evaluacion.weight_percentage,
                         form: "reparto-del-lapso", step: 0.01, min: 0.01, max: 100,
                         class: "plan-evaluacion-peso-campo",
                         "aria-label": "Peso de #{evaluacion.description}, en porcentaje",
                         data: { reparto_target: "peso", id: evaluacion.id,
                                 action: "input->reparto#recalcular blur->reparto#ajustar" }
      %span.plan-evaluacion-peso-signo %
  - else
    %span.plan-evaluacion-peso-fijo= porcentaje(evaluacion.weight_percentage)
  %span.plan-evaluacion-fecha
    - if evaluacion.date_scheduled
      = l(evaluacion.date_scheduled, format: :short)
    - else
      %span.dato-vacio sin fecha
  - if profesor?
    .plan-evaluacion-acciones
      = link_to edit_evaluation_activity_path(evaluacion, contexto),
                class: "btn btn-secondary btn-sm btn-solo-icono",
                data: { tooltip: "Editar la evaluación" }, "aria-label": "Editar la evaluación" do
        = icono(:editar, tamano: 14)
      -# ⚠️ El aviso decía «se borran también las notas cargadas», y es al revés:
      -# con notas, el modelo RECHAZA el borrado. Prometer lo que no va a pasar
      -# es peor que no ofrecerlo — quien lo lee acepta creyendo otra cosa, y lo
      -# que recibe es un error.
      - notas = notas_cargadas_en(evaluacion)
      - aviso = notas.zero? ? "¿Borrar «#{evaluacion.description}»? Deja de contar en el promedio del lapso." : "«#{evaluacion.description}» tiene #{contar(notas, 'nota cargada', 'notas cargadas')} y no se puede borrar hasta que se vacíen desde su planilla."
      = button_to evaluation_activity_path(evaluacion, contexto),
                  method: :delete, class: "btn btn-danger btn-sm btn-solo-icono",
                  form: { data: { turbo_confirm: aviso } },
                  data: { tooltip: (notas.zero? ? "Borrar" : "Tiene notas cargadas") },
                  "aria-label": "Borrar" do
        = icono(:borrar, tamano: 14)
